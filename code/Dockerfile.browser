# 与 package.json / pnpm-lock.yaml 中的 Playwright 版本保持一致。
FROM mcr.microsoft.com/playwright:v1.64.1-noble

ARG APT_MIRROR=https://mirrors.aliyun.com/ubuntu
# PDF打印需要稳定的中文字体；浏览器不加载网络字体。
RUN sed -i \
      -e "s#http://azure.archive.ubuntu.com/ubuntu#${APT_MIRROR}#g" \
      -e "s#http://archive.ubuntu.com/ubuntu#${APT_MIRROR}#g" \
      -e "s#http://security.ubuntu.com/ubuntu#${APT_MIRROR}#g" \
      /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
WORKDIR /app
RUN corepack enable
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/server/package.json packages/server/
COPY packages/core/package.json packages/core/
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
COPY apps/desktop/package.json apps/desktop/
RUN pnpm install --frozen-lockfile --filter workpivot --filter @workpivot/server... --ignore-scripts
COPY packages/server/src/web packages/server/src/web
COPY scripts/browser-worker.mts scripts/browser-worker.mts
ENV WORKPIVOT_BROWSER_HOST=0.0.0.0 WORKPIVOT_BROWSER_PORT=39991
USER pwuser
EXPOSE 39991
CMD ["node", "--import", "tsx", "scripts/browser-worker.mts"]
