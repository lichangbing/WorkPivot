# 专用控制器是唯一持有 Docker socket 的服务；API 与任务沙箱均不挂载。
ARG DOCKER_CLI_IMAGE=docker:28.5.1-cli
FROM ${DOCKER_CLI_IMAGE} AS dockercli
FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY scripts/skill-worker.mjs /app/skill-worker.mjs
ENV WORKPIVOT_WORKER_BIND=0.0.0.0 WORKPIVOT_WORKER_PORT=39990
# 通过宿主 socket 的组授予访问权，不以 root 身份运行控制器。
USER node
CMD ["node", "/app/skill-worker.mjs"]
