import { parserFingerprint } from '../packages/server/src/database/document-parser.js';
/** 真实 pgvector 与本地合成 HTTP 服务覆盖重建、权限及异步撤销。 */
import assert from 'node:assert/strict';import {randomBytes,randomUUID} from 'node:crypto';import {createServer} from 'node:http';import {mkdtemp,rm} from 'node:fs/promises';import {tmpdir} from 'node:os';import {join} from 'node:path';
import {pool,installSchema,transaction} from '../packages/server/src/database/connection.js';import {AccountRepository} from '../packages/server/src/database/accounts.js';import {WorkspaceRepository} from '../packages/server/src/database/workspace.js';import {FileRepository} from '../packages/server/src/database/files.js';import {KnowledgeRepository} from '../packages/server/src/database/knowledge.js';import {Embeddings} from '../packages/server/src/database/embeddings.js';import {embed} from '../packages/server/src/database/embedding-client.js';
const url=process.env.WORKPIVOT_TEST_PG_URL!;if(!url||process.env.WORKPIVOT_TEST_PG_DISPOSABLE!=='1')throw Error('仅允许隔离数据库');
const password=randomBytes(20).toString('hex'),admin=pool(url),role=(n:string)=>{const u=new URL(url);u.username=n;u.password=password;return u.toString();},db=pool(role('emb_app')),auth=pool(role('emb_auth')),root=await mkdtemp(join(tmpdir(),'wp-embedding-'));
let malformed=false,fail=false,gate:Promise<void>|null=null,entered:()=>void=()=>{};const server=createServer(async(req,res)=>{let raw='';for await(const b of req)raw+=b;const body=JSON.parse(raw);entered();if(gate)await gate;if(fail){res.writeHead(503).end('SECRET echo');return;}const vectors=body.input.map((s:string)=>malformed?[1]:s.includes('财务')?[1,0,0]:[0,1,0]);res.setHeader('content-type','application/json');res.end(JSON.stringify(req.url==='/embeddings'?{data:vectors.map((embedding:number[],index:number)=>({embedding,index})).reverse()}:{embeddings:vectors}));});server.listen(0,'127.0.0.1');await new Promise<void>(r=>server.once('listening',r));
const baseUrl=`http://127.0.0.1:${(server.address() as {port:number}).port}`,input={name:'合成向量',baseUrl,modelId:'fixture',modelVersion:'test-1',dimensions:3,protocol:'ollama' as const};let checks=0;const check=(v:unknown,n:string)=>{assert.ok(v,n);checks++;console.log('通过：'+n);};const reject=async(fn:()=>Promise<unknown>,n:string)=>{await assert.rejects(fn);check(true,n);};
try{
 await admin.query(`CREATE ROLE emb_app LOGIN PASSWORD '${password}' NOSUPERUSER NOBYPASSRLS;CREATE ROLE emb_auth LOGIN PASSWORD '${password}' NOSUPERUSER NOBYPASSRLS`);await installSchema(admin,'emb_app','emb_auth');await installSchema(admin,'emb_app','emb_auth');check(true,'迁移可重复执行');
 const accounts=new AccountRepository(auth),owner=await accounts.registerFirst('owner','synthetic-password',password,password),actor=owner.user.id,other=(await accounts.createUser(owner.token,'other','synthetic-password','member')).id;const ws=new WorkspaceRepository(db),files=new FileRepository(db,root),knowledge=new KnowledgeRepository(db),service=new Embeddings(db,randomBytes(32).toString('hex'));
 const p=await ws.createProject(actor,'财务项目'),task=await ws.createTask(actor,'合成任务',p.id),outside=await ws.createTask(actor,'其他任务');const add=async(t:string,name:string,text:string)=>{const f=await files.upload(actor,t,name,Buffer.from(text),randomUUID());await transaction(db,c=>c.query("INSERT INTO workpivot.document_processing(version_id,owner_user_id,status,parts,parser_fingerprint) VALUES($1,$2,'completed',$3,$4)",[f.id,actor,JSON.stringify([{location:'第1页',text}]),parserFingerprint]),actor);await knowledge.indexNext(actor);return f;};const file=await add(task.id,'财务.txt','财务报销政策'),external=await add(outside.id,'其他.txt','财务不属于这个项目');
 const id=(await service.create(actor,input)).id;const row=async(target=id)=>(await service.list(actor)).find(s=>s.id===target)!;const act=async(a:string,target=id)=>service.action(actor,target,(await row(target)).revision,a);
 await reject(()=>act('start'),'未测试不能启用');await service.test(actor,id,(await row()).revision);check((await row()).tested,'连接和维度验证成功');check(!(await service.list(other)).length,'用户配置隔离');await reject(()=>service.test(other,id,1),'其他用户无法使用本地配置');await act('start');await service.process(actor);await service.process(actor);check((await row()).state==='active'&&(await row()).completed===2,'全部分片完成后切换当前空间');const results=await service.search(actor,task.id,'财务');check(results.matches.length===1&&results.matches[0].name==='财务.txt','语义检索先按项目过滤');await reject(()=>service.search(other,task.id,'财务'),'跨用户任务查询拒绝');
 await transaction(db,c=>c.query('UPDATE workpivot.document_processing SET parser_fingerprint=NULL WHERE version_id=$1',[file.id]),actor);
 check(!(await service.search(actor,task.id,'财务')).matches.length,'旧解析指纹在向量查询中立即失效');
 await transaction(db,c=>c.query('UPDATE workpivot.document_processing SET parser_fingerprint=$2 WHERE version_id=$1',[file.id,parserFingerprint]),actor);
 check((await service.search(actor,task.id,'财务')).matches.length===1,'有效解析身份仍可使用当前向量');
 check((await service.search(actor,task.id,'财务',{versionIds:[]})).matches.length===0,'空读取范围在向量排序前排除所有资料');
 check((await service.search(actor,task.id,'财务',{versionIds:[external.id]})).matches.length===0,'授权版本不能绕过项目范围');
 check((await service.search(actor,task.id,'财务',{versionIds:[file.id]})).matches.length===1,'授权版本允许正常向量召回');
 const second=(await service.create(actor,{...input,modelVersion:'test-2'})).id;await service.test(actor,second,(await row(second)).revision);await act('start',second);check((await row()).state==='active','重建开始保留旧空间');await service.process(actor);await service.process(actor);check((await row(second)).state==='active'&&(await row()).state==='retired','重建完成原子切换');
 await files.remove(actor,task.id,file.documentId,1);check(!(await service.search(actor,task.id,'财务')).matches.length,'删除后零召回');check((await admin.query('SELECT count(*)::int AS n FROM workpivot.embedding_jobs j JOIN workpivot.knowledge_chunks k ON k.id=j.chunk_id WHERE k.version_id=$1',[file.id])).rows[0].n===0,'删除级联清除向量和作业');
 const f2=await add(task.id,'异步.txt','合成资料');let release!:()=>void;gate=new Promise<void>(r=>release=r);const started=new Promise<void>(r=>entered=r);const processing=service.process(actor);await started;await act('pause',second);release();await processing;gate=null;entered=()=>{};check((await row(second)).completed===1,'暂停后的晚到结果不发布');await reject(()=>service.search(actor,task.id,'合成'),'暂停后停止向量查询');await act('start',second);await service.process(actor);check((await row(second)).completed===2,'恢复后作业继续');
 await add(task.id,'失败.txt','失败资料');fail=true;for(let i=0;i<3;i++){await service.process(actor);await transaction(db,c=>c.query("UPDATE workpivot.embedding_jobs SET next_attempt_at=now()"),actor);}check((await row(second)).failed===1,'三次失败停止自动重试');check(!(await row(second)).error.includes('SECRET'),'错误不泄漏服务响应');fail=false;await act('retry',second);await service.process(actor);check((await row(second)).failed===0,'手动重试成功');
 malformed=true;await reject(()=>embed(input,['合成']),'错误向量维度拒绝');malformed=false;check((await embed({...input,protocol:'openai'},['财务','其他']))[0]![0]===1,'OpenAI响应按索引恢复输入顺序');
 await reject(()=>service.create(actor,{...input,baseUrl:'http://user:secret@localhost'}),'地址禁止内嵌凭据');await reject(()=>service.action(actor,second,1,'pause'),'旧修订无法修改状态');await reject(()=>act('delete',second),'当前空间不能误删');

 const cancelled=(await service.create(actor,{...input,modelVersion:'cancel-test'})).id;await service.test(actor,cancelled,(await row(cancelled)).revision);await act('start',cancelled);await act('cancel',cancelled);check((await row(cancelled)).state==='retired'&&(await row(second)).state==='active','取消失败重建保留当前空间');await act('delete',cancelled);check(!(await service.list(actor)).some(s=>s.id===cancelled),'旧空间可删除且不删除资料');
 await add(task.id,'租约.txt','租约合成资料');await transaction(db,c=>c.query("UPDATE workpivot.embedding_jobs SET status='running',embedding=NULL,attempts=1,fence=gen_random_uuid(),lease_until=now()-interval '1 second' WHERE space_id=$1",[second]),actor);await service.process(actor);check((await row(second)).completed>=1,'过期租约恢复并继续执行');
 await files.remove(actor,task.id,f2.documentId,1);await files.remove(actor,outside.id,external.documentId,1);check(true,'清理合成资料不影响空间约束');console.log('向量专项：'+checks+'项通过');
}finally{await new Promise<void>(r=>server.close(()=>r()));await db.end();await auth.end();await admin.end();await rm(root,{recursive:true,force:true});}
