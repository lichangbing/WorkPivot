import assert from 'node:assert/strict';
import type { Pool } from 'pg';
import { DatabaseSkills } from '../packages/server/src/database/skills.js';
import { transaction } from '../packages/server/src/database/connection.js';

export async function testSkills(db: Pool, owner: string, member: string, check: (value: unknown, label: string) => void) {
  const skills = new DatabaseSkills(db), name = 'database-skill';
  let d = await skills.create(owner, name);
  check(d.files.some(f => f.path === 'SKILL.md') && !d.published, 'skill draft persists in PostgreSQL');
  check(!(await skills.market(member)).some(s => s.name === name), 'unpublished draft absent from member market');
  await assert.rejects(() => skills.open(member, name)); check(true, 'member cannot read administrator draft');
  await assert.rejects(() => skills.save(owner, name, '../escape', Buffer.from('bad'), d.revision)); check(true, 'skill paths reject traversal');
  d = await skills.directory(owner, name, 'scripts', d.revision, false);
  d = await skills.save(owner, name, 'scripts/check.py', Buffer.from('print("hello")'), d.revision);
  check(d.directories.includes('scripts'), 'skill directory and resource retained');
  const stale = d.revision; d = await skills.save(owner, name, 'notes.md', Buffer.from('first'), d.revision);
  await assert.rejects(() => skills.save(owner, name, 'notes.md', Buffer.from('stale'), stale)); check(true, 'stale skill edit rejected');
  d = await skills.publish(owner, name, d.revision); const first = d.published!;
  check((await skills.market(member)).some(s => s.name === name && !s.loaded), 'published skill visible in user market');
  await skills.select(member, name, true);
  const tool = skills.tools(member)[0]!;
  check(String(await tool.run({ name, file: 'scripts/check.py' }, { taskDir: '.' })).includes('hello'), 'task skill tool reads published resource');
  await assert.rejects(() => tool.run({ name, file: '../escape' }, { taskDir: '.' })); check(true, 'skill tool blocks package traversal');
  check((await skills.market(member)).some(s => s.name === name && s.loaded), 'user skill selection persists');
  check(!(await skills.market(owner)).find(s => s.name === name)?.loaded, 'skill selections isolated by user');
  const publicFile = await transaction(db, async c => (await c.query('SELECT files FROM workpivot.skill_drafts WHERE name=$1', [name])).rows, member);
  check(publicFile.length === 0, 'RLS hides draft resources from other users');
  d = await skills.save(owner, name, 'notes.md', Buffer.from('unpublished second'), d.revision);
  check((await skills.file(owner, name, 'notes.md', first)).toString() === 'first', 'draft edit does not mutate published release');
  const archive = await skills.export(owner, name, first);
  d = await skills.import(owner, name, archive, d.revision);
  check((await skills.file(owner, name, 'scripts/check.py')).toString().includes('hello'), 'ZIP roundtrip retains package resources');
  const pinned = skills.tools(member, new Map([[name, first]]))[0]!;
  d = await skills.save(owner, name, 'notes.md', Buffer.from('second'), d.revision);
  d = await skills.publish(owner, name, d.revision);
  check(d.versions.length === 2 && d.published !== first, 'publication creates immutable release');
  check(JSON.parse(String(await pinned.run({ name, file: 'notes.md' }, { taskDir: '.' }))).content === 'first', 'running round pins original published resources');
  d = await skills.rollback(owner, name, first, d.revision);
  check((await skills.market(member)).find(s => s.name === name)?.version === first && d.dirty, 'rollback changes active release and preserves draft');
  await skills.toggle(owner, name, true);
  await assert.rejects(() => tool.run({ name }, { taskDir: '.' })); check(true, 'existing task tool respects live skill disable');
  check(!(await skills.market(member)).some(s => s.name === name), 'disabled skill disappears from user market');
  await assert.rejects(() => skills.select(member, name, true)); check(true, 'disabled skill cannot be newly loaded');
  await skills.select(member, name, false);
  await skills.toggle(owner, name, false);
  check(!(await skills.market(member)).find(s => s.name === name)?.loaded, 'unload persists across re-enable');
  d = await skills.open(owner, name); d = await skills.directory(owner, name, 'scripts', d.revision, true);
  check(!d.files.some(f => f.path.startsWith('scripts/')), 'directory deletion removes descendants only from draft');
  await assert.rejects(() => skills.save(owner, name, 'SKILL.md', null, d.revision)); check(true, 'root instruction cannot be deleted');
}
