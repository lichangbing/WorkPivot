      const response = await fetch(`http://127.0.0.1:${port}/api/tasks/${task.id}/file-versions/${artifact.id}`, { headers: { Authorization: 'Bearer ' + login.token } });
      check(response.ok && await response.text() === '验收成果正文', '恢复后认证 HTTP 下载成果正文');
    } finally { await new Promise<void>((resolve, reject) => http.close(error => error ? reject(error) : resolve())); }
  } finally { await restoredApp.end(); await restoredAuth.end(); }

