  await admin.query('REVOKE SELECT ON workpivot.projects FROM wp_restore_missing; DROP ROLE wp_restore_missing');
  await admin.query('CREATE DATABASE late_restore_test');
  const lateFiles = join(root, 'late_restore_test');
  await assert.rejects(restoreBackup({ backup: lateFailure, databaseUrl: targetUrl('late_restore_test'), filesRoot: lateFiles }), /pg_restore 失败/);
  const lateDb = pool(targetUrl('late_restore_test'));
  try { check((await lateDb.query("SELECT 1 FROM pg_namespace WHERE nspname IN ('identity','workpivot','workpivot_meta')")).rowCount === 0, '真实转储后段授权失败时全部 schema 回滚'); } finally { await lateDb.end(); }
  await assert.rejects(lstat(lateFiles));
  await admin.query('CREATE ROLE wp_restore_missing');
  await restoreBackup({ backup: lateFailure, databaseUrl: targetUrl('late_restore_test'), filesRoot: lateFiles });
  check(true, '修复外部角色后可对同一隔离目标重新恢复');
  check((await admin.query('SELECT count(*)::int AS n FROM workpivot.documents')).rows[0].n === 2, '原数据库资料完整保留');
  console.log(`真实 PostgreSQL 联合备份恢复：${checks} 项通过`);
} finally { await Promise.allSettled([app.end(), auth.end(), admin.end()]); }
