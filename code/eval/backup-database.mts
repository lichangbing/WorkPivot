    check((await restoredWorkspace.messages(owner.user.id, task.id))[0]?.content === '恢复验收消息', '历史消息保留');
    check((await restoredWorkspace.readMemory(owner.user.id, memory.id))?.content === '恢复后必须保留这条工作偏好', '个人记忆保留');
    check(await restoredWorkspace.readMemory(owner.user.id, forgotten.id) === null, '重放当前遗忘清单后旧备份不会复活已删记忆');
    check((await restoredWorkspace.listTasks(other.id)).length === 0, '其他账户不能读取私人任务');
    const restoredEmbedding=await transaction(restoredApp,c=>c.query('SELECT enabled,tested FROM workpivot.embedding_spaces'),owner.user.id);check(restoredEmbedding.rows.length===1&&!restoredEmbedding.rows[0].enabled&&!restoredEmbedding.rows[0].tested,'恢复保留向量空间且暂停并要求重新测试');
    const restoredTrash=new TrashRepository(restoredApp,restoredRepository);
    check(!(await restoredTrash.list(owner.user.id)).entries.some(e=>e.id===purgedEntry.id),'旧备份不能复活后续永久删除的回收站原件');
    check((await restoredTrash.list(owner.user.id)).entries.some(e=>e.id===recycled.id),'真实备份恢复保留回收站条目');
    await restoredTrash.restore(owner.user.id,recycled.id,recycled.revision);check((await restoredRepository.download(owner.user.id,task.id,recycle.id)).data.toString()==='回收站原件正文','恢复备份后仍可还原回收站原件');
    const restoredPlans=new Automations(restoredApp,true), restoredPlan=await restoredPlans.detail(owner.user.id,keptPlan.id);
    check(restoredPlan.state==='paused'&&!restoredPlan.nextAt&&!restoredPlan.draft,'真实备份恢复保留自动化且撤销定时授权');
    check(restoredPlan.runs[0]?.status==='interrupted','恢复后的排队运行不会继续执行');
