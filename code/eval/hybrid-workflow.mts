/** 固定中文语料；可选加载本机 BGE-M3 的真实向量，默认合成向量仅验证协议与隔离。 */
import assert from 'node:assert/strict';import {randomBytes,randomUUID} from 'node:crypto';import {createServer} from 'node:http';import {mkdtemp,rm,readFile} from 'node:fs/promises';import {tmpdir} from 'node:os';import {join} from 'node:path';
import {pool,installSchema,transaction} from '../packages/server/src/database/connection.js';import {AccountRepository} from '../packages/server/src/database/accounts.js';import {WorkspaceRepository} from '../packages/server/src/database/workspace.js';import {FileRepository} from '../packages/server/src/database/files.js';import {KnowledgeRepository,knowledgeTerms} from '../packages/server/src/database/knowledge.js';import {Embeddings} from '../packages/server/src/database/embeddings.js';import {createDatabaseApp} from '../packages/server/src/database/app.js';import {retrievalStatus} from '../apps/web/src/chat-content.js';
const corpus=JSON.parse(await readFile(new URL('./hybrid-corpus.json',import.meta.url),'utf8')) as {documents:{name:string;text:string}[];queries:{text:string;expected:string|null;semanticOnly?:boolean}[]};
const cache=process.env.WORKPIVOT_REAL_VECTORS?JSON.parse(await readFile(process.env.WORKPIVOT_REAL_VECTORS,'utf8')) as Record<string,number[]>:null;
const url=process.env.WORKPIVOT_TEST_PG_URL!;if(!url||process.env.WORKPIVOT_TEST_PG_DISPOSABLE!=='1')throw Error('仅允许隔离数据库');
const password=randomBytes(20).toString('hex'),admin=pool(url),role=(n:string)=>{const u=new URL(url);u.username=n;u.password=password;return u.toString();},db=pool(role('hybrid_app')),auth=pool(role('hybrid_auth')),root=await mkdtemp(join(tmpdir(),'wp-hybrid-'));
let fail=false,gate:Promise<void>|null=null,entered:()=>void=()=>{};const vector=(text:string)=>{if(cache){const v=cache[text];if(!v)throw Error('缺少固定向量');return v;}let i=corpus.documents.findIndex(d=>d.text===text);if(i<0)i=corpus.documents.findIndex(d=>d.name===corpus.queries.find(q=>q.text===text)?.expected);return Array.from({length:7},(_,n)=>n===(i<0?6:i)?1:0);};
const server=createServer(async(req,res)=>{let raw='';for await(const b of req)raw+=b;const body=JSON.parse(raw);entered();if(gate)await gate;if(fail){res.writeHead(503).end('不要回显');return;}res.setHeader('content-type','application/json');try{res.end(JSON.stringify({embeddings:body.input.map(vector)}));}catch{res.writeHead(400).end();}});server.listen(0,'127.0.0.1');await new Promise<void>(r=>server.once('listening',r));
let checks=0;const check=(v:unknown,n:string)=>{assert.ok(v,n);checks++;console.log('通过：'+n);};const rejects=async(fn:()=>Promise<unknown>,n:string)=>{await assert.rejects(fn);check(true,n);};
try{
 await admin.query(`CREATE ROLE hybrid_app LOGIN PASSWORD '${password}' NOSUPERUSER NOBYPASSRLS;CREATE ROLE hybrid_auth LOGIN PASSWORD '${password}' NOSUPERUSER NOBYPASSRLS`);await installSchema(admin,'hybrid_app','hybrid_auth');const accounts=new AccountRepository(auth),owner=await accounts.registerFirst('owner','synthetic-password',password,password),actor=owner.user.id,other=(await accounts.createUser(owner.token,'other','synthetic-password','member')).id;
 const ws=new WorkspaceRepository(db),files=new FileRepository(db,root),embeddings=new Embeddings(db,randomBytes(32).toString('hex')),knowledge=new KnowledgeRepository(db,embeddings),plain=new KnowledgeRepository(db);const project=await ws.createProject(actor,'固定语料'),task=await ws.createTask(actor,'检索验收',project.id),sibling=await ws.createTask(actor,'项目资料',project.id),outside=await ws.createTask(actor,'项目外资料');
 const add=async(t:string,name:string,text:string,document?:string)=>{const f=await files.upload(actor,t,name+'.txt',Buffer.from(text),randomUUID(),document,document?1:undefined);await transaction(db,c=>c.query("INSERT INTO workpivot.document_processing(version_id,owner_user_id,status,parts) VALUES($1,$2,'completed',$3)",[f.id,actor,JSON.stringify([{location:'paragraph:1',text}])]),actor);await knowledge.indexNext(actor);return f;};const docs=[];for(const d of corpus.documents)docs.push(await add(sibling.id,d.name,d.text));await add(outside.id,'禁止跨项目',corpus.documents[0]!.text);
 check(knowledgeTerms('出差花的钱怎样申请报销？').includes('报销'),'中文问句分词');check(knowledgeTerms('PO-2026-041').includes('po-2026-041'),'精确编号保留');check((await plain.search(actor,task.id,'报销')).mode==='keyword','无配置明确关键词模式');
 const space=(await embeddings.create(actor,{name:'固定测试',baseUrl:`http://127.0.0.1:${(server.address() as {port:number}).port}`,modelId:'fixture',modelVersion:'fixed',protocol:'ollama',dimensions:cache?1024:7})).id;
 // 连接校验合成文本也由固定缓存提供，不调用外部业务服务。
 await embeddings.test(actor,space,1);await embeddings.action(actor,space,2,'start');for(let i=0;i<8;i++)await embeddings.process(actor);
 let top1=0,recall3=0;for(const q of corpus.queries){if(q.semanticOnly)check(!(await plain.keyword(actor,task.id,q.text)).matches.length,'改写问题关键词零命中');const r=await knowledge.search(actor,task.id,q.text);check(r.mode==='hybrid','混合模式：'+q.text);if(q.expected){if(r.matches[0]?.name===q.expected+'.txt')top1++;if(r.matches.slice(0,3).some(m=>m.name===q.expected+'.txt'))recall3++;check(r.matches.slice(0,3).some(m=>m.name===q.expected+'.txt'),'前三命中：'+q.expected);}else check(r.matches.length===0,'无关查询不返回片段：'+q.text);check(!r.matches.some(m=>m.name==='禁止跨项目.txt'),'项目范围过滤');check(new Set(r.matches.map(m=>m.chunkId)).size===r.matches.length,'融合去重');}
 check(top1>=8&&recall3===9,'固定集 Top1至少8/9、Recall@3为9/9');console.log(JSON.stringify({realBgeM3:!!cache,top1,total:9,recall3}));
 const found=await knowledge.search(actor,task.id,'报销'),citation=found.matches[0]!;check(citation.citation.includes('#citation/'+citation.chunkId),'输出可点击引用');check((await knowledge.read(actor,task.id,citation.chunkId)).content.includes('交通票据'),'引用返回原文');await rejects(()=>knowledge.read(other,task.id,citation.chunkId),'引用跨用户拒绝');await rejects(()=>knowledge.read(actor,outside.id,citation.chunkId),'引用跨项目拒绝');
 fail=true;const degraded=await knowledge.search(actor,task.id,'报销');check(degraded.mode==='keyword'&&degraded.matches.length>0&&degraded.notice.includes('降级'),'服务失败仍返回关键词并提示');fail=false;
 const controller=new AbortController();controller.abort();await rejects(()=>knowledge.search(actor,task.id,'报销',controller.signal),'用户取消不伪装降级成功');
 let release!:()=>void;gate=new Promise<void>(r=>release=r);const enteredPromise=new Promise<void>(r=>entered=r);const pending=knowledge.search(actor,task.id,corpus.queries[0]!.text);await enteredPromise;await files.remove(actor,sibling.id,docs[0]!.documentId,1);release();const after=await pending;gate=null;entered=()=>{};check(!after.matches.some(m=>m.documentId===docs[0]!.documentId),'向量等待期间删除，融合后不返回旧片段');await rejects(()=>knowledge.read(actor,task.id,citation.chunkId),'删除后旧引用失效');
 let unblock!:()=>void;gate=new Promise<void>(r=>unblock=r);const startedTimeout=new Promise<void>(r=>entered=r);const timed=knowledge.search(actor,task.id,'年假');await startedTimeout;const timeoutResult=await timed;unblock();gate=null;entered=()=>{};check(timeoutResult.mode==='keyword'&&timeoutResult.matches.length>0,'8秒超时后关键词可用');
 let unblockCancel!:()=>void;gate=new Promise<void>(r=>unblockCancel=r);const startedCancel=new Promise<void>(r=>entered=r);const cancelled=new AbortController();const cancellation=knowledge.search(actor,task.id,'年假',cancelled.signal);await startedCancel;cancelled.abort();await rejects(()=>cancellation,'进行中的向量请求响应用户取消');unblockCancel();gate=null;entered=()=>{};
 const pendingOld=(await knowledge.search(actor,task.id,'PO-2026-041')).matches.find(m=>m.documentId===docs[3]!.documentId)!;await files.upload(actor,sibling.id,'采购规则.txt',Buffer.from('待解析新版'),randomUUID(),docs[3]!.documentId,1);check((await knowledge.read(actor,task.id,pendingOld.chunkId)).latestRevision===2,'新版本未解析时引用明确显示最新版本');
 const old=(await knowledge.search(actor,task.id,'年假')).matches.find(m=>m.documentId===docs[1]!.documentId)!;await add(sibling.id,'休假制度',corpus.documents[2]!.text,docs[1]!.documentId);await rejects(()=>knowledge.read(actor,task.id,old.chunkId),'新版本解析后旧引用失效');const newer=await knowledge.search(actor,task.id,'年假');check(!newer.matches.some(m=>m.chunkId===old.chunkId),'新版本未向量化也不召回旧版');
 const http=(await createDatabaseApp(auth,db,password,undefined,undefined,undefined,undefined,files,undefined,undefined,embeddings)).listen(0,'127.0.0.1');await new Promise<void>(r=>http.once('listening',r));try{const port=(http.address() as {port:number}).port;check((await fetch(`http://127.0.0.1:${port}/api/tasks/${task.id}/knowledge?q=报销`)).status===401,'检索HTTP必须登录');}finally{await new Promise<void>(r=>http.close(()=>r()));}
 check(retrievalStatus(JSON.stringify({toolName:'search_project_documents',ok:true,message:JSON.stringify(degraded).slice(0,200)}))?.includes('关键词'),'截断工具事件仍显示降级提示');console.log('混合检索专项：'+checks+'项通过');
}finally{await new Promise<void>(r=>server.close(()=>r()));await db.end();await auth.end();await admin.end();await rm(root,{recursive:true,force:true});}
