import {auditChecks} from './request-audit-checks.mjs';
import {AdminOperations} from '../packages/server/src/database/admin-operations.js';
/** 真实隔离 PostgreSQL 与受限角色验证容量，不启动模型或执行容器。 */
import assert from 'node:assert/strict';
import { randomBytes, randomUUID } from 'node:crypto';
import { pool, installSchema, transaction } from '../packages/server/src/database/connection.js';
import { AccountRepository } from '../packages/server/src/database/accounts.js';
import { DatabaseSkills } from '../packages/server/src/database/skills.js';
import { Automations } from '../packages/server/src/database/automations.js';
import { newAutomationConfig, type AutomationConfig } from '../packages/shared/src/index.js';
const url = process.env.WORKPIVOT_TEST_PG_URL;
if (!url || process.env.WORKPIVOT_TEST_PG_DISPOSABLE !== '1' || new URL(url).hostname !== '127.0.0.1' || new URL(url).pathname !== '/workpivot_test') throw Error('仅允许隔离测试数据库');
const secret = randomBytes(32).toString('hex'), admin = pool(url);
const role = (name: string) => { const value = new URL(url); value.username = name; value.password = secret; return value.href; };
const db = pool(role('capacity_app')), auth = pool(role('capacity_auth'));
let checks = 0;
function check(value: unknown, label: string) { assert.ok(value, label); console.log('通过：' + label); checks++; }
try {
  await admin.query(`CREATE ROLE capacity_app LOGIN PASSWORD '${secret}' NOSUPERUSER NOBYPASSRLS; CREATE ROLE capacity_auth LOGIN PASSWORD '${secret}' NOSUPERUSER NOBYPASSRLS`);
  await installSchema(admin, 'capacity_app', 'capacity_auth');
  const accounts = new AccountRepository(auth), user = await accounts.registerFirst('owner', 'synthetic-password', secret, secret);
  const actor = user.user.id, other = (await accounts.createUser(user.token, 'other', 'synthetic-password', 'member')).id;
  const skills = new DatabaseSkills(db), plans = new Automations(db, true);
  async function configFor(owner: string, name: string): Promise<AutomationConfig> {
    let skill = await skills.create(owner, name);
    skill = await skills.save(owner, name, 'SKILL.md', Buffer.from(`---\nname: ${name}\ndescription: 容量合成测试\n---\n仅用于隔离测试。`), skill.revision);
    await skills.publish(owner, name, skill.revision); await skills.select(owner, name, true);
    return { ...newAutomationConfig(), name: '容量测试', skill: name, releaseId: (await skills.market(owner)).find(item => item.name === name)!.version, requirements: '验证容量', timing: { ...newAutomationConfig().timing, kind: 'interval', minutes: 120 } };
  }
  const config = await configFor(actor, 'capacity-test'), otherConfig = await configFor(other, 'other-capacity');
  const drafts = await Promise.all(Array.from({ length: 21 }, () => plans.draft(actor, config, randomUUID())));
  const enabled = await Promise.allSettled(drafts.map(plan => plans.confirm(actor, plan.id, plan.revision, true)));
  check(enabled.filter(item => item.status === 'fulfilled').length === 20, '21个并发启用请求仅20个成功');
  const refused = enabled.find(item => item.status === 'rejected');
  check(refused?.status === 'rejected' && /最多启用20/.test(String(refused.reason)), '容量拒绝返回明确原因');
  let list = await plans.list(actor);
  const extra = list.find(plan => plan.state === 'draft')!;
  check(!!extra.draft && !extra.config, '容量拒绝保留草稿及未授权状态');
  const first = list.find(plan => plan.state === 'enabled')!;
  const paused = await plans.action(actor, first.id, first.revision, 'pause');
  const replacement = await plans.confirm(actor, extra.id, extra.revision, true);
  check(replacement.state === 'enabled', '停用后容量立即释放');
  await assert.rejects(plans.confirm(actor, paused.id, paused.revision, true), /最多启用20/);
  check(true, '重新启用同样受容量控制');
  const edited = await plans.draft(actor, { ...config, name: '已启用计划修改' }, randomUUID(), replacement.id, replacement.revision);
  check((await plans.confirm(actor, edited.id, edited.revision, true)).state === 'enabled', '满额时允许修改已有启用计划');
  let otherPlan = await plans.draft(other, otherConfig, randomUUID()); otherPlan = await plans.confirm(other, otherPlan.id, otherPlan.revision, true);
  await plans.manual(other, otherPlan.id, otherPlan.revision, randomUUID());
  check((await plans.options(other)).capacity.enabled === 1 && (await plans.options(other)).capacity.queued === 1, 'RLS下其他用户额度独立');
  list = (await plans.list(actor)).filter(plan => plan.state === 'enabled');
  const requests = list.map(plan => ({ plan, requestId: randomUUID() }));
  const manual = await Promise.allSettled(requests.map(({ plan, requestId }) => plans.manual(actor, plan.id, plan.revision, requestId)));
  check(manual.filter(item => item.status === 'fulfilled').length === 10 && (await plans.options(actor)).capacity.queued === 10, '20个并发手动运行仅10个入队');
  const winner = manual.findIndex(item => item.status === 'fulfilled'), request = requests[winner]!;
  const old = manual[winner]!; assert.equal(old.status, 'fulfilled');
  check((await plans.manual(actor, request.plan.id, request.plan.revision, request.requestId)).id === old.value.id, '满额时幂等重试返回原运行，不重复入队');
  const at = new Date(Date.now() - 1000), now = new Date();
  await transaction(db, client => client.query("UPDATE workpivot.automations SET next_at=$1 WHERE state='enabled'", [at]), actor);
  await Promise.all([plans.enqueue(actor, now), new Automations(db, true).enqueue(actor, now)]);
  const deferred = (await plans.list(actor)).filter(plan => plan.issue.startsWith('等待排队额度'));
  check(deferred.length === 10 && deferred.every(plan => new Date(plan.nextAt!).getTime() === at.getTime()), '双调度器容量满时保留原触发时间并记录等待原因');
  check((await plans.options(actor)).capacity.queued === 10, '定时与手动共享同一用户排队上限');
  await plans.stopRun(actor, request.plan.id, old.value.id);
  await plans.enqueue(actor, now);
  const remaining = (await plans.list(actor)).filter(plan => plan.issue.startsWith('等待排队额度'));
  const recovered = deferred.find(plan => !remaining.some(item => item.id === plan.id))!;
  const detail = await plans.detail(actor, recovered.id);
  check(remaining.length === 9 && detail.runs.some(run => new Date(run.scheduledFor).getTime() === at.getTime()) && !detail.issue, '释放一个槽后只补入一次，保留原计划时间并清除等待原因');
  // 保留用户明确选择的“跳过”，额度等待不能偷偷改成补跑。
  const skip = remaining[0]!;
  const skipPlan = await plans.draft(actor, { ...config, catchup: 'skip' }, randomUUID(), skip.id, skip.revision);
  await plans.confirm(actor, skip.id, skipPlan.revision, true);
  await transaction(db, client => client.query('UPDATE workpivot.automations SET next_at=$2 WHERE id=$1', [skip.id, at]), actor);
  await plans.enqueue(actor, new Date(at.getTime() + 120000));
  const skipped = await plans.detail(actor, skip.id);
  check(!skipped.runs.length && !skipped.issue && new Date(skipped.nextAt!).getTime() > at.getTime(), '跳过策略在额度等待后仍跳过过期触发');
  // 既有超额计划不自动停用，但不再接纳额外启用请求。
  await transaction(db, client => client.query("UPDATE workpivot.automations SET state='enabled',config=$2,grant_id=$3,next_at=now()+interval '1 day' WHERE id=$1", [paused.id, config, randomUUID()]), actor);
  check((await plans.options(actor)).capacity.enabled === 21, '历史超额如实显示，不静默停用计划');
  const fresh = await plans.draft(actor, config, randomUUID());
  await assert.rejects(plans.confirm(actor, fresh.id, fresh.revision, true), /最多启用20/);
  check(true, '历史超额时禁止新增启用');
  await transaction(db, async client => {
    await client.query("UPDATE workpivot.automation_runs SET status='cancelled' WHERE status='queued'");
    await client.query("UPDATE workpivot.automations SET next_at=now() WHERE state='enabled'");
  }, actor);
  const racePlans = (await plans.list(actor)).filter(plan => plan.state === 'enabled');
  await Promise.allSettled([new Automations(db, true).enqueue(actor), ...racePlans.map(plan => plans.manual(actor, plan.id, plan.revision, randomUUID()))]);
  check((await plans.options(actor)).capacity.queued === 10, '手动入口与另一个调度实例同时入队仍不超额');
  await plans.enqueue(actor);
  const waiting = (await plans.list(actor)).find(plan => plan.issue.startsWith('等待排队额度'));
  assert.ok(waiting);
  const stopped = await plans.action(actor, waiting.id, waiting.revision, 'pause');
  check(stopped.state === 'paused' && !stopped.issue, '停用等待额度的计划后不再显示继续排队');
  const management=new AdminOperations(auth,db);
  const initial=await management.capacity(user.token,actor);
  check(initial.capacity.revision===0&&initial.audit.length===0,'管理员读取默认容量及空审计');
  const member=await accounts.login('other','synthetic-password');
  await assert.rejects(management.capacity(member.token,actor),/管理员/);
  await assert.rejects(management.setCapacity(member.token,actor,{enabledLimit:1,queuedLimit:1,revision:0,requestId:randomUUID(),reason:'越权测试'}),/管理员/);
  check(true,'非管理员不能读取管理审计或修改额度');
  const change={enabledLimit:0,queuedLimit:0,revision:0,requestId:randomUUID(),reason:'合成容量调整'};
  const results=await Promise.allSettled([management.setCapacity(user.token,actor,change),management.setCapacity(user.token,actor,{...change,requestId:randomUUID()})]);
  check(results.filter(row=>row.status==='fulfilled').length===1,'管理员并发修改通过版本检查防止覆盖');
  const updated=await management.capacity(user.token,actor);
  check(updated.capacity.enabledLimit===0&&updated.capacity.queuedLimit===0&&updated.audit.length===1&&updated.audit[0].before.enabledLimit===20&&updated.audit[0].actorId===actor,'额度与完整变更摘要原子保存');
  const winnerRecord=(await transaction(db,c=>c.query('SELECT request_id FROM workpivot.automation_capacity_audit WHERE revision=1'),actor)).rows[0];
  await management.setCapacity(user.token,actor,{...change,requestId:winnerRecord.request_id});
  check((await management.capacity(user.token,actor)).audit.length===1,'请求重试不重复记录成功审计');
  await assert.rejects(plans.confirm(actor,fresh.id,fresh.revision,true),/最多启用0/);
  check((await new Automations(db,true).options(actor)).capacity.queuedLimit===0,'管理员额度在新实例立即生效');
  await assert.rejects(management.setCapacity(user.token,actor,{...change,revision:1,enabledLimit:101,requestId:randomUUID()}),/额度/);
  await assert.rejects(transaction(db,c=>c.query("UPDATE workpivot.automation_capacity_audit SET reason='篡改'"),actor));
  await assert.rejects(transaction(db,c=>c.query('DELETE FROM workpivot.automation_capacity_audit'),actor));
  check(true,'非法额度被拒，应用角色不能修改删除审计');
  check((await management.capacity(user.token,other)).audit.length===0&&(await plans.options(other)).capacity.enabledLimit===20,'额度和审计均按目标用户隔离');
  await admin.query("CREATE FUNCTION workpivot.synthetic_audit_failure() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic'; END $$; CREATE TRIGGER synthetic_audit_failure BEFORE INSERT ON workpivot.automation_capacity_audit FOR EACH ROW EXECUTE FUNCTION workpivot.synthetic_audit_failure()");
  try {await assert.rejects(management.setCapacity(user.token,actor,{...change,revision:1,enabledLimit:2,requestId:randomUUID()}));}
  finally {await admin.query('DROP TRIGGER synthetic_audit_failure ON workpivot.automation_capacity_audit; DROP FUNCTION workpivot.synthetic_audit_failure()');}
  check((await management.capacity(user.token,actor)).capacity.enabledLimit===0,'审计写入失败时额度更新一起回滚');
  for(let revision=1;revision<=51;revision++)await management.setCapacity(user.token,actor,{enabledLimit:20,queuedLimit:10,revision,requestId:randomUUID(),reason:'合成分页验收'});
  const page=await management.capacity(user.token,actor),older=await management.capacity(user.token,actor,page.nextBefore!);
  check(page.audit.length===50&&older.audit.length===2&&new Set([...page.audit,...older.audit].map(row=>row.revision)).size===52,'审计稳定分页无遗漏重复');
  const attempts=await management.attempts(user.token,actor);
  check(['permission_denied','invalid_input','conflict','internal_error'].every(category=>attempts.attempts.some(row=>row.category===category)),'权限、参数、冲突和服务失败均记录固定分类');
  await assert.rejects(management.attempts(member.token,actor),/管理员/);
  check(true,'普通成员不能读取失败审计');
  await assert.rejects(management.setCapacity(user.token,'PRIVATE_TARGET_SECRET',{reason:'PRIVATE_REASON_SECRET',requestId:'PRIVATE_TOKEN_SECRET'}));
  const invalid=await management.attempts(user.token,actor,'invalid_input');
  check(invalid.attempts.some(row=>row.targetId===null)&&!JSON.stringify(invalid).includes('PRIVATE_'),'无效目标归操作人且原始请求字段不落库返回');
  const absent=randomUUID();await assert.rejects(management.setCapacity(member.token,absent,{}));
  check((await management.attempts(user.token,other)).attempts.some(row=>row.targetId===absent),'越权访问不存在目标仍归入真实操作人审计');
  await assert.rejects(transaction(db,c=>c.query("DELETE FROM workpivot.management_attempts"),actor));
  await assert.rejects(transaction(db,c=>c.query("UPDATE workpivot.management_attempts SET category='conflict'"),actor));
  check(true,'失败审计同样禁止删除或篡改');
  await admin.query("INSERT INTO workpivot.management_attempts(owner_user_id,actor_id,target_id,action,category,created_at) SELECT $1,$1,$1,'automation.capacity.update','not_found','2026-01-01T01:02:03.123456Z' FROM generate_series(1,53)",[actor]);
  const firstPage=await management.attempts(user.token,actor,'not_found');
  const nextPage=await management.attempts(user.token,actor,'not_found',firstPage.next!.at,firstPage.next!.id);
  check(firstPage.attempts.length===50&&nextPage.attempts.length===3&&new Set([...firstPage.attempts,...nextPage.attempts].map(row=>row.id)).size===53,'同微秒时间的失败审计分页不漏不重');
  await assert.rejects(management.attempts(user.token,actor,'raw-secret'));
  await assert.rejects(management.attempts(user.token,actor,undefined,'invalid',randomUUID()));
  await assert.rejects(management.attempts(user.token,actor,undefined,'0000-01-01T00:00:00.000000Z',randomUUID()));
  await assert.rejects(management.attempts(user.token,actor,undefined,'2026-02-31T00:00:00.000000Z',randomUUID()));
  check(true,'审计分类和游标严格校验');
  await admin.query("CREATE FUNCTION workpivot.synthetic_attempt_failure() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'synthetic'; END $$; CREATE TRIGGER synthetic_attempt_failure BEFORE INSERT ON workpivot.management_attempts FOR EACH ROW EXECUTE FUNCTION workpivot.synthetic_attempt_failure()");
  try{await assert.rejects(management.setCapacity(user.token,actor,{}),/失败审计未能保存/);}
  finally{await admin.query('DROP TRIGGER synthetic_attempt_failure ON workpivot.management_attempts; DROP FUNCTION workpivot.synthetic_attempt_failure()');}
  check(true,'失败审计存储不可用时明确返回服务异常而不伪造记录');
  await auditChecks(admin,auth,db,secret,actor,user.token,member.token,check);
  console.log(`自动化容量：${checks}项通过`);
} finally { await Promise.all([db.end(), auth.end(), admin.end()]); }
