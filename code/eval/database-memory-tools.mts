import { MemorySuggestions } from '../packages/server/src/database/memory-suggestions.js';
import assert from 'node:assert/strict';
import type { Pool } from 'pg';
import { DatabaseMemoryTools } from '../packages/server/src/database/memory-tools.js';
import { WorkspaceRepository } from '../packages/server/src/database/workspace.js';

export async function testMemoryTools(db: Pool, owner: string, other: string, check: (value: unknown, label: string) => void) {
  const workspace = new WorkspaceRepository(db), tools = new DatabaseMemoryTools(db);
  const project = await workspace.createProject(owner, 'memory tools project');
  const second = await workspace.createProject(owner, 'unrelated project');
  const task = await workspace.createTask(owner, 'memory tools task', project.id);
  const sibling = await workspace.createTask(owner, 'sibling task', project.id);
  const personal = await workspace.createMemory(owner, 'mt-personal', 'user');
  const shared = await workspace.createMemory(owner, 'mt-project', 'project', project.id);
  const local = await workspace.createMemory(owner, 'mt-task', 'task', task.id);
  const foreignProject = await workspace.createMemory(owner, 'mt-other-project', 'project', second.id);
  const foreignTask = await workspace.createMemory(owner, 'mt-other-task', 'task', sibling.id);
  const found = await tools.search(owner, task.id, 'mt-');
  check([personal.id, shared.id, local.id].every(id => found.memories.some(m => m.id === id)), 'task retrieval finds all three memory layers');
  check(!found.memories.some(m => [foreignProject.id, foreignTask.id].includes(m.id)), 'retrieval excludes unrelated project and sibling task');
  await assert.rejects(() => tools.read(owner, task.id, foreignProject.id)); check(true, 'direct memory read cannot bypass project scope');
  await assert.rejects(() => tools.search(other, task.id, '')); check(true, 'foreign user cannot retrieve through task id');
  await assert.rejects(() => tools.read(other, task.id, personal.id)); check(true, 'foreign user cannot read memory');
  const long = await workspace.createMemory(owner, 'x'.repeat(9000), 'task', task.id);
  const first = await tools.read(owner, task.id, long.id);
  check(first.content.length === 4000 && first.nextOffset === 4000, 'memory detail bounded to 4000 characters');
  check((await tools.read(owner, task.id, long.id, 8000)).nextOffset === null, 'memory detail paging terminates');
  await workspace.deleteMemory(owner, local.id, local.revision);
  check(!(await tools.search(owner, task.id, 'mt-task')).memories.length, 'deleted memory disappears from retrieval');
  await assert.rejects(() => tools.read(owner, task.id, local.id)); check(true, 'deleted memory cannot be read by existing tool');
  const suggestions = new MemorySuggestions(db);
  const before = await suggestions.epoch(owner);
  const proposal = await suggestions.propose(owner, task.id, before, 'user', 'proposed preference');
  check(!(await tools.search(owner, task.id, 'proposed preference')).memories.length, 'pending suggestion is not active memory');
  await assert.rejects(() => suggestions.decide(other, proposal.id, true)); check(true, 'foreign user cannot confirm suggestion');
  await suggestions.decide(owner, proposal.id, false);
  check((await suggestions.propose(owner, task.id, before, 'user', 'proposed preference')).status === 'rejected', 'rejected identical suggestion does not reappear');
  const accepted = await suggestions.propose(owner, task.id, before, 'user', 'confirmed preference');
  await suggestions.decide(owner, accepted.id, true, 'user edited preference');
  check((await tools.search(owner, task.id, 'user edited preference')).memories.length === 1, 'only user-confirmed edited content becomes memory');
  await assert.rejects(() => suggestions.decide(owner, accepted.id, true)); check(true, 'duplicate confirmation cannot create duplicate memory');
  const batchEpoch = await suggestions.epoch(owner);
  const unrelated = await suggestions.propose(owner, task.id, batchEpoch, 'user', 'unrelated accepted preference');
  const update = await suggestions.propose(owner, task.id, batchEpoch, 'user', 'updated personal preference', personal.id, personal.revision);
  check((await suggestions.list(owner)).some(s => s.id === update.id && s.originalContent === 'mt-personal'), 'update suggestion shows original memory');
  await suggestions.decide(owner, unrelated.id, true);
  check((await suggestions.list(owner)).some(s => s.id === update.id), 'accepting unrelated suggestion preserves remaining candidate');
  await suggestions.decide(owner, update.id, true);
  check((await workspace.readMemory(owner, personal.id))?.revision === 2, 'confirmed update increments existing memory revision');
  check((await workspace.readMemory(owner, personal.id))?.content === 'updated personal preference', 'confirmed update changes target instead of creating duplicate');
  await assert.rejects(async () => suggestions.propose(owner, task.id, await suggestions.epoch(owner), 'user', 'stale overwrite', personal.id, 1)); check(true, 'stale target revision rejected at proposal');
  const stale = await suggestions.propose(owner, task.id, await suggestions.epoch(owner), 'user', 'stale preference');
  await workspace.editMemory(owner, shared.id, 'updated project fact', shared.revision);
  await assert.rejects(() => suggestions.decide(owner, stale.id, true)); check(true, 'manual edit invalidates earlier suggestions');
  const queryTool = tools.tools(owner, task.id)[0]!;
  check(String(await queryTool.run({ query: 'updated project fact' }, { taskDir: '.' })).includes(shared.id), 'model-facing search tool reads database');
  await workspace.deleteTask(owner, task.id, task.revision);
  await assert.rejects(() => queryTool.run({ query: '' }, { taskDir: '.' })); check(true, 'deleted task revokes existing memory tools');
  await workspace.deleteProject(owner, project.id, project.revision);
  await workspace.deleteProject(owner, second.id, second.revision);
  await workspace.deleteMemory(owner, personal.id, 2);
}
