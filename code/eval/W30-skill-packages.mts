import assert from 'node:assert/strict';
import { mkdtempSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { tmpdir } from 'node:os';

const root = mkdtempSync(join(tmpdir(), 'wp30-'));
process.env['WORKPIVOT_HOME'] = join(root, 'home');
process.env['WORKPIVOT_WORKSPACE'] = join(root, 'workspace');
process.env['WORKPIVOT_HOST'] = '127.0.0.1';
process.env['WORKPIVOT_INSECURE_SECRETS'] = '1';
process.env['WORKPIVOT_EXECUTION_MODE'] = 'disabled';
process.env['WORKPIVOT_MAX_PARALLEL'] = '1';
process.env['NODE_ENV'] = 'test';
const { withTenant, withAccount } = await import('../packages/server/src/tenants.js');
const auth = await import('../packages/server/src/auth.js');
const { createApp } = await import('../packages/server/src/app.js');
const { initializeSecretBox } = await import('../packages/server/src/secret.js');
const admin = withTenant('default', () => auth.registerFirstAdmin('workflow-admin', 'fixture-password'));
const member = withTenant('default', () => { auth.createUser('workflow-member', 'fixture-password', 'member'); return auth.login('workflow-member', 'fixture-password'); });
initializeSecretBox();

const {listSkills, pinPublishedSkills} = await import('../packages/server/src/skills.js');
const {workspaceRoot} = await import('../packages/server/src/tasks.js');
const {buildSkillTools} = await import('../packages/server/src/skill-tools.js');
const other = withTenant('default', () => { auth.createUser('other-admin', 'fixture-password', 'admin'); return auth.login('other-admin','fixture-password'); });
const server = createApp().listen(0,'127.0.0.1'); await new Promise<void>(r=>server.once('listening',r));
const address=server.address(); if(!address || typeof address==='string') throw Error('port');
const request=(path:string,token=admin.token,method='GET',body?:unknown)=>fetch('http://127.0.0.1:'+address.port+'/api'+path,{method,headers:{authorization:'Bearer '+token,'content-type':'application/json'},...(body===undefined?{}:{body:JSON.stringify(body)})});
let count=0; function check(name:string,value:unknown):void {assert.ok(value,name);count++;console.log('✅ '+name);}

const { createRequire } = await import('node:module');
const serverRequire=createRequire(new URL('../packages/server/package.json',import.meta.url));
const Zip=serverRequire('adm-zip');
const base='/skill-packages/research-pack';
const raw=(endpoint:string,data:Buffer,revision:string,token=admin.token)=>fetch('http://127.0.0.1:'+address.port+'/api'+base+endpoint+revision,{method:endpoint.startsWith('/upload')?'PUT':'POST',headers:{authorization:'Bearer '+token,'content-type':'application/octet-stream'},body:data});
const body=async(response:Response)=>{if(!response.ok)throw Error(await response.text());return response.json();};
const get=()=>bodyAwait(request(base));
async function bodyAwait(p:Promise<Response>){return body(await p);}
try {
 check('member package access denied',(await request('/skill-packages',member.token)).status===403);
 check('invalid package name rejected',(await request('/skill-packages',admin.token,'POST',{name:'../escape'})).status===400);
 let detail=await body(await request('/skill-packages',admin.token,'POST',{name:'research-pack'}));
 check('new package is unpublished',detail.published===null);
 check('member can browse skill market',(await request('/skill-market',member.token)).status===200);
 check('draft absent from skill market',!(await body(await request('/skill-market'))).skills.some((s:{name:string})=>s.name==='research-pack'));
 check('draft excluded from runtime',withAccount(admin.user,()=>!listSkills(workspaceRoot()).some(s=>s.name==='research-pack')));
 check('foreign admin cannot inspect draft',(await request(base,other.token)).status===404);
 const instructions='---\nname: research-pack\ndescription: Research package test\n---\n\nRead references/data.txt; use templates/table.bin.\n';
 detail=await body(await request(base+'/file',admin.token,'PUT',{path:'SKILL.md',content:instructions,revision:detail.revision}));
 const stale=detail.revision;
 detail=await body(await request(base+'/file',admin.token,'PUT',{path:'references/data.txt',content:'VERSION ONE',revision:detail.revision}));
 check('stale draft write rejected',(await request(base+'/file',admin.token,'PUT',{path:'references/data.txt',content:'stale',revision:stale})).status===409);
 const binary=Buffer.from([0,255,17,8,4]);
 detail=await body(await raw('/upload?path=templates%2Ftable.bin&revision=',binary,detail.revision));
 check('binary upload preserved',Buffer.from(await (await request(base+'/download?path=templates/table.bin')).arrayBuffer()).equals(binary));
 check('traversal upload rejected',(await raw('/upload?path=..%2Fescape&revision=',binary,detail.revision)).status===400);
 check('case collision rejected',(await request(base+'/file',admin.token,'PUT',{path:'skill.md',content:'x',revision:detail.revision})).status===400);
 check('main file cannot be deleted',(await request(base+'/file?path=SKILL.md',admin.token,'DELETE',{revision:detail.revision})).status===400);
 check('draft validation succeeds',(await body(await request(base+'/validate',admin.token,'POST'))).valid);
 const dirRevision=detail.revision;
 detail=await body(await request(base+'/directory',admin.token,'POST',{path:'assets/empty',revision:detail.revision}));
 check('empty nested directory created',detail.directories.includes('assets/empty'));
 check('stale directory request rejected',(await request(base+'/directory',admin.token,'POST',{path:'stale',revision:dirRevision})).status===409);
 check('folder traversal rejected',(await request(base+'/directory',admin.token,'POST',{path:'../outside',revision:detail.revision})).status===400);
 check('folder file collision rejected',(await request(base+'/directory',admin.token,'POST',{path:'SKILL.md',revision:detail.revision})).status===400);
 check('file folder collision rejected',(await request(base+'/file',admin.token,'PUT',{path:'assets',content:'bad',revision:detail.revision})).status===400);
 detail=await body(await request(base+'/publish',admin.token,'POST',{revision:detail.revision}));
 const v1=detail.published; check('publish creates version',!!v1 && !detail.dirty);
 const market=(await body(await request('/skill-market'))).skills.find((s:{name:string})=>s.name==='research-pack');
 check('market shows published metadata only',market?.version===v1&&market.description==='Research package test'&&!market.dir&&!market.content);
 check('private published package absent from other account market',!(await body(await request('/skill-market',other.token))).skills.some((s:{name:string})=>s.name==='research-pack'));
 const discover=withAccount(admin.user,()=>pinPublishedSkills(()=>listSkills(workspaceRoot())));
 const old=withAccount(admin.user,()=>discover().find(s=>s.name==='research-pack')!);
 check('runtime uses published resources',readFileSync(join(old.dir,'references/data.txt'),'utf8')==='VERSION ONE');
 detail=await body(await request(base+'/file',admin.token,'PUT',{path:'references/data.txt',content:'VERSION TWO',revision:detail.revision}));
 check('draft does not alter published resources',readFileSync(join(old.dir,'references/data.txt'),'utf8')==='VERSION ONE');
 detail=await body(await request(base+'/publish',admin.token,'POST',{revision:detail.revision}));
 const v2=detail.published;
 check('new rounds see new version',withAccount(admin.user,()=>listSkills(workspaceRoot()).find(s=>s.name==='research-pack')?.packageVersion)===v2);
 check('running round pins old resources',withAccount(admin.user,()=>discover().find(s=>s.name==='research-pack')?.dir)===old.dir);
 const loaded=await withAccount(admin.user,()=>buildSkillTools(()=>listSkills(workspaceRoot()),()=>true)[0]!.run({name:'research-pack',file:'references/data.txt'},{taskDir:workspaceRoot()}));
 check('load_skill sees published reference',JSON.parse(loaded).content==='VERSION TWO');
 check('foreign admin cannot download version',(await request(base+'/download?path=SKILL.md&version='+v1,other.token)).status===404);
 check('forged version denied',(await request(base+'/export?version=../../escape')).status===404);
 const archive=Buffer.from(await (await request(base+'/export?version='+v1)).arrayBuffer());
 const zip=new Zip(archive);check('version export contains original binary',zip.readFile('templates/table.bin').equals(binary));
 check('version export preserves empty folder',zip.getEntry('assets/empty/').isDirectory);
 detail=await body(await request(base+'/rollback',admin.token,'POST',{version:v1,revision:detail.revision}));
 check('rollback retains draft',detail.published===v1 && detail.dirty);
 check('rollback activates old resources',withAccount(admin.user,()=>listSkills(workspaceRoot()).find(s=>s.name==='research-pack')?.packageVersion)===v1);
 detail=await body(await request(base+'/discard',admin.token,'POST',{revision:detail.revision}));
 check('discard restores whole published draft',!detail.dirty && (await body(await request(base+'/file?path=references/data.txt'))).content==='VERSION ONE');
 check('discard preserves published empty folder',detail.directories.includes('assets/empty'));
 detail=await body(await raw('/import?revision=',archive,detail.revision));
 check('zip roundtrip preserves empty folder',detail.directories.includes('assets/empty') && !detail.dirty);
 check('foreign account cannot delete folder',(await request(base+'/directory?path=references',other.token,'DELETE',{revision:detail.revision})).status===404);
 check('stale folder deletion rejected',(await request(base+'/directory?path=references',admin.token,'DELETE',{revision:'stale'})).status===409);
 check('root deletion denied',(await request(base+'/directory?path=',admin.token,'DELETE',{revision:detail.revision})).status===400);
 detail=await body(await request(base+'/directory?path=references',admin.token,'DELETE',{revision:detail.revision}));
 check('folder deletion removes draft children',!detail.files.some((f:{path:string})=>f.path.startsWith('references/')) && !detail.directories.includes('references'));
 check('folder deletion preserves published files',await (await request(base+'/download?path=references/data.txt&version='+v1)).text()==='VERSION ONE');
 detail=await body(await request(base+'/directory?path=assets',admin.token,'DELETE',{revision:detail.revision}));
 check('folder deletion removes empty descendants',!detail.directories.some((d:string)=>d==='assets'||d.startsWith('assets/')));
 const nested=new Zip();nested.addFile('research-pack/SKILL.md',Buffer.from(instructions));nested.addFile('research-pack/templates/table.bin',binary);
 detail=await body(await raw('/import?revision=',nested.toBuffer(),detail.revision));
 check('nested zip imports as draft',detail.files.length===2 && detail.published===v1 && detail.dirty);
 const evil=new Zip();evil.addFile('SKILL.md',Buffer.from(instructions));evil.addFile('escape.txt',Buffer.from('bad'));const evilBytes=evil.toBuffer();
 // 同时修改本地目录和中央目录中的名称，保持长度不变。
 for(let at=evilBytes.indexOf(Buffer.from('escape.txt'));at>=0;at=evilBytes.indexOf(Buffer.from('escape.txt'),at+1))Buffer.from('../bad.txt').copy(evilBytes,at);
 check('zip traversal rejected',(await raw('/import?revision=',evilBytes,detail.revision)).status===400);
 const link=new Zip();link.addFile('SKILL.md',Buffer.from(instructions));const e=link.addFile('references/link',Buffer.from('/etc/passwd'));e.attr=(0xa1ff<<16)>>>0;
 check('zip symlink rejected',(await raw('/import?revision=',link.toBuffer(),detail.revision)).status===400);
 const duplicate=new Zip();duplicate.addFile('SKILL.md',Buffer.from(instructions));duplicate.addFile('A.txt',Buffer.from('a'));duplicate.addFile('a.txt',Buffer.from('b'));
 check('zip case collisions rejected',(await raw('/import?revision=',duplicate.toBuffer(),detail.revision)).status===400);
 const bomb=new Zip();bomb.addFile('SKILL.md',Buffer.from(instructions));bomb.addFile('large.bin',Buffer.alloc(9*1024*1024,65));
 check('zip decompressed size limit enforced',(await raw('/import?revision=',bomb.toBuffer(),detail.revision)).status===400);
 const forged=new Zip();forged.addFile('SKILL.md',Buffer.from(instructions));forged.addFile('bomb.bin',Buffer.alloc(1024*1024,65));const forgedBytes=forged.toBuffer();
 for(let at=0;at<forgedBytes.length-46;at++) if(forgedBytes.readUInt32LE(at)===0x02014b50 && forgedBytes.subarray(at+46,at+54).toString()==='bomb.bin')forgedBytes.writeUInt32LE(1,at+24);
 check('forged zip size cannot bypass inflate cap',(await raw('/import?revision=',forgedBytes,detail.revision)).status===400);
 check('failed imports preserve draft revision',(await get()).revision===detail.revision);
 detail=await body(await request(base+'/file',admin.token,'PUT',{path:'skill.json',content:JSON.stringify({requiredSkills:['not-installed']}),revision:detail.revision}));
 check('missing dependency prevents validation',!(await body(await request(base+'/validate',admin.token,'POST'))).valid);
 check('invalid package never publishes',(await request(base+'/publish',admin.token,'POST',{revision:detail.revision})).status===400 && (await get()).published===v1);
 detail=await body(await request(base+'/file?path=skill.json',admin.token,'DELETE',{revision:detail.revision}));
 detail=await body(await request(base+'/file',admin.token,'PUT',{path:'references/broken.md',content:'[Missing](missing.md)',revision:detail.revision}));
 check('missing resource reference rejected',!(await body(await request(base+'/validate',admin.token,'POST'))).valid);
 detail=await body(await request(base+'/file?path=references/broken.md',admin.token,'DELETE',{revision:detail.revision}));
 await request(base+'/toggle',admin.token,'POST',{disabled:true});
 check('disable still revokes pinned skills',withAccount(admin.user,()=>!discover().some(s=>s.name==='research-pack')));
 check('disabled package hidden in market',!(await body(await request('/skill-market'))).skills.some((s:{name:string})=>s.name==='research-pack'));
 check('member cannot mutate package',(await request(base+'/publish',member.token,'POST',{revision:detail.revision})).status===403);
 const seed=await body(await request('/skill-packages/docx-report/open',admin.token,'POST'));
 check('existing builtin becomes managed with initial rollback',seed.versions.length===1 && seed.published && seed.files.some((f:{path:string})=>f.path==='SKILL.md'));
 check('legacy save cannot bypass publication',(await request('/skills/docx-report',admin.token,'PUT',{content:instructions,revision:'old'})).status===409);
 console.log('W30 '+count+'/'+count+' passed');
} finally {server.closeAllConnections();await new Promise<void>(r=>server.close(()=>r()));}
