import assert from 'node:assert/strict';
import { mkdtempSync, rmSync, readFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
const root = mkdtempSync(join(tmpdir(), 'wp37-'));
Object.assign(process.env, { NODE_ENV: 'test', WORKPIVOT_HOME: join(root, 'home'), WORKPIVOT_WORKSPACE: join(root, 'workspace'), WORKPIVOT_HOST: '127.0.0.1', WORKPIVOT_INSECURE_SECRETS: '1', WORKPIVOT_EXECUTION_MODE: 'disabled' });
const auth = await import('../packages/server/src/auth.js');
const { withTenant, addTenant } = await import('../packages/server/src/tenants.js');
const { createApp } = await import('../packages/server/src/app.js');
const admin = auth.registerFirstAdmin('admin', 'admin-password');
const member = auth.createUser('member', 'member-password', 'member');
const otherAdmin = auth.createUser('other-admin', 'other-password', 'admin');
addTenant('another', 'Another');
const foreign = withTenant('another', () => auth.registerFirstAdmin('foreign', 'foreign-password'));
const oldToken = auth.loginAccount('member', 'member-password').token;
const otherToken = auth.loginAccount('other-admin', 'other-password').token;
const server = createApp().listen(0, '127.0.0.1');
await new Promise<void>((resolve) => server.once('listening', resolve));
const address = server.address(); if (!address || typeof address === 'string') throw Error('Missing port');
const base = `http://127.0.0.1:${address.port}`;
const request = (path: string, token?: string, body?: unknown, method = body === undefined ? 'GET' : 'POST'): Promise<Response> => fetch(base + '/api' + path, { method, headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
let checks = 0;
function check(value: unknown, label: string): void { assert.ok(value, label); checks++; console.log('✅ ' + label); }
try {
  const resetPath = `/users/${member.id}/reset-password`;
  check((await request(resetPath, undefined, {})).status === 401, 'guest cannot reset');
  check((await request(resetPath, oldToken, {})).status === 403, 'member cannot reset');
  check((await request(`/users/${foreign.user.id}/reset-password`, admin.token, {})).status === 404, 'foreign account hidden');
  check((await request(`/users/${admin.user.id}/reset-password`, otherToken, {})).status === 400, 'platform admin protected');
  check((await request(`/users/${otherAdmin.id}/reset-password`, otherToken, {})).status === 400, 'self reset uses current-password flow');
  const response = await request(resetPath, admin.token, {});
  const { temporaryPassword } = await response.json() as { temporaryPassword: string };
  check(response.status === 200 && temporaryPassword.length >= 24, 'random temporary password issued');
  check(response.headers.get('cache-control') === 'no-store', 'temporary password not cached');
  check((await request('/tasks', oldToken)).status === 401, 'old session revoked');
  check((await request('/auth/login', undefined, { username: 'member', password: 'member-password' })).status === 401, 'old password rejected');
  const login = await request('/auth/login', undefined, { username: 'member', password: temporaryPassword });
  const session = await login.json() as { token: string; user: { mustChangePassword: boolean } };
  check(login.ok && session.user.mustChangePassword, 'temporary login marked');
  const state = await (await request('/auth/state', session.token)).json() as { user: { mustChangePassword: boolean } };
  check(state.user.mustChangePassword, 'refresh retains required change');
  check((await request('/tasks', session.token)).status === 403, 'temporary session cannot read tasks');
  check((await request('/users', session.token)).status === 403, 'temporary session cannot access management');
  check((await request('/auth/password', session.token, { currentPassword: {}, newPassword: [] })).status === 400, 'invalid password types rejected');
  check((await request('/auth/password', session.token, { currentPassword: 'wrong', newPassword: 'new-password' })).status === 400, 'wrong current password rejected');
  check((await request('/auth/password', session.token, { currentPassword: temporaryPassword, newPassword: temporaryPassword })).status === 400, 'temporary password cannot be retained');
  check((await request('/auth/password', session.token, { currentPassword: temporaryPassword, newPassword: 'new-member-password' })).ok, 'password changed');
  check((await request('/tasks', session.token)).status === 401, 'password change revokes temporary session');
  const renewed = auth.loginAccount('member', 'new-member-password');
  check(!renewed.user.mustChangePassword && (await request('/tasks', renewed.token)).ok, 'new password unlocks account');
  check((await request('/tasks', otherToken)).ok, 'unrelated account remains logged in');
  check(!readFileSync(join(root, 'home/data/users.json'), 'utf8').includes(temporaryPassword), 'temporary password never stored as plaintext');
  const resetAgain = await (await request(resetPath, admin.token, {})).json() as { temporaryPassword: string };
  check(resetAgain.temporaryPassword !== temporaryPassword, 'repeat reset issues different password');
  check((await request('/tasks', renewed.token)).status === 401, 'repeat reset revokes renewed session');
  console.log(`W37 ${checks}/${checks} passed`);
} finally {
  server.closeAllConnections();
  await new Promise<void>((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
  rmSync(root, { recursive: true, force: true });
}
