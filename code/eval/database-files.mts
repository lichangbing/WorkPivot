import { DatabaseArtifactTools } from '../packages/server/src/database/artifact-tools.js';
import { DatabaseFileTools } from '../packages/server/src/database/file-tools.js';
import assert from 'node:assert/strict';
import { randomUUID } from 'node:crypto';
import { mkdtemp, readdir, rm, writeFile } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { join, dirname, resolve } from 'node:path';
import type { Pool } from 'pg';
import { FileRepository } from '../packages/server/src/database/files.js';
import { WorkspaceRepository } from '../packages/server/src/database/workspace.js';
import { createDatabaseApp } from '../packages/server/src/database/app.js';
import { RunRepository } from '../packages/server/src/database/runs.js';
import { ConversationRepository } from '../packages/server/src/database/conversation.js';
import {MemorySuggestions} from '../packages/server/src/database/memory-suggestions.js';
import {transaction} from '../packages/server/src/database/connection.js';

export async function testFiles(db: Pool, identity: Pool, owner: string, foreign: string, token: string, init: string, check: (ok: unknown, name: string) => void) {
  const root = await mkdtemp(join(tmpdir(), 'workpivot-files-'));
  const files = new FileRepository(db, root), workspace = new WorkspaceRepository(db);
  const task = await workspace.createTask(owner, 'file tests');
  const web = await createDatabaseApp(identity, db, init, undefined, undefined, undefined, undefined, files);
  const server = web.listen(0, '127.0.0.1'); await new Promise<void>(r => server.once('listening', r));
  const addr = server.address(); if (!addr || typeof addr === 'string') throw Error('No port');
  const base = `http://127.0.0.1:${addr.port}/api/tasks/${task.id}`;
  const fail = async (action: () => Promise<unknown>, status: number, title: string) => { await assert.rejects(action, (e: { status?: number }) => e.status === status); check(true, title); };
  try {
    const artifactTask = await workspace.createTask(owner, 'deliverables');
    const artifacts = new DatabaseArtifactTools(files);
    const saved = await artifacts.save(owner, artifactTask.id, { name: '研究报告.md', content: '# 结论\n预算100' });
    check((await files.list(owner, artifactTask.id, 'artifact'))[0]?.id === saved.id && (await files.list(owner, artifactTask.id)).length === 0, 'deliverables separate from uploaded originals');
    const updated = await artifacts.save(owner, artifactTask.id, { name: '研究报告.md', content: '# 结论\n预算200', documentId: saved.documentId, revision: 1 });
    check(updated.revision === 2 && (await files.download(owner, artifactTask.id, saved.id)).data.toString().includes('100'), 'artifact updates retain immutable prior version');
    await fail(() => artifacts.save(owner, artifactTask.id, { name: 'report.md', content: 'stale', documentId: saved.documentId, revision: 1 }), 409, 'artifact refuses stale version overwrite');
    await fail(() => files.upload(owner, artifactTask.id, 'report.md', Buffer.from('upload'), randomUUID(), saved.documentId, 2), 404, 'upload cannot overwrite a generated artifact');
    await fail(() => artifacts.save(owner, artifactTask.id, { name: 'report.docx', content: 'fake word' }), 400, 'artifact cannot disguise plain text as Word');
    await fail(() => artifacts.save(owner, artifactTask.id, { name: 'report.json', content: '{bad' }), 400, 'artifact rejects invalid JSON');
    await fail(() => artifacts.save(foreign, artifactTask.id, { name: 'report.md', content: 'foreign' }), 404, 'artifact rejects foreign task');
    await assert.rejects(artifacts.save(owner, artifactTask.id, { name: 'stopped.md', content: 'stopped' }, AbortSignal.abort())); check(true, 'cancelled artifact generation cannot publish');
    const listing = await fetch(`http://127.0.0.1:${addr.port}/api/tasks/${artifactTask.id}/artifacts`, { headers: { Authorization: 'Bearer ' + token } });
    const versionResponse = await fetch(`http://127.0.0.1:${addr.port}/api/tasks/${artifactTask.id}/files/${saved.documentId}/versions`, { headers: { Authorization: 'Bearer ' + token } });
    check(versionResponse.ok && (await versionResponse.json() as {versions: {revision:number}[]}).versions.map(v=>v.revision).join(',')==='2,1', 'artifact history API lists every version newest first');
    check(listing.ok && (await listing.json() as { artifacts: { id: string }[] }).artifacts[0]?.id === updated.id, 'artifact HTTP list exposes latest version');
    check((await fetch(`http://127.0.0.1:${addr.port}/api/tasks/${artifactTask.id}/artifacts`)).status === 401, 'artifact list requires authentication');
    await workspace.deleteTask(owner, artifactTask.id, artifactTask.revision);
    await fail(() => files.download(owner, artifactTask.id, saved.id), 404, 'task deletion revokes old artifact downloads');
    check(await files.collect(owner) === 0, '任务删除保留回收站成果版本');
    const request = randomUUID(), content = Buffer.from('中文原始资料\n金额,2026\n预算,100');
    const v1 = await files.upload(owner, task.id, '预算.csv', content, request);
    check((await files.download(owner, task.id, v1.id)).data.equals(content), 'file originals preserved byte for byte');
    const reader = new DatabaseFileTools(files);
    check((await reader.read(owner, task.id, v1.id)).content === content.toString(), 'uploaded CSV available to model text reader');
    await fail(() => reader.read(foreign, task.id, v1.id), 404, 'file reader rejects foreign owner');
    const another = await workspace.createTask(owner, 'unrelated read');
    await fail(() => reader.read(owner, another.id, v1.id), 404, 'file reader rejects another task');
    await fail(() => reader.read(owner, task.id, v1.id, -1), 400, 'file reader rejects invalid offset');
    const long = await files.upload(owner, task.id, '长文.md', Buffer.from('文'.repeat(8001)), randomUUID());
    const first = await reader.read(owner, task.id, long.id);
    check(first.content.length === 8000 && first.nextOffset === 8000 && (await reader.read(owner, task.id, long.id, first.nextOffset)).content === '文', 'file reader exposes bounded continuation without silent truncation');
    const unsupported = await files.upload(owner, task.id, 'report.pdf', Buffer.from('not a PDF'), randomUUID());
    await fail(() => reader.read(owner, task.id, unsupported.id), 415, 'unsupported file cannot masquerade as parsed text');
    const invalidText = await files.upload(owner, task.id, 'binary.txt', Buffer.from([255,254,0]), randomUUID());
    await fail(() => reader.read(owner, task.id, invalidText.id), 415, 'file reader rejects invalid text encoding');
    await files.remove(owner, task.id, long.documentId, 1);
    await fail(() => reader.read(owner, task.id, long.id), 404, 'deleted upload no longer readable by model');
    await files.remove(owner, task.id, unsupported.documentId, 1);
    await files.remove(owner, task.id, invalidText.documentId, 1);
    await files.collect(owner);

    check((await files.download(owner, task.id, v1.id.toUpperCase())).data.equals(content), 'canonical version identity resolves case-insensitive UUID input');
    await writeFile(join(root, owner, v1.id), 'corrupted');
    await fail(() => files.download(owner, task.id, v1.id), 503, 'corrupted original fails closed');
    await writeFile(join(root, owner, v1.id), content);
    check((await files.upload(owner, task.id, '预算.csv', content, request)).id === v1.id, 'upload retry does not duplicate original');
    await fail(() => files.upload(owner, task.id, '预算.csv', Buffer.from('changed'), request), 409, 'request reuse with changed file rejected');
    await fail(() => files.upload(owner, task.id, '../escape.txt', content, randomUUID()), 400, 'file path traversal rejected');
    await fail(() => files.upload(owner, task.id, 'large', Buffer.alloc(10485761), randomUUID()), 413, 'oversize file rejected');
    await fail(() => files.list(foreign, task.id), 404, 'administrator cannot list foreign files');
    await fail(() => files.download(foreign, task.id, v1.id), 404, 'foreign original download rejected');
    const concurrent = await Promise.allSettled([files.upload(owner, task.id, '预算.csv', Buffer.from('v2a'), randomUUID(), v1.documentId, 1), files.upload(owner, task.id, '预算.csv', Buffer.from('v2b'), randomUUID(), v1.documentId, 1)]);
    check(concurrent.filter(v => v.status === 'fulfilled').length === 1, 'concurrent version publication has one winner');
    check((await files.versions(owner, task.id, v1.documentId)).length === 2, 'immutable version history retained');
    check((await files.list(owner, task.id))[0]?.revision === 2, 'list selects current version only');
    check((await files.download(owner, task.id, v1.id)).data.equals(content), 'new version does not modify old original');
    await fail(() => files.remove(owner, task.id, v1.documentId, 1), 409, 'stale revision cannot delete updated file');
    const runs = new RunRepository(db), conversation = new ConversationRepository(db), sendId = randomUUID();
    const run = await runs.start(owner, task.id, sendId, '检查附件', [v1.id]);
    check((await runs.start(owner, task.id, sendId, '检查附件', [v1.id])).duplicate, 'message retry retains attachment identity');
    await fail(() => runs.start(owner, task.id, sendId, '检查附件', []), 409, 'message retry cannot change attachments');
    const page = await conversation.page(owner, task.id);
    const attached = page.turns[0]?.events[0] as unknown as { attachments: { id: string; name: string }[] };
    check(attached.attachments[0]?.id === v1.id && attached.attachments[0]?.name === '预算.csv', 'history restores pinned attachment version and filename');
    check((await runs.history(owner, run))[0]?.content?.includes('尚无可用解析内容'), 'model informed attachments are not parsed');
    await runs.finish(owner, run, 'completed', []);
    await fail(() => runs.start(owner, task.id, randomUUID(), 'missing', [randomUUID()]), 404, 'missing attachments cannot create run');
    await fail(() => runs.start(owner, task.id, randomUUID(), 'duplicate', [v1.id, v1.id]), 400, 'duplicate attachments rejected');
    const unrelated = await workspace.createTask(owner, 'unrelated attachments');
    await fail(() => runs.start(owner, unrelated.id, randomUUID(), 'foreign task', [v1.id]), 404, 'same owner cannot attach files from another task');
    await workspace.deleteTask(owner, unrelated.id, unrelated.revision);
    const orphan = randomUUID(); await writeFile(join(root, owner, orphan), 'uncommitted');
    check(await files.collect(owner) === 1 && (await readdir(join(root, owner))).length === 7, '清理孤儿文件同时保留在线及回收站原件');
    const response = await fetch(base + '/files?name=report.pdf&requestId=' + randomUUID(), { method: 'POST', headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/octet-stream' }, body: Buffer.from('%PDF-fixture') });
    check(response.ok, 'authenticated binary upload endpoint works');
    const httpFile = (await response.json() as { file: { id: string; documentId: string; revision: number } }).file;
    const download = await fetch(base + '/file-versions/' + httpFile.id, { headers: { Authorization: 'Bearer ' + token } });
    check((await download.text()) === '%PDF-fixture' && download.headers.get('content-disposition')?.startsWith('attachment') && download.headers.get('x-content-type-options') === 'nosniff', 'download is an attachment, never inline executable content');
    check((await fetch(base + '/file-versions/' + httpFile.id)).status === 401, 'file download requires authentication');
    const attachedRun = await runs.start(owner, task.id, randomUUID(), 'PDF附件', [httpFile.id]);
    await runs.finish(owner, attachedRun, 'completed', []);
    const memorySuggestions=new MemorySuggestions(db);
    const proposal=await memorySuggestions.propose(owner,task.id,await memorySuggestions.epoch(owner),'user','附件中的衍生记忆',undefined,undefined,{runId:attachedRun.id,evidence:'PDF附件'});
    await memorySuggestions.decide(owner,proposal.id,true);
    const derivedId=await transaction(db,async c=>(await c.query('SELECT memory_id FROM workpivot.memory_sources WHERE run_id=$1',[attachedRun.id])).rows[0].memory_id,owner);
    const deleted = await fetch(base + '/files/' + httpFile.documentId, { method: 'DELETE', headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' }, body: JSON.stringify({ revision: httpFile.revision }) });
    check(deleted.ok && !(await deleted.json() as { cleanupPending: boolean }).cleanupPending, '文件移入回收站且清理不误删原件');
    check(await transaction(db,async c=>(await c.query('SELECT count(*) FROM workpivot.memory_revisions WHERE memory_id=$1',[derivedId])).rows[0].count==='0',owner),'file deletion purges derived memory revision text');
    check(await transaction(db,async c=>(await c.query('SELECT content,evidence FROM workpivot.memory_suggestions WHERE id=$1',[proposal.id])).rows.every(s=>!s.content&&!s.evidence),owner),'file deletion clears accepted suggestion evidence and text');
    await fail(() => files.download(owner, task.id, httpFile.id), 404, 'deleted file cannot be downloaded');
    const afterDelete = await conversation.page(owner, task.id);
    const deletedAttachment = afterDelete.turns.flatMap(t => t.events).find(e => e.runId === attachedRun.id) as unknown as { attachments: { name: string | null; deleted: boolean }[] };
    check(deletedAttachment.attachments[0]?.deleted && deletedAttachment.attachments[0]?.name === null, 'history redacts filename after attachment deletion');
    await fail(() => runs.start(owner, task.id, randomUUID(), '已删除附件', [httpFile.id]), 404, 'deleted attachment cannot be reused in new message');
    const linkedRun = await runs.start(owner, task.id, randomUUID(), '再次附带', [v1.id]);
    check(!(await runs.history(owner, linkedRun)).some(m => String(m.content).includes('PDF附件')), 'file deletion revokes prior task model context');
    check((await reader.read(owner, task.id, v1.id)).content === content.toString(), 'file reader uses pinned old version after newer upload');
    await runs.finish(owner, linkedRun, 'completed', []);
    await workspace.deleteTask(owner, task.id, (await workspace.listTasks(owner)).find(t => t.id === task.id)!.revision);
    check(await files.collect(owner) === 0, '任务删除保留所有回收站文件版本');
    check((await readdir(join(root, owner))).length === 8, '回收站磁盘原件完整保留');
    await fail(() => files.upload(owner, task.id, 'late', content, randomUUID()), 404, 'deleted task rejects late upload');
    check(await files.collect(owner) === 0, 'repeated physical cleanup is idempotent');
    const project = await workspace.createProject(owner, 'file project deletion');
    const child = await workspace.createTask(owner, 'file child', project.id);
    const childFile = await files.upload(owner, child.id, 'child.txt', content, randomUUID());
    await workspace.deleteProject(owner, project.id, project.revision);
    await fail(() => files.download(owner, child.id, childFile.id), 404, 'project deletion immediately revokes file access');
    check(await files.collect(owner) === 0, '项目删除保留子资料回收站原件');
  } finally {
    server.closeAllConnections(); await new Promise<void>(r => server.close(() => r()));
    if (dirname(root) !== resolve(tmpdir()) || !root.includes('workpivot-files-')) throw Error('Unexpected test cleanup path');
    await rm(root, { recursive: true, force: true });
  }
}
