import {SkillBuilds} from '../packages/server/src/database/skill-builds.js';
import {Automations} from '../packages/server/src/database/automations.js';
import {authorizeTools} from '../packages/server/src/database/tool-authorization.js';
import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {mkdtemp,rm} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import type {Pool} from 'pg';
import {FileRepository} from '../packages/server/src/database/files.js';
import {DatabaseArtifactTools} from '../packages/server/src/database/artifact-tools.js';
import {DatabaseFileTools} from '../packages/server/src/database/file-tools.js';
import {WorkspaceRepository} from '../packages/server/src/database/workspace.js';
import {RunRepository} from '../packages/server/src/database/runs.js';
import {transaction} from '../packages/server/src/database/connection.js';
import {KnowledgeRepository} from '../packages/server/src/database/knowledge.js';
import {parserFingerprint} from '../packages/server/src/database/document-parser.js';
import {confirmKnowledgeForTest} from './knowledge-fixture.mts';
export async function testResourceScope(db:Pool,actor:string,foreign:string,check:(ok:unknown,label:string)=>void){
 const root=await mkdtemp(join(tmpdir(),'wp-scope-')),files=new FileRepository(db,root),tasks=new WorkspaceRepository(db),runs=new RunRepository(db),knowledge=new KnowledgeRepository(db);
 const task=await tasks.createTask(actor,'读取范围隔离验收'),other=await tasks.createTask(actor,'同用户其他任务');
 const project=await tasks.createProject(actor,'固定范围项目');
 try{
  await transaction(db,c=>c.query('UPDATE workpivot.tasks SET project_id=$2 WHERE id=ANY($1::uuid[])',[[task.id,other.id],project.id]),actor);
  const a=await files.upload(actor,task.id,'A.txt',Buffer.from('A旧版本'),randomUUID());
  const a2=await files.upload(actor,task.id,'A.txt',Buffer.from('A新版本'),randomUUID(),a.documentId,1);
  const b=await files.upload(actor,task.id,'B.pdf',Buffer.from('B'),randomUUID());
  const outside=await files.upload(actor,other.id,'其他任务.txt',Buffer.from('其他任务'),randomUUID());
  const listed=await files.list(actor,task.id,'upload',[a.id]);
  check(listed.length===1&&listed[0]!.id===a.id,'列表仅返回授权旧版本，不自动替换为最新版本');
  check((await files.list(actor,task.id,'upload',[])).length===0,'空文件范围不回退到全部附件');
  const reader=new DatabaseFileTools(files,undefined,[a.id]);
  check((await reader.read(actor,task.id,a.id)).content==='A旧版本','读取固定版本原件');
  await assert.rejects(reader.read(actor,task.id,a2.id));await assert.rejects(reader.read(actor,task.id,b.id));check(true,'同任务未选文件和新版均拒绝');
  const publish=async(id:string,text:string)=>{await transaction(db,async c=>{await c.query("INSERT INTO workpivot.document_processing(version_id,owner_user_id,status,parts,parser_fingerprint) VALUES($1,$2,'completed',$3,$4) ON CONFLICT(version_id) DO UPDATE SET status='completed',parts=$3,parser_fingerprint=$4",[id,actor,JSON.stringify([{location:'page:1',text}]),parserFingerprint]);},actor);await confirmKnowledgeForTest(db,actor,task.id,id);await knowledge.indexNext(actor);};
  await publish(a.id,'授权关键词 旧版本');await publish(a2.id,'授权关键词 新版本');await publish(b.id,'授权关键词 不可见');
  const found=await knowledge.search(actor,task.id,'授权关键词',undefined,[a.id]);
  check(found.matches.length===1&&found.matches[0]!.versionId===a.id,'关键词在排序前按固定版本限定，旧版本可检索');
  check((await knowledge.search(actor,task.id,'授权关键词',undefined,[])).matches.length===0,'空范围检索零结果');
  const bHit=(await knowledge.search(actor,task.id,'不可见')).matches.find(r=>r.versionId===b.id)!;
  await assert.rejects(knowledge.read(actor,task.id,bHit.chunkId,[a.id]));check(true,'猜测引用ID不能回读未授权正文');
  const scope=await runs.resources(actor,task.id,{versionIds:[a.id,b.id],memoryScopes:[],expert:false});
  const first=await runs.start(actor,task.id,randomUUID(),'首轮',[a.id],scope);
  await runs.finish(actor,first,'completed',[{role:'assistant',content:'旧范围B的敏感摘要'}]);
  const inherited=await runs.resources(actor,task.id);
  check(inherited.epoch===scope.epoch&&inherited.versionIds.includes(b.id),'后续消息继承已确认范围及历史代次');
  const second=await runs.start(actor,task.id,randomUUID(),'继续',[],inherited);
  check(JSON.stringify(await runs.history(actor,second)).includes('旧范围B的敏感摘要'),'同范围连续对话保留历史');
  await runs.finish(actor,second,'completed',[]);
  const narrow=await runs.resources(actor,task.id,{versionIds:[a.id],memoryScopes:[],expert:false});
  check(narrow.epoch!==scope.epoch,'缩小范围生成新的上下文代次');
  const third=await runs.start(actor,task.id,randomUUID(),'仅看A',[],narrow);
  check(!JSON.stringify(await runs.history(actor,third)).includes('旧范围B'),'缩小范围后旧模型消息不再进入上下文');
  await assert.rejects(runs.checkResources(actor,third,narrow,{inputs:[b.id]}));check(true,'隔离执行输入不能扩大到未选文件');
  await assert.rejects(runs.checkResources(foreign,third,narrow));check(true,'其他账号不能使用运行范围');
  const revoked=await transaction(db,async c=>(await c.query('SELECT context_revoked,model_messages FROM workpivot.task_runs WHERE id=$1',[first.id])).rows[0],actor);
  check(revoked.context_revoked&&revoked.model_messages.length===0,'缩小范围同时撤销旧后台来源并清空模型历史');
  await assert.rejects(runs.resources(actor,task.id,{...narrow,baseRunId:first.id}));check(true,'旧页面范围快照不能覆盖新轮次');
  await runs.stop(actor,task.id);await assert.rejects(runs.checkResources(actor,third,narrow));check(true,'停止后读取范围失效');await runs.finish(actor,third,'aborted',[]);
  const projectScope=await runs.resources(actor,task.id,{versionIds:[outside.id],memoryScopes:[],expert:false});
  check(projectScope.versionIds.includes(outside.id)&&(await files.download(actor,task.id,outside.id,[outside.id])).data.toString()==='其他任务','同项目明确选择的固定版本可以读取');
  await assert.rejects(files.download(actor,task.id,outside.id,[]));check(true,'同项目未选择版本仍不可读取');
  await transaction(db,c=>c.query('UPDATE workpivot.tasks SET project_id=NULL WHERE id=$1',[other.id]),actor);
  await assert.rejects(runs.resources(actor,task.id,{versionIds:[outside.id],memoryScopes:[],expert:false}));check(true,'跨项目版本不能加入当前范围');
  await assert.rejects(runs.resources(actor,task.id,null));check(true,'空策略对象不能请求旧宽泛模式');
  const request=randomUUID(),original={versionIds:[a.id],memoryScopes:[],expert:false};
  const generatedScope=await runs.resources(actor,task.id,original,[],request);
  const generatedRun=await runs.start(actor,task.id,request,'生成成果',[],generatedScope);
  const builds=new SkillBuilds(db,files);
  await builds.propose(actor,task.id,{requestId:randomUUID(),displayName:'范围草稿',purpose:'合成草稿摘要',files:[{path:'SKILL.md',content:'---\nname: scope-fixture\ndescription: 合成范围验收\n---\n# 步骤\n仅做合成验收。\n'}]},generatedRun);
  check((await builds.list(actor,task.id,true)).length===1,'当前有效来源的Skill草稿摘要可见');
  const planId=randomUUID();
  await transaction(db,c=>c.query("INSERT INTO workpivot.automations(id,owner_user_id,draft,request_id,source_task_id,source_run_id) VALUES($1,$2,$3,$4,$5,$6)",[planId,actor,{name:'范围验收计划',requirements:'未选择不可见的合成要求'},randomUUID(),task.id,generatedRun.id]),actor);
  const plans=new Automations(db),planTools=plans.tools(actor,task.id,()=>generatedRun,generatedScope);
  check(JSON.parse(await planTools.find(t=>t.name==='list_my_schedules')!.run({},{taskDir:'.'})).length===0,'未选自动化不向模型暴露配置摘要');
  await assert.rejects(planTools.find(t=>t.name==='get_schedule_run')!.run({id:planId},{taskDir:'.'}));check(true,'猜测自动化ID不能读取配置和日志');
  await runs.grantSchedule(actor,generatedRun,generatedScope,planId);
  check(JSON.parse(await planTools.find(t=>t.name==='list_my_schedules')!.run({},{taskDir:'.'})).length===1,'本轮新建草稿加入范围后可继续查看');
  const options=await plans.options(actor,generatedScope,task.id);
  check(options.files.every(f=>generatedScope.versionIds.includes(f.id))&&options.projects.every(p=>p.id===project.id),'自动化选项仅提供授权文件及当前项目');
  const artifact=await files.upload(actor,task.id,'结果.txt',Buffer.from('测试成果'),randomUUID(),undefined,undefined,'artifact');
  await runs.append(actor,generatedRun,{type:'tool_use',toolName:'browser_visit',callId:'audit-fixture',args:{url:'https://fixture.example/?secret=SYNTHETIC_SECRET',text:'PRIVATE_SAMPLE'},displayName:'PRIVATE_SAMPLE'});
  await runs.append(actor,generatedRun,{type:'tool_result',toolName:'browser_visit',callId:'audit-fixture',ok:true,message:'PRIVATE_SAMPLE'});
  const events=await transaction(db,async c=>(await c.query("SELECT content FROM workpivot.conversation_events WHERE run_id=$1 AND kind IN ('tool_use','tool_result')",[generatedRun.id])).rows,actor);
  check(events.length===2&&!JSON.stringify(events).includes('PRIVATE_SAMPLE')&&!JSON.stringify(events).includes('SYNTHETIC_SECRET'),'持久工具事件不复制完整参数、URL查询和返回正文');
  await runs.checkResources(actor,generatedRun,generatedScope,{inputs:[a.id],outputs:['preview.txt']});check(true,'Skill试运行文件名输出列表不误判为成果更新对象');
  const reference=generatedScope.versionIds;
  await runs.grantArtifacts(actor,generatedRun,generatedScope,[artifact.id]);
  await runs.checkResources(actor,generatedRun,generatedScope,{versionId:artifact.id});
  check(reference===generatedScope.versionIds&&reference.includes(artifact.id),'生成成果加入当前范围且读取工具闭包同步');
  await assert.rejects(runs.grantArtifacts(actor,generatedRun,{...generatedScope,expert:true},[artifact.id]));check(true,'过期或篡改范围不能用于成果授权');
  const retryScope=await runs.resources(actor,task.id,undefined,[],request);
  const retry=await runs.start(actor,task.id,request,'生成成果',[],retryScope);
  check(retry.duplicate&&retry.id===generatedRun.id,'生成成果后原始请求重试仍幂等');
  await assert.rejects(runs.resources(actor,task.id,{...original,expert:true},[],request));check(true,'同请求ID不能改动原始范围');
  const guardedSaver=new DatabaseArtifactTools(files,generatedScope.versionIds,async(c,args)=>{await runs.checkResourcesInTransaction(c,generatedRun,generatedScope,args);await runs.checkToolPermission(c,generatedRun,['save_artifact'],args);});
  await assert.rejects(guardedSaver.save(actor,task.id,{name:'未审批.txt',content:'不能发布'}));check(true,'绕过工具入口直接调用受保护业务服务被拒绝');
  const protectedTool=authorizeTools(guardedSaver.tools(actor,task.id)).find(t=>t.name==='save_artifact')!;
  await assert.rejects(protectedTool.run({name:'虚假审批.txt',content:'不能发布'},{taskDir:'.',requestAccess:async()=>true}));check(true,'仅返回true而没有持久审批不能发布成果');
  const protectedResult=await protectedTool.run({name:'事务授权.txt',content:'合法成果'},{taskDir:'.',requestAccess:async request=>{const permission=await runs.requestPermission(actor,generatedRun,request);await runs.decidePermission(actor,task.id,permission.id,'allow');return await runs.consumePermission(actor,generatedRun,permission.id,request)==='allow';}});
  check(JSON.parse(protectedResult).name==='事务授权.txt','审批完整参数脱敏后业务发布仍可验证调用摘要');
  const switched=authorizeTools([{...guardedSaver.tools(actor,task.id).find(t=>t.name==='save_artifact')!,run:async()=>JSON.stringify(await guardedSaver.save(actor,task.id,{name:'偷换目标.txt',content:'未经批准'}))}])[0]!;
  await assert.rejects(switched.run({name:'获批目标.txt',content:'合成测试'},{taskDir:'.',requestAccess:async request=>{const p=await runs.requestPermission(actor,generatedRun,request);await runs.decidePermission(actor,task.id,p.id,'allow');return await runs.consumePermission(actor,generatedRun,p.id,request)==='allow';}}));check(true,'业务服务拒绝同一调用内部偷换实际写入参数');

  const saver=new DatabaseArtifactTools(files,generatedScope.versionIds,(c,args)=>runs.checkResourcesInTransaction(c,generatedRun,generatedScope,args));
  const hidden=await files.upload(actor,task.id,'未选择成果.txt',Buffer.from('不能覆盖'),randomUUID(),undefined,undefined,'artifact');
  await assert.rejects(saver.save(actor,task.id,{name:'未选择成果.txt',content:'错误更新',documentId:hidden.documentId,revision:1}));
  check((await files.versions(actor,task.id,hidden.documentId)).length===1,'直接进入成果服务也不能更新未选成果，数据库无新版本');
  const updated=await saver.save(actor,task.id,{name:'结果.txt',content:'合法更新',documentId:artifact.documentId,revision:1});
  check(updated.revision===2,'授权范围中的固定成果允许正常更新');
  await runs.checkResources(actor,generatedRun,generatedScope,{documentId:artifact.documentId,revision:1});
  await assert.rejects(saver.save(actor,task.id,{name:'结果.txt',content:'覆盖新版',documentId:artifact.documentId,revision:1}));
  check((await files.versions(actor,task.id,artifact.documentId)).length===2,'并发版本变化仍由发布事务拒绝');
  const staleSaver=new DatabaseArtifactTools(files,generatedScope.versionIds,(c,args)=>runs.checkResourcesInTransaction(c,generatedRun,{...generatedScope,epoch:randomUUID()},args));
  const before=(await files.list(actor,task.id,'artifact')).length;
  await assert.rejects(staleSaver.save(actor,task.id,{name:'不应发布.txt',content:'拒绝'}));
  check((await files.list(actor,task.id,'artifact')).length===before,'发布事务拒绝失效范围且不新增成果');
  let gateCalls=0;
  await assert.rejects(files.upload(actor,task.id,'提交前失效.txt',Buffer.from('测试'),randomUUID(),undefined,undefined,'artifact',undefined,async()=>{if(++gateCalls===2)throw Error('模拟写入后租约失效');}));
  check(gateCalls===2&&(await files.list(actor,task.id,'artifact')).length===before,'写入后最终校验失败，单文件数据库发布回滚');
  gateCalls=0;
  await assert.rejects(files.uploadArtifacts(actor,task.id,[{name:'一.txt',data:Buffer.from('一')},{name:'二.txt',data:Buffer.from('二')}],undefined,async()=>{if(++gateCalls===2)throw Error('模拟提交前失效');}));
  check(gateCalls===2&&(await files.list(actor,task.id,'artifact')).length===before,'多成果最终校验失败，整批发布回滚');
  await runs.stop(actor,task.id);
  await assert.rejects(saver.save(actor,task.id,{name:'迟到成果.txt',content:'拒绝'}));
  check((await files.list(actor,task.id,'artifact')).length===before,'停止后直接调用成果服务也不能迟到发布');
  await runs.finish(actor,generatedRun,'completed',[]);
  check((await runs.resources(actor,task.id)).versionIds.includes(artifact.id),'下轮自动继承本轮生成成果');
  await transaction(db,c=>c.query("UPDATE workpivot.task_runs SET created_at=now()-interval '31 days',finished_at=now()-interval '31 days' WHERE task_id=$1",[task.id]),actor);
  await runs.cleanupContext(actor);
  const retained=await transaction(db,async c=>(await c.query("SELECT count(*)::int AS n FROM workpivot.task_runs WHERE task_id=$1 AND (NOT context_revoked OR model_messages<>'[]'::jsonb)",[task.id])).rows[0].n,actor);
  check((await builds.list(actor,task.id,true)).length===0,'来源上下文撤销后不向模型返回Skill草稿摘要');
  check(retained===0&&(await files.download(actor,task.id,a.id)).data.length>0,'闲置30天清理模型内部上下文但保留用户文件');
  check((await transaction(db,c=>c.query("SELECT 1 FROM workpivot.conversation_events WHERE task_id=$1 AND kind='user'",[task.id]),actor)).rowCount!>0,'上下文过期不删除用户聊天记录');
  const empty=await runs.resources(actor,task.id,{versionIds:[],memoryScopes:[],expert:false});check(empty.versionIds.length===0&&empty.epoch!==narrow.epoch,'撤销全部范围不会自动继承旧附件');
 }finally{
  for(const id of [task.id,other.id]){const row=(await tasks.listTasks(actor)).find(t=>t.id===id);if(row)await tasks.deleteTask(actor,id,row.revision);}
  await tasks.deleteProject(actor,project.id,project.revision);
  await rm(root,{recursive:true,force:true});
 }
}
