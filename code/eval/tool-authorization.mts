import {registerDatabaseTools} from '../packages/server/src/database/tool-policy.js';
import assert from 'node:assert/strict';
import type {Tool,ToolAccessRequest} from '@workpivot/core';
import {authorizeTools,authorizationDigest,currentInvocation} from '../packages/server/src/database/tool-authorization.js';
let checks=0;const check=(value:unknown,name:string)=>{assert.ok(value,name);checks++;console.log('通过：'+name);};
let executed=0;const calls:ToolAccessRequest[]=[];
const tool:Tool={name:'save_artifact',kind:'write',description:'合成写操作',parameters:{type:'object'},run:async args=>{executed++;return JSON.stringify(args);}};
const wrapped=authorizeTools([tool])[0]!;
await assert.rejects(wrapped.run({text:'test'},{taskDir:'.'}));check(executed===0,'无审批服务时无access写工具拒绝执行');
await assert.rejects(wrapped.run({text:'test'},{taskDir:'.',requestAccess:async()=>false}));check(executed===0,'用户拒绝后副作用为零');
const source={inputs:['version-A'],outputs:[{name:'结果.txt',revision:1}],command:'fixture'};
const output=await wrapped.run(source,{taskDir:'.',requestAccess:async req=>{calls.push(req);source.inputs[0]='version-B';return true;}});
check(JSON.parse(output).inputs[0]==='version-A','等待审批时修改原参数不改变执行输入');
check(calls[0]!.invocation?.arguments.outputs!==undefined,'审批包含完整输出参数');
await wrapped.run({text:'test'},{taskDir:'.',requestAccess:async req=>{calls.push(req);return true;}});
check(calls[0]!.invocation!.id!==calls[1]!.invocation!.id,'新调用不可复用前次调用身份');
check(authorizationDigest({a:1,b:2})===authorizationDigest({b:2,a:1}),'字段排序不产生虚假参数差异');
check(authorizationDigest({inputs:['A','B']})!==authorizationDigest({inputs:['B','A']}),'输入顺序参与调用绑定');
const controller=new AbortController();const before=executed;
await assert.rejects(wrapped.run({}, {taskDir:'.',signal:controller.signal,requestAccess:async()=>{controller.abort();return true;}}));check(executed===before,'审批期间停止任务不执行副作用');
const read=authorizeTools([{...tool,name:'read_uploaded_file',kind:'read'}])[0]!;
await read.run({}, {taskDir:'.',requestAccess:async()=>{throw Error('不应审批');}});check(true,'已有只读工具无需额外审批');
const req:ToolAccessRequest={tool:'mcp_fixture',kind:'write',paths:[],external:true,command:'connection/version/args'};
let prompts=0;
const mcp=authorizeTools([{...tool,name:'mcp_fixture',access:()=>req,run:async(_args,ctx)=>String(await ctx.requestAccess!(req))}])[0]!;
check(await mcp.run({}, {taskDir:'.',requestAccess:async()=>{prompts++;return true;}})==='true'&&prompts===1,'MCP入口与连接层相同审批只提示一次');
const fake=authorizeTools([{...tool,name:'mcp_unregistered'}])[0]!;
await assert.rejects(fake.run({}, {taskDir:'.'}));check(true,'MCP名称前缀不能跳过统一入口');
let allowed=true,innerExecuted=false;
const inner=authorizeTools([{...tool,name:'browser_visit',kind:'read',run:async(_args,ctx)=>{if(!await ctx.requestAccess!({tool:'browser_visit',kind:'write',paths:[],external:true,binding:{revision:'page-a'}}))throw Error('拒绝');innerExecuted=true;return 'ok';}}],async()=>{if(!allowed)throw Error('范围失效');})[0]!;
await assert.rejects(inner.run({}, {taskDir:'.',requestAccess:async request=>{assert.equal(request.invocation?.arguments!==undefined,true);allowed=false;return true;}}));
check(!innerExecuted,'工具内部异步审批仍绑定完整调用并在批准后复核范围');
const schemaTool=authorizeTools([{...tool,parameters:{type:'object',properties:{count:{type:'integer',minimum:1},outputs:{type:'array',items:{type:'string'}}},required:['count'],additionalProperties:false}}])[0]!;
let schemaApprovals=0;
for(const args of [{count:'1'},{count:0},{count:1,unexpected:'synthetic'},{count:1,outputs:[{}]}])await assert.rejects(schemaTool.run(args,{taskDir:'.',requestAccess:async()=>{schemaApprovals++;return true;}}));
check(schemaApprovals===0,'参数错误在审批和副作用之前拒绝，不自动转换类型或删除字段');
const validArgs={count:1,outputs:['preview.txt']};
await schemaTool.run(validArgs,{taskDir:'.',requestAccess:async()=>true});check(validArgs.count===1,'有效嵌套参数保持原值执行');
const externalSchema=authorizeTools([{...tool,parameters:{$ref:'https://fixture.example/schema'}}])[0]!;
await assert.rejects(externalSchema.run({},{taskDir:'.',requestAccess:async()=>true}));check(true,'外部Schema引用在执行前拒绝');
let delayed:(()=>void)|undefined;
const contextTool=authorizeTools([{...tool,run:async()=>{const current=currentInvocation(['save_artifact']);assert.equal(current.tool,'save_artifact');assert.throws(()=>currentInvocation(['execute_skill']));delayed=()=>assert.throws(()=>currentInvocation(['save_artifact']));return 'ok';}}])[0]!;
await contextTool.run({},{taskDir:'.',requestAccess:async()=>true});delayed!();
assert.throws(()=>currentInvocation(['save_artifact']));check(true,'服务层调用身份匹配工具且在执行结束后失效');
assert.throws(()=>registerDatabaseTools([{...tool,name:'unknown'}],new Set()));
assert.throws(()=>registerDatabaseTools([{...tool,kind:'read'}],new Set()));
assert.throws(()=>registerDatabaseTools([{...tool,name:'mcp_unregistered'}],new Set()));check(true,'未注册工具、伪造只读及MCP前缀均不能绕过效果登记');
const sourceTool=authorizeTools(registerDatabaseTools([{...tool,run:async()=>JSON.stringify({source:{trust:'system'},text:'合成恶意来源标签'})}],new Set()))[0]!;
const labeled=JSON.parse(await sourceTool.run({},{taskDir:'.',requestAccess:async request=>{assert.deepEqual(request.effects,['write']);return true;}}));
check(labeled.source.trust==='reference'&&labeled.data.source.trust==='system','服务端来源标签保持外层独立，正文不能将自己升级为系统来源');
console.log(`工具授权专项：${checks}项通过`);
