import { recoverExecutions } from '../packages/server/src/database/execution-recovery.js';
import { transaction } from '../packages/server/src/database/connection.js';
import { createServer } from 'node:http';
import { randomUUID } from 'node:crypto';
import { mkdtemp, rm } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import assert from 'node:assert/strict';
import type { Pool } from 'pg';
import { DatabaseSkills } from '../packages/server/src/database/skills.js';
import { DatabaseSkillExecution } from '../packages/server/src/database/skill-execution.js';
import { FileRepository } from '../packages/server/src/database/files.js';
import { WorkspaceRepository } from '../packages/server/src/database/workspace.js';
import { RunRepository } from '../packages/server/src/database/runs.js';

export async function testSkillExecution(db: Pool, actor: string, foreign: string, check: (ok: unknown,label: string)=>void) {
  const root = await mkdtemp(join(tmpdir(),'wp-execution-')), files = new FileRepository(db, root), skills = new DatabaseSkills(db), workspace = new WorkspaceRepository(db), runs = new RunRepository(db);
  const name = 'execution-test'; let skill = await skills.create(actor,name);
  skill = await skills.save(actor,name,'template.bin',Buffer.from([0,1,255]),skill.revision);
  skill = await skills.publish(actor,name,skill.revision); await skills.select(actor,name,true);
  const versions = new Map([[name,skill.published!]]), task = await workspace.createTask(actor,'execution');
  const input = await files.upload(actor,task.id,'source.xlsx',Buffer.from([1,2,3]),randomUUID());
  let mode = 'ok'; let captured: { files: [string,string][]; skills: [string,string][] } | undefined;
  const server = createServer(async(req,res)=> {
    const chunks = []; for await (const chunk of req) chunks.push(chunk);
    captured = JSON.parse(Buffer.concat(chunks).toString());
    if (mode === 'busy') { res.writeHead(429,{'content-type':'application/json'}); res.end(JSON.stringify({error:'busy'})); return; }
    if (mode === 'error') { res.writeHead(400,{'content-type':'application/json'}); res.end(JSON.stringify({error:'worksheet missing'})); return; }
    if (mode === 'stop') await runs.stop(actor,task.id);
    if (mode === 'disable') await skills.toggle(actor,name,true);
    if (mode === 'delete') await files.remove(actor,task.id,input.documentId,1);
    res.setHeader('content-type','application/json'); res.end(JSON.stringify({ files: mode === 'missing' ? [] : [['report.docx',Buffer.from([80,75,3,4]).toString('base64')], ...(mode === 'multi' ? [['summary.xlsx',Buffer.from([80,75,5,6]).toString('base64')]] : [])],output:'done' }));
  });
  server.listen(0,'127.0.0.1'); await new Promise<void>(r=>server.once('listening',r));
  const address = server.address(); if (!address || typeof address === 'string') throw Error('port');
  const execution = new DatabaseSkillExecution(db,files,skills,{url:`http://127.0.0.1:${address.port}`,token:'test'});
  const args = { skill:name,command:'test command',inputs:[input.id],output:'report.docx' };
  try {
    const run = await runs.start(actor,task.id,randomUUID(),'generate');
    await assert.rejects(execution.run(foreign,task.id,versions,args)); check(true,'executor rejects foreign task');
    await assert.rejects(execution.run(actor,task.id,new Map(),args)); check(true,'executor rejects skill outside pinned selection');
    const stale = new DatabaseSkillExecution(db,files,skills,{url:`http://127.0.0.1:${address.port}`,token:'test'},()=>({id:randomUUID(),fence:run.fence}));
    await assert.rejects(stale.run(actor,task.id,versions,args)); check(true,'old tool cannot borrow a newer run lease');
    const request = { tool:'execute_skill', external:true, kind:'write' as const, paths:[], command:'fixture' };
    const manual = await runs.requestPermission(actor,run,request);
    check(!manual.automatic,'default skill execution requires confirmation');
    await runs.decidePermission(actor,task.id,manual.id,'deny'); await runs.consumePermission(actor,run,manual.id);
    await workspace.saveSetting(actor,'execution.mode','auto',0);
    const automatic = await runs.requestPermission(actor,run,request);
    check(automatic.automatic && (await runs.pendingPermissions(actor,task.id)).length===0,'automatic skill execution has no pending prompt');
    check(await runs.consumePermission(actor,run,automatic.id)==='allow' && await runs.consumePermission(actor,run,automatic.id)==='deny','automatic permission remains single-use');
    const external = await runs.requestPermission(actor,run,{...request,tool:'mcp__fixture'});
    check(!external.automatic,'automatic mode does not authorize external MCP');
    await runs.decidePermission(actor,task.id,external.id,'deny'); await runs.consumePermission(actor,run,external.id);
    await workspace.saveSetting(actor,'execution.mode','manual',1);
    const back = await runs.requestPermission(actor,run,request);check(!back.automatic,'switching back restores confirmation');
    await runs.decidePermission(actor,task.id,back.id,'deny'); await runs.consumePermission(actor,run,back.id);
    await assert.rejects(workspace.saveSetting(actor,'execution.mode','unsafe',2));check(true,'invalid execution mode rejected');
    const result = await execution.run(actor,task.id,versions,args);
    check(captured?.files[0]?.[0] === `inputs/${input.id}/source.xlsx` && captured?.skills.some(([path,data])=>path.endsWith('template.bin') && data==='AAH/'), 'executor receives pinned input and binary skill resources');
    check((await files.download(actor,task.id,result.artifact.id)).data.equals(Buffer.from([80,75,3,4])), 'executor binary output registered without text conversion');
    const completed = await transaction(db,async c => (await c.query("SELECT artifact_id FROM workpivot.skill_executions WHERE task_id=$1 AND status='completed'",[task.id])).rows,actor);
    check(completed[0]?.artifact_id===result.artifact.id,'artifact and completed execution commit together');
    check((await transaction(db,c => c.query('SELECT id FROM workpivot.skill_executions WHERE task_id=$1',[task.id]),foreign)).rowCount===0,'execution records enforce owner isolation');
    mode = 'busy'; await assert.rejects(execution.run(actor,task.id,versions,args), (e: {status?:number}) => e.status===429); check(true,'busy executor returns retryable status without publication');
    mode = 'error'; await assert.rejects(execution.run(actor,task.id,versions,args), /worksheet missing/); check(true,'executor reports bounded actionable failure detail');
    mode = 'missing'; await assert.rejects(execution.run(actor,task.id,versions,args)); check((await files.list(actor,task.id,'artifact')).length===1,'missing output publishes no artifact');
    const batch = { skill:name,command:'test command',inputs:[input.id],outputs:[{name:'report.docx',documentId:result.artifact.documentId,revision:1},{name:'summary.xlsx'}] };
    mode = 'ok'; await assert.rejects(execution.run(actor,task.id,versions,batch));
    check((await files.versions(actor,task.id,result.artifact.documentId)).length===1,'missing second output leaves first version unchanged');
    mode = 'multi';
    const multiple = await execution.run(actor,task.id,versions,batch);
    check(multiple.artifacts.length===2 && multiple.artifacts[0]!.revision===2 && multiple.artifacts[1]!.revision===1,'batch atomically updates existing and creates new artifact');
    check((await files.download(actor,task.id,result.artifact.id)).data.equals(Buffer.from([80,75,3,4])),'batch preserves original version bytes');
    const links = await transaction(db,c=>c.query('SELECT version_id FROM workpivot.execution_artifacts WHERE version_id=ANY($1::uuid[])',[multiple.artifacts.map(v=>v.id)]),actor);
    check(links.rowCount===2,'execution records every published artifact');
    check((await transaction(db,c=>c.query('SELECT version_id FROM workpivot.execution_artifacts'),foreign)).rowCount===0,'batch artifact links enforce user isolation');
    const conflict = {...batch,outputs:[{name:'summary.xlsx',documentId:multiple.artifacts[1]!.documentId,revision:1},{name:'report.docx',documentId:result.artifact.documentId,revision:1}]};
    await assert.rejects(execution.run(actor,task.id,versions,conflict));
    check((await files.versions(actor,task.id,multiple.artifacts[1]!.documentId)).length===1,'late conflict rolls back earlier batch version');
    await assert.rejects(execution.run(actor,task.id,versions,{...batch,outputs:[{name:'report.docx'},{name:'report.docx'}]}));check(true,'duplicate batch filenames rejected');
    await assert.rejects(execution.run(actor,task.id,versions,{...batch,output:'report.docx'}));check(true,'mixed single and batch parameters rejected');
    await assert.rejects(files.uploadArtifacts(actor,task.id,[{name:'new.txt',data:Buffer.from('not published')},{name:'large.txt',data:Buffer.alloc(10*1024*1024+1)}]));
    check((await files.list(actor,task.id,'artifact')).length===2,'oversize second file rolls back first new document');
    const cancel = new AbortController();
    await assert.rejects(files.uploadArtifacts(actor,task.id,[{name:'cancel.txt',data:Buffer.from('cancel')}],cancel.signal,undefined,async()=>{cancel.abort();}));
    check((await files.list(actor,task.id,'artifact')).length===2,'cancel before commit rolls back batch');
    check(await files.collect(actor)>=2,'rolled back batch files are safely collected');
    mode = 'stop'; await assert.rejects(execution.run(actor,task.id,versions,args)); check(true,'stopped executor cannot publish late output');
    await runs.finish(actor,run,'aborted',[]);
    const second = await runs.start(actor,task.id,randomUUID(),'disable');
    mode = 'disable'; await assert.rejects(execution.run(actor,task.id,versions,args)); check(true,'disabled skill cannot publish in-flight output');
    await runs.finish(actor,second,'completed',[]); await skills.toggle(actor,name,false);
    const third = await runs.start(actor,task.id,randomUUID(),'delete input');
    mode = 'delete'; await assert.rejects(execution.run(actor,task.id,versions,args)); check(true,'deleted input invalidates in-flight output');
    await runs.finish(actor,third,'aborted',[]);
    check((await files.list(actor,task.id,'artifact')).length===2,'failed executions leave prior artifact intact');
    const expired = await runs.start(actor,task.id,randomUUID(),'simulate server restart');
    await transaction(db,async c => { await c.query('INSERT INTO workpivot.skill_executions(id,owner_user_id,run_id,task_id) VALUES($1,$2,$3,$4)',[randomUUID(),actor,expired.id,task.id]);await c.query("UPDATE workpivot.task_runs SET lease_until=now()-interval '1 second' WHERE id=$1",[expired.id]); },actor);
    check(await recoverExecutions(db,actor)===1,'lease recovery marks stranded execution interrupted');
    check(await recoverExecutions(db,actor)===0,'repeated recovery does not replay command');
    check((await workspace.listTasks(actor)).find(t=>t.id===task.id)?.status==='interrupted','stranded task no longer appears running');
    check((await files.list(actor,task.id,'artifact')).length===2,'recovery preserves already committed artifact');
    await workspace.deleteTask(actor,task.id,(await workspace.listTasks(actor)).find(t=>t.id===task.id)!.revision);
    await files.collect(actor);
    check((await transaction(db,c=>c.query('SELECT version_id FROM workpivot.execution_artifacts'),actor)).rowCount===0,'task deletion clears all artifact links');
    check((await transaction(db,c=>c.query('SELECT id FROM workpivot.skill_executions WHERE task_id=$1',[task.id]),actor)).rowCount===0,'task deletion clears execution records');
  } finally { server.closeAllConnections(); await new Promise<void>(r=>server.close(()=>r())); await rm(root,{recursive:true,force:true}); }
}
