import assert from 'node:assert/strict';
import type {Pool} from 'pg';
import {MemoryControls} from '../packages/server/src/database/memory-controls.js';
import {MemoryTemplates} from '../packages/server/src/database/memory-templates.js';
import {MemorySuggestions} from '../packages/server/src/database/memory-suggestions.js';
import {DatabaseMemoryTools} from '../packages/server/src/database/memory-tools.js';
import {WorkspaceRepository} from '../packages/server/src/database/workspace.js';
export async function testMemoryControls(db:Pool,actor:string,foreign:string,check:(ok:unknown,label:string)=>void){
 const workspace=new WorkspaceRepository(db),controls=new MemoryControls(db),templates=new MemoryTemplates(db),suggestions=new MemorySuggestions(db),tools=new DatabaseMemoryTools(db);
 const task=await workspace.createTask(actor,'Memory controls fixture');
 const memory=await workspace.createMemory(actor,'locked unique preference','user');
 const other=await workspace.createMemory(actor,'other unique preference','user');
 check((await controls.list(actor)).every(l=>l.load&&l.update&&l.revision===0),'memory controls default enabled');
 const candidate=await suggestions.propose(actor,task.id,await suggestions.epoch(actor),'user','changed',memory.id,1);
 await controls.lock(actor,memory.id,true,1);
 await assert.rejects(suggestions.decide(actor,candidate.id,true));check(true,'locking invalidates existing update suggestion');
 await assert.rejects(suggestions.propose(actor,task.id,await suggestions.epoch(actor),'user','changed',memory.id,2));check(true,'locked memory rejects automatic update');
 await assert.rejects(suggestions.propose(actor,task.id,await suggestions.epoch(actor),'user','combined',undefined,undefined,undefined,[{id:memory.id,revision:2},{id:other.id,revision:1}]));check(true,'locked memory rejects automatic merge');
 check((await tools.read(actor,task.id,memory.id)).content==='locked unique preference','locked memory remains readable');
 await assert.rejects(controls.lock(foreign,memory.id,false,2));check(true,'foreign user cannot unlock memory');
 await workspace.editMemory(actor,memory.id,'manual unique preference',2);check((await workspace.readMemory(actor,memory.id))?.revision===3,'manual editing remains allowed while locked');
 await controls.save(actor,'user',false,true,0);
 check((await tools.search(actor,task.id,'unique')).memories.length===0,'disabled layer excluded from model search');
 await assert.rejects(tools.read(actor,task.id,memory.id));check(true,'disabled layer cannot be read by remembered ID');
 check((await workspace.listMemories(actor,'user')).memories.some(m=>m.id===memory.id),'disabled layer stays visible in user editor');
 check((await controls.list(foreign))[0]!.load,'memory controls isolated by user');
 await controls.save(actor,'user',true,false,1);
 await assert.rejects(suggestions.propose(actor,task.id,await suggestions.epoch(actor),'user','new disabled proposal'));check(true,'disabled update layer rejects new automatic memory');
 check((await tools.search(actor,task.id,'unique')).memories.length===2,'loading and automatic update switches independent');
 await assert.rejects(controls.save(actor,'user',true,true,1));check(true,'stale control revision rejected');
 await controls.save(actor,'user',true,true,2);await controls.lock(actor,memory.id,false,3);
 const unlocked=await suggestions.propose(actor,task.id,await suggestions.epoch(actor),'user','after unlock',memory.id,4);
 await suggestions.decide(actor,unlocked.id,true);check((await workspace.readMemory(actor,memory.id))?.content==='after unlock','unlocked memory accepts user-confirmed update');
 const template=await templates.save(actor,{name:'Researcher',scope:'user',content:'Use cited evidence',enabled:false});
 check(!(await templates.list(foreign)).some(t=>t.id===template.id),'unpublished role template hidden');
 await templates.save(actor,{name:'Researcher',scope:'user',content:'Use cited evidence',enabled:true},template.id,1);
 check((await templates.list(foreign)).some(t=>t.id===template.id),'published role template visible to users');
 await assert.rejects(templates.save(foreign,{name:'stolen',scope:'user',content:'bad',enabled:true},template.id,2));check(true,'published template cannot be edited by other user');
 const copied=await workspace.createMemory(foreign,'Use cited evidence','user');await templates.remove(actor,template.id,2);
 check((await workspace.readMemory(foreign,copied.id))?.content==='Use cited evidence','template removal preserves user-confirmed copy');
 await workspace.deleteMemory(actor,memory.id,5);await workspace.deleteMemory(actor,other.id,1);await workspace.deleteMemory(foreign,copied.id,1);
 await workspace.deleteTask(actor,task.id,(await workspace.listTasks(actor)).find(t=>t.id===task.id)!.revision);
}
