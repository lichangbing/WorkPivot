import assert from 'node:assert/strict';
import { randomUUID } from 'node:crypto';
import type { Pool } from 'pg';
import { Experts } from '../packages/server/src/database/experts.js';
import { ExpertWorker } from '../packages/server/src/database/expert-worker.js';
import { MemoryWorker } from '../packages/server/src/database/memory-worker.js';
import { MemorySuggestions } from '../packages/server/src/database/memory-suggestions.js';
import { MemoryControls } from '../packages/server/src/database/memory-controls.js';
import { DatabaseMemoryTools } from '../packages/server/src/database/memory-tools.js';
import { WorkspaceRepository } from '../packages/server/src/database/workspace.js';
import { RunRepository } from '../packages/server/src/database/runs.js';

export async function testMemoryExpertIntegration(db: Pool, actor: string, foreign: string, check: (v: unknown, name: string) => void) {
  const w = new WorkspaceRepository(db), experts = new Experts(db), runs = new RunRepository(db);
  const proposals = new MemorySuggestions(db), controls = new MemoryControls(db), tools = new DatabaseMemoryTools(db);
  const settings = { role: '联合验收研究员', startup: '先核实口径', skills: [] };
  const a = await experts.create(actor, '联合验收专家甲', settings);
  const b = await experts.create(actor, '联合验收专家乙', settings);
  await experts.editExperience(actor, a.id, { content: '甲方法：检查来源日期', conditions: '研究', locked: false });
  await experts.editExperience(actor, b.id, { content: '乙方法：独立交叉核验', conditions: '研究', locked: false });
  const project = await w.createProject(actor, '联合记忆项目');
  const task = await w.createTask(actor, '联合记忆任务', project.id);
  await experts.bind(actor, 'tasks', task.id, a.id, task.revision);
  const user = await w.createMemory(actor, '联合个人：中文报告', 'user', project.id);
  const projectMemory = await w.createMemory(actor, '联合项目：只研究机械行业', 'project', project.id);
  const taskMemory = await w.createMemory(actor, '联合任务：本周交付', 'task', task.id);
  const revision = async () => (await w.listTasks(actor)).find(t => t.id === task.id)!.revision;
  const complete = async (message: string) => {
    const run = await runs.start(actor, task.id, randomUUID(), message);
    await runs.finish(actor, run, 'completed', []); return run;
  };
  const run = await complete('以后报告使用英文。记住方法：先核对数据日期。');
  let calls = 0;
  const memoryWorker = new MemoryWorker(db, async () => ({ providerId: 'test', model: 'test', async *streamChat() {
    calls++; yield { type: 'delta', text: JSON.stringify(calls === 1 ? [{ scope: 'task', content: '本次报告使用英文', evidence: '以后报告使用英文', query: '联合任务' }] : { action: 'update', content: '联合任务：本周交付英文报告', targetId: taskMemory.id, targetRevision: taskMemory.revision }) };
  } }));
  const expertWorker = new ExpertWorker(db, async () => ({ providerId: 'test', model: 'test', async *streamChat() {
    yield { type: 'delta', text: JSON.stringify([{ content: '先核对数据日期', conditions: '研究', evidence: '先核对数据日期', targets: [] }]) };
  } }));
  await memoryWorker.enqueue(actor, task.id, run.id); await memoryWorker.process(actor);
  await expertWorker.recover(actor); await expertWorker.process(actor);
  const memorySuggestion = (await proposals.list(actor)).find(s => s.taskId === task.id)!;
  const expertSuggestion = (await experts.suggestions(actor, task.id))[0]!;
  check(memorySuggestion && expertSuggestion, 'one completed turn can produce separate memory and expert proposals');
  check((await w.readMemory(actor, user.id))?.content === '联合个人：中文报告' && (await experts.context(actor, task.id))?.experiences.length === 1, 'neither type of pending proposal enters active context');
  await controls.lock(actor, user.id, true, user.revision);
  await assert.rejects(proposals.decide(actor, memorySuggestion.id, true));
  await assert.rejects(experts.decide(actor, expertSuggestion.id, expertSuggestion.revision, true));
  check(true, 'locking memory invalidates both stale proposal pipelines');
  await w.editMemory(actor, user.id, '联合个人：手动调整为双语报告', 2);
  check((await w.readMemory(actor, user.id))?.content.includes('双语'), 'manual memory editing remains available while locked');
  check((await w.readMemory(actor, projectMemory.id))?.content === '联合项目：只研究机械行业' && (await w.readMemory(actor, taskMemory.id))?.content === '联合任务：本周交付', 'personal edits preserve project and task memory contents');
  await experts.bind(actor, 'tasks', task.id, b.id, await revision());
  const context = await experts.context(actor, task.id);
  check(context?.id === b.id && context.experiences.every(e => e.content.startsWith('乙方法')), 'switching experts loads only the newly selected expert experience');
  const found = await tools.search(actor, task.id, '联合');
  check([user.id, projectMemory.id, taskMemory.id].every(id => found.memories.some(m => m.id === id)), 'switching experts retains all three memory layers');
  check(!(await experts.list(foreign)).some(e => e.id === a.id || e.id === b.id), 'combined expert setup remains private to its owner');
  await assert.rejects(tools.read(foreign, task.id, projectMemory.id));
  check(true, 'another user cannot read combined project memory');
  const waiting = await proposals.propose(actor, task.id, await proposals.epoch(actor), 'project', '待专家调整前的建议');
  const experience = (await experts.experiences(actor, b.id))[0]!;
  await experts.editExperience(actor, b.id, { id: experience.id, revision: experience.revision, content: '乙方法：手动调整后交叉核验', conditions: '研究', locked: true });
  await assert.rejects(proposals.decide(actor, waiting.id, true));
  check(true, 'manual expert changes invalidate stale three-layer proposals');
  const edited = (await experts.experiences(actor, b.id))[0]!;
  check(edited.locked && edited.revision === experience.revision + 1 && edited.history.length === 1, 'expert manual adjustment preserves history and lock');
  const source = await complete('记住方法：先核对数据日期。');
  await expertWorker.recover(actor); await expertWorker.process(actor);
  const fresh = (await experts.suggestions(actor, task.id))[0]!;
  assert(fresh);
  await experts.decide(actor, fresh.id, fresh.revision, true, '已确认：先核对数据日期');
  const derived = await proposals.propose(actor, task.id, await proposals.epoch(actor), 'project', '本项目需要核对日期', undefined, undefined, { runId: source.id, evidence: '先核对数据日期' });
  const saved = await proposals.decide(actor, derived.id, true);
  await w.deleteTask(actor, task.id, await revision());
  check(!(await experts.experiences(actor, b.id)).some(e => e.content.startsWith('已确认')), 'source task deletion clears derived expert experience');
  check(await w.readMemory(actor, saved.memoryId!) === null, 'same source deletion clears derived project memory');
  check((await experts.experiences(actor, b.id)).some(e => e.content.startsWith('乙方法')), 'source deletion preserves unrelated manually authored experience');
  check(await w.readMemory(actor, user.id) && await w.readMemory(actor, projectMemory.id), 'source deletion preserves independent personal and project memories');
  await w.deleteMemory(actor, user.id, 3);
  await w.deleteProject(actor, project.id, project.revision);
  await experts.remove(actor, a.id, a.revision); await experts.remove(actor, b.id, b.revision);
}
