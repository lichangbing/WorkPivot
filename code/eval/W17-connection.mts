import { checkServiceHealth, API_PROTOCOL } from '../packages/shared/src/service-health.js';
import { readChatStream } from '../apps/web/src/chat-stream.js';
const results: boolean[] = [];
const assert = (name: string, pass: boolean) => { results.push(pass); console.log(`${pass ? '✅' : '❌'} ${name}`); };
async function fails(action: () => unknown) { try { await action(); return false; } catch { return true; } }
const body = (text: string) => new ReadableStream<Uint8Array>({ start(c) { const bytes = new TextEncoder().encode(text); for (const byte of bytes) c.enqueue(Uint8Array.of(byte)); c.close(); } });
assert('连接支持当前协议', !checkServiceHealth({ ok: true, name: 'workpivot', apiProtocol: API_PROTOCOL, version: 'test' }).legacy);
assert('连接兼容已部署旧后台', checkServiceHealth({ ok: true, name: 'workpivot' }).legacy);
assert('连接拒绝不兼容协议', await fails(() => checkServiceHealth({ ok: true, name: 'workpivot', apiProtocol: 99 })));
assert('连接拒绝错误服务标识', await fails(() => checkServiceHealth({ ok: true, name: 'other' })));
assert('连接拒绝不健康服务', await fails(() => checkServiceHealth({ ok: false, name: 'workpivot' })));
const events: string[] = [];
await readChatStream(body(': ping\r\ndata: {"type":"assistant_delta","text":"中文"}\r\n\r\ndata: {"type":"done","steps":1,"stopReason":"completed"}\n\n'), (event) => events.push(event.type === 'assistant_delta' ? event.text : event.type));
assert('客户端流兼容UTF8分片、CRLF及心跳', events.join(',') === '中文,done');
assert('客户端流EOF不能误报任务完成', await fails(() => readChatStream(body('data: {"type":"assistant_delta","text":"partial"}\n\n'), () => undefined)));
let cancelled = false;
assert('客户端流空闲超时', await fails(() => readChatStream(new ReadableStream({ cancel() { cancelled = true; } }), () => undefined, undefined, 20)));
assert('客户端流超时清理连接', cancelled);
const abort = new AbortController(); cancelled = false;
const pending = readChatStream(new ReadableStream({ cancel() { cancelled = true; } }), () => undefined, abort.signal);
abort.abort();
assert('客户端等待数据期间可取消', await fails(() => pending));
assert('客户端取消释放连接', cancelled);
assert('客户端拒绝异常JSON并清理', await fails(() => readChatStream(body('data: invalid\n\n'), () => undefined)));
assert('客户端限制无换行超长响应', await fails(() => readChatStream(new ReadableStream({ start(c) { c.enqueue(new Uint8Array(1024 * 1024 + 1)); } }), () => undefined)));
await readChatStream(body('data: {"type":"error","message":"mock-failure"}\n\n'), (event) => events.push(event.type));
assert('客户端服务端错误事件正常结束', events.at(-1) === 'error');
console.log(`W17 connection: ${results.filter(Boolean).length}/${results.length}`);
process.exit(results.every(Boolean) ? 0 : 1);
