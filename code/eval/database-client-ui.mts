/** Local disposable browser fixture; no real accounts, credentials or database. */
import { createRequire } from 'node:module';
const express = createRequire(new URL('../packages/server/package.json', import.meta.url))('express');
import { resolve } from 'node:path';
const app = express(); app.use(express.json());
const task = { id: 'task-one', name: '历史加载验收', status: 'idle', revision: 1, projectId: 'project-one' };
const events = Array.from({ length: 8 }, (_, index) => {
  const n = index + 1, base = { turnId: `turn-${n}`, runId: `run-${n}`, truncated: false };
  return [{ ...base, id: `user-${n}`, sequence: String(n * 2 - 1), kind: 'user', content: `第${n}组问题` }, { ...base, id: `answer-${n}`, sequence: String(n * 2), kind: 'assistant', content: `第${n}组回答\n\n` + '用于验证聊天窗口阅读位置。\n\n'.repeat(12) }];
});
const requests: string[] = []; let pending = true;
const subscribers=new Set<(value:unknown)=>void>();
app.get('/api/tasks/:id/stream',(req,res)=>{
 requests.push(req.originalUrl);res.setHeader('Content-Type','text/event-stream');res.flushHeaders();
 const send=(value:unknown)=>res.write(`data: ${JSON.stringify(value)}\n\n`);
 send({type:'changes',events:[],nextSequence:String(req.query.after??'16'),snapshotSequence:'16',hasMore:false});
 subscribers.add(send);const timer=setInterval(()=>res.write(': ping\n\n'),15000);
 res.on('close',()=>{subscribers.delete(send);clearInterval(timer);});
});
app.post('/fixture/broadcast',(_req,res)=>{for(const send of subscribers)send({type:'changes',events:[{id:'sse-proof',turnId:'turn-8',runId:'run-8',sequence:'17',kind:'assistant',content:'SSE双端实时验证成功',truncated:false}],nextSequence:'17',snapshotSequence:'17',hasMore:false});res.json({subscribers:subscribers.size});});
const summary={id:'summary-fixture',status:'pending',content:'目标：生成松柏周报。金额单位：万元。未完成：核对库存。',revision:2,through:'3',turns:3};
app.get('/api/tasks/:id/summary',(_req,res)=>res.json({checkpoints:process.env.WORKPIVOT_UI_SUMMARY==='1'?[summary]:[]}));
app.get('/api/tasks/:id/summary/:summaryId/sources',(_req,res)=>res.json({sources:[{sequence:'2',excerpt:'更正：标题改为松柏周报，金额单位使用万元。',truncated:false}]}));
app.post('/api/tasks/:id/summary/:summaryId/decision',(req,res)=>{if(summary.status!=='pending'||req.body.revision!==summary.revision)return res.status(409).json({error:'状态已变化'});summary.status=req.body.accept?'accepted':'rejected';summary.content=req.body.accept?(req.body.content??summary.content):'';summary.revision++;res.json({status:summary.status});});
app.post('/api/tasks/:id/summary',(_req,res)=>{summary.status='pending';summary.content='重新整理的目标与待办';summary.revision++;res.json({ok:true});});
app.get('/api/model-status', (_req,res)=>res.json({available:true,name:'DeepSeek',modelId:'fixture-model'}));
app.get('/api/preferences/execution.mode', (_req,res)=>res.json({setting:{value:'manual',revision:1}}));
app.get('/api/skill-market', (_req,res)=>res.json({skills:[]}));
const memoryRows = [{ id:'memory-a',content:'研究新能源行业',revision:1,locked:false },{id:'memory-b',content:'报告标注数据来源',revision:1,locked:false}];
let memoryPending = process.env.WORKPIVOT_UI_MEMORY === '1';
app.get('/api/preferences/memory.auto-extraction', (_req,res)=>res.json({setting:{value:true,revision:1}}));
app.get('/api/memory-controls', (_req,res)=>res.json({layers:['user','project','task'].map(scope=>({scope,load:true,update:true,revision:1}))}));
app.get('/api/memory-templates', (_req,res)=>res.json({templates:[]}));
app.get('/api/memories', (_req,res)=>res.json({memories:memoryRows,nextCursor:null}));
app.put('/api/memories/:id/lock', (req,res)=>{const row=memoryRows.find(m=>m.id===req.params.id);if(!row||row.revision!==req.body.revision)return res.status(409).json({error:'记忆已更新'});row.locked=req.body.locked;row.revision++;res.json({revision:row.revision});});
app.get('/api/memory-suggestions', (_req,res)=>res.json({suggestions:memoryPending?[{id:'merge-fixture',scope:'user',taskName:task.name,content:'研究新能源行业，报告标注数据来源',evidence:'请将这两条研究偏好合并',mergeTargets:memoryRows.map(m=>({id:m.id,revision:m.revision})),mergeOriginals:memoryRows}]:[]}));
app.post('/api/memory-suggestions/:id/decision', (req,res)=>{if(!memoryPending)return res.status(409).json({error:'建议已处理'});memoryPending=false;if(req.body.accept)memoryRows.splice(0,memoryRows.length,{id:'merged',content:req.body.content??'研究新能源行业，报告标注数据来源',revision:1,locked:false});res.json({status:req.body.accept?'accepted':'rejected'});});
app.get('/api/memory-jobs', (_req,res)=>res.json({jobs:[]}));
app.get('/api/tasks/:id/parsing', (_req,res)=>res.json({files:[]}));
app.get('/api/tasks/:id/executions', (_req,res)=>res.json({executions:[]}));
app.get('/api/tasks/:id/artifacts', (_req,res)=>res.json({artifacts:[]}));
app.use('/api', (req, _res, next) => { requests.push(req.originalUrl); next(); });
app.get('/api/health', (_req, res) => res.json({ name: 'workpivot', apiProtocol: 1, storage: 'postgresql', ok: true, chatEnabled: true, filesEnabled: true, providersEnabled:true, mcpEnabled:true }));
app.get('/api/auth/state', (_req, res) => res.json({ authenticated: true, needsSetup: false, user: { id: 'fixture', username: 'fixture', role: process.env.WORKPIVOT_UI_ADMIN==='1'?'admin':'member' } }));
const projects = [{ id: 'project-one', name: '测试项目', revision: 1 }];
app.post('/api/auth/login',(_req,res)=>res.json({token:'disposable-fixture',user:{id:'fixture',username:'fixture',role:process.env.WORKPIVOT_UI_ADMIN==='1'?'admin':'member'}}));
app.get('/api/projects', (_req, res) => res.json({ projects }));
app.post('/api/projects', (req, res) => { const project = { id: `project-${projects.length + 1}`, name: req.body.name, revision: 1 }; projects.push(project); res.json({ project }); });
app.patch('/api/projects/:id', (req, res) => { const project = projects.find(p => p.id === req.params.id); if (!project || project.revision !== req.body.revision) return res.status(409).json({ error: '项目版本冲突' }); project.name = req.body.name; project.revision++; res.json({ project }); });
const providers: Record<string, unknown>[] = [];
app.get('/api/providers', (_req, res) => res.json({ providers }));
app.post('/api/providers', (req, res) => { const { apiKey, ...input } = req.body; const provider = { ...input, id: `provider-${providers.length}`, revision: 1, active: false, hasApiKey: !!apiKey }; providers.push(provider); res.json({ provider }); });
app.post('/api/providers/active', (req, res) => { providers.forEach(p => { p.active = p.id === req.body.id; p.revision = Number(p.revision) + 1; }); res.json({ ok: true }); });
const connection = { id: 'mcp-one', name: '模拟数据服务', url: 'https://example.invalid/mcp', revision: 1, enabled: false, hasToken: false, status: 'new', tools: [] as { name: string }[], disabledTools: [] as string[] };
app.get('/api/mcp', (_req, res) => res.json({ connections: [connection] }));
app.post('/api/mcp/:id/test', (_req, res) => { connection.status = 'ready'; connection.tools = [{ name: 'read_sample' }]; connection.enabled = false; connection.revision++; res.json(connection); });
app.post('/api/mcp/:id/toggle', (req, res) => { connection.enabled = req.body.enabled; connection.revision++; res.json(connection); });
app.post('/api/mcp/:id/tools/toggle', (req, res) => { connection.disabledTools = req.body.enabled ? [] : [req.body.name]; connection.revision++; res.json(connection); });
app.get('/api/tasks', (_req, res) => res.json({ tasks: [task, { ...task, id: 'task-two', name: '另一项任务' }] }));
app.get('/api/tasks/:id/conversation', (req, res) => {
  const end = req.query.before ? Number(req.query.before) : 8, count = req.query.before ? 1 : 5;
  const start = Math.max(0, end - count);
  const selected = req.params.id === 'task-two' ? [] : events.slice(start, end);
  res.json({ turns: selected.map((rows, i) => ({ id: rows[0]!.turnId, sequence: String(start + i + 1), events: rows, hasMoreEvents: false, nextEventSequence: null })), nextCursor: req.params.id === 'task-two' || !start ? null : String(start), hasMore: start > 0, snapshotSequence: '16' });
});
app.get('/api/tasks/:id/conversation-changes', (_req, res) => res.json({ events: [], nextSequence: '16', snapshotSequence: '16', hasMore: false }));
app.get('/api/tasks/:id/permissions', (req, res) => res.json({ pending: pending && req.params.id === 'task-one' ? [{ id: 'approval-one', request: { tool: 'fixture', command: '测试工具：读取模拟数据' }, expiresAt: new Date(Date.now() + 180000).toISOString() }] : [] }));
app.post('/api/tasks/:id/permissions/:permissionId', (_req, res) => { pending = false; res.json({ ok: true }); });
app.get('/fixture/status', (_req, res) => res.json({ requests, pending }));
app.post('/fixture/stop', (_req, res) => { res.json({ ok: true }); setTimeout(() => { server.closeAllConnections(); server.close(); }, 100); });
app.use(express.static(resolve('apps/web/dist')));
const server = app.listen(39987, '127.0.0.1', () => console.log('Disposable client fixture http://127.0.0.1:39987'));
const lifetime = setTimeout(() => { server.closeAllConnections(); server.close(); }, 600000); lifetime.unref();

