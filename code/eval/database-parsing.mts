import type { ParsedPart } from '../packages/server/src/database/parsed-content.js';
import assert from 'node:assert/strict';
import { randomUUID } from 'node:crypto';
import { mkdtemp,rm } from 'node:fs/promises';
import { join } from 'node:path';
import { tmpdir } from 'node:os';
import type {Pool} from 'pg';
import {FileRepository} from '../packages/server/src/database/files.js';
import {WorkspaceRepository} from '../packages/server/src/database/workspace.js';
import {DocumentProcessing} from '../packages/server/src/database/document-processing.js';
import {KnowledgeRepository} from '../packages/server/src/database/knowledge.js';
import {DatabaseFileTools} from '../packages/server/src/database/file-tools.js';
import {transaction} from '../packages/server/src/database/connection.js';
import {KnowledgeIngestionRepository} from '../packages/server/src/database/knowledge-ingestion.js';
import {confirmKnowledgeForTest} from './knowledge-fixture.mts';
export async function testParsing(db:Pool,actor:string,foreign:string,check:(ok:unknown,label:string)=>void) {
 const root=await mkdtemp(join(tmpdir(),'wp-parse-')),files=new FileRepository(db,root),workspace=new WorkspaceRepository(db);
 const project=await workspace.createProject(actor,'parse fixture'),task=await workspace.createTask(actor,'parse fixture',project.id);let fail=false,erase=false;
 let docId='';
 let extracted:ParsedPart[]=[{location:'paragraph:1',text:'saved text'}];
 const processor=new DocumentProcessing(db,files,async()=>{if(fail)throw Error('invalid');if(erase)await files.remove(actor,task.id,docId,1);return extracted;});
 try {
 const first=await files.upload(actor,task.id,'report.docx',Buffer.from('fixture'),randomUUID());docId=first.documentId;
 check((await processor.list(actor,task.id))[0]?.status==='pending','upload queues parsing transactionally');
 await assert.rejects(processor.list(foreign,task.id));check(true,'parsing status is private');
 await assert.rejects(processor.read(actor,task.id,first.id,0));check(true,'pending parse cannot masquerade as content');
 await processor.process(actor);check((await processor.read(actor,task.id,first.id,0)).content.includes('[paragraph:1]'),'parsed text retains source location');
 await assert.rejects(processor.read(foreign,task.id,first.id,0));check(true,'parsed text enforces owner');
 const second=await files.upload(actor,task.id,'report.docx',Buffer.from('new'),randomUUID(),first.documentId,1);
 fail=true;await processor.process(actor);check((await processor.list(actor,task.id))[0]?.status==='failed','parser failure persists');
 check((await processor.read(actor,task.id,first.id,0)).content.includes('saved text'),'old parsed version remains pinned');
 await assert.rejects(processor.read(actor,task.id,second.id,0));check(true,'failed new version never reads old content implicitly');
 fail=false;await processor.retry(actor,task.id,second.id);await processor.process(actor);check((await processor.list(actor,task.id))[0]?.status==='completed','manual parse retry succeeds');
 const third=await files.upload(actor,task.id,'restart.pdf',Buffer.from('pdf'),randomUUID());
 await transaction(db,c=>c.query("UPDATE workpivot.document_processing SET status='running',attempts=1,fence=$2,lease_until=now()-interval '1 second' WHERE version_id=$1",[third.id,randomUUID()]),actor);
 await processor.process(actor);check((await processor.read(actor,task.id,third.id,0)).content.includes('saved text'),'expired parser lease recovered');
 const fourth=await files.upload(actor,task.id,'delete.pptx',Buffer.from('ppt'),randomUUID());docId=fourth.documentId;erase=true;
 await processor.process(actor);await assert.rejects(processor.read(actor,task.id,fourth.id,0));check(true,'deletion rejects late parsing publication');
 erase=false;
 extracted=[{location:'paragraph:1',text:'完整性测试'+ '文'.repeat(17000)}, {location:'paragraph:2',text:'末段来源核对'}];
 const long=await files.upload(actor,task.id,'long.docx',Buffer.from('long'),randomUUID());
 await processor.process(actor);
 const reader=new DatabaseFileTools(files,processor),page=await reader.read(actor,task.id,long.id,8000);
 check('excerpts' in page&&page.excerpts[0]?.location==='paragraph:1'&&page.excerpts[0].continuedBefore,'长文续页保持定位并标记续读');
 check('warnings' in page&&page.warnings.some((w:string)=>w.includes('页眉页脚')),'读取不把正文提取冒充完整文档');
 check(page.versionId===long.id&&'latestRevision' in page&&page.latestRevision===1,'共用读取返回固定版本及当前修订');
 const knowledge=new KnowledgeRepository(db),ingestion=new KnowledgeIngestionRepository(db);await confirmKnowledgeForTest(db,actor,task.id,long.id);while(await knowledge.indexNext(actor)) { /* 为当前合成资料建立索引。 */ }
 const found=await knowledge.search(actor,task.id,'末段来源核对');
 check(found.matches.some(r=>r.versionId===long.id&&r.location==='paragraph:2'),'知识库复用同一解析来源');
 const hit=found.matches.find(r=>r.versionId===long.id)!;
 const citation=await knowledge.read(actor,task.id,hit.chunkId);
 check(citation.warnings.some((w:string)=>w.includes('页眉页脚'))&&citation.sourceOffsetUnit==='unicode-code-point','引用返回提取限制及偏移单位');
 await assert.rejects(reader.read(foreign,task.id,long.id,8000));check(true,'新增定位信息不绕过文件权限');
 await transaction(db,c=>c.query("UPDATE workpivot.document_processing SET parser_fingerprint='old-parser',attempts=99 WHERE version_id=$1",[long.id]),actor);
 check((await processor.list(actor,task.id)).some(r=>r.id===long.id&&r.stale&&!r.indexed),'旧解析标为过期且不冒充可检索');
 await assert.rejects(reader.read(actor,task.id,long.id,0));await assert.rejects(knowledge.read(actor,task.id,hit.chunkId));
 check((await knowledge.search(actor,task.id,'末段来源核对')).matches.length===0,'旧指纹在重建开始前已停止召回');
 check(await knowledge.indexNext(actor)===false,'旧结果不会重新建立索引');
 await processor.process(actor);
 const reprocessed=await ingestion.candidates(actor,task.id,long.id);
 check(reprocessed.status==='pending','解析器升级后知识确认重新回到待审核');
 await confirmKnowledgeForTest(db,actor,task.id,long.id);await knowledge.indexNext(actor);
 check((await transaction(db,c=>c.query('SELECT attempts FROM workpivot.document_processing WHERE version_id=$1',[long.id]),actor)).rows[0].attempts===1,'升级重建重置旧程序重试计数');
 check((await knowledge.search(actor,task.id,'末段来源核对')).matches.some(r=>r.versionId===long.id&&r.chunkId!==hit.chunkId),'自动重建后使用新引用');
 await assert.rejects(knowledge.read(actor,task.id,hit.chunkId));check(true,'重建不复活旧引用');
 await files.remove(actor,task.id,long.documentId,1);
 await assert.rejects(reader.read(actor,task.id,long.id,8000));await assert.rejects(knowledge.read(actor,task.id,hit.chunkId));check(true,'删除后续页与知识引用同时失效');
 extracted=[{location:'',text:'非法定位'}];const invalid=await files.upload(actor,task.id,'invalid.docx',Buffer.from('invalid'),randomUUID());
 await processor.process(actor);check((await processor.list(actor,task.id)).some(p=>p.id===invalid.id&&p.status==='failed'),'非法解析结果在持久发布前拒绝');
 const partial=await files.upload(actor,task.id,'mixed.pdf',Buffer.from('mixed'),randomUUID());
 const partialProcessor=new DocumentProcessing(db,files,async()=>({parts:[{location:'page:1',text:'部分结果可检索'}],coverage:'partial',warnings:['第2页没有可提取文字，未执行OCR。']}));
 await partialProcessor.process(actor);await confirmKnowledgeForTest(db,actor,task.id,partial.id);await knowledge.indexNext(actor);
 const partialRead=await partialProcessor.read(actor,task.id,partial.id,0);
 check(partialRead.coverage==='partial'&&partialRead.warnings.some(w=>w.includes('第2页')),'部分结果保留缺失页说明');
 const partialHit=(await knowledge.search(actor,task.id,'部分结果可检索')).matches[0];
 check(partialHit?.coverage==='partial'&&partialHit.warnings.some((w:string)=>w.includes('第2页')),'部分结果可检索但不隐藏识别缺口');
 await assert.rejects(partialProcessor.retry(foreign,task.id,partial.id));check(true,'跨用户不能重建部分解析');
 await partialProcessor.retry(actor,task.id,partial.id);
 await assert.rejects(knowledge.read(actor,task.id,partialHit.chunkId));
 check((await knowledge.search(actor,task.id,'部分结果可检索')).matches.length===0,'手动重建立即撤销旧索引');
 await partialProcessor.process(actor);check((await partialProcessor.read(actor,task.id,partial.id,0)).coverage==='partial','重试仍无法识别时不升级为完整结果');
 extracted=[{location:'sheet:收入',text:'',object:{kind:'sheet',sheet:'收入'}},{location:'sheet:收入!B2',text:'结构金额',object:{kind:'cell',parent:'sheet:收入',sheet:'收入',address:'B2'}}];
 const structured=await files.upload(actor,task.id,'structure.xlsx',Buffer.from('structure'),randomUUID());
 await processor.process(actor);
 const structureRead=await reader.readStructure(actor,task.id,structured.id,{sheet:'收入',range:'B2'});
 check(structureRead.items[0]?.text==='结构金额'&&structureRead.versionId===structured.id,'结构化读取从持久解析返回固定版本与区域');
 await assert.rejects(reader.readStructure(foreign,task.id,structured.id));check(true,'结构化读取不可跨用户');
 const otherTask=await workspace.createTask(actor,'other scope');
 await assert.rejects(reader.readStructure(actor,otherTask.id,structured.id));check(true,'结构化读取不可跨任务');
 check(reader.tools(actor,task.id).some(t=>t.name==='read_document_structure')&&!new DatabaseFileTools(files).tools(actor,task.id).some(t=>t.name==='read_document_structure'),'仅启用解析服务时注册结构化工具');
 await confirmKnowledgeForTest(db,actor,task.id,structured.id);while(await knowledge.indexNext(actor)) { /* 补齐当前合成资料索引。 */ }
 check((await knowledge.search(actor,task.id,'结构金额')).matches.some(r=>r.versionId===structured.id),'带对象元数据的解析继续用于知识检索');
 await transaction(db,c=>c.query("UPDATE workpivot.document_processing SET parser_fingerprint='old-structure' WHERE version_id=$1",[structured.id]),actor);
 await assert.rejects(reader.readStructure(actor,task.id,structured.id));check(true,'过期结构拒绝返回');
 await processor.process(actor);
 await files.remove(actor,task.id,structured.documentId,1);
 await assert.rejects(reader.readStructure(actor,task.id,structured.id));check(true,'删除文件后结构读取失效');
 const imageFile=await files.upload(actor,task.id,'scan.jpg',Buffer.from('synthetic-image'),randomUUID());
 check((await processor.list(actor,task.id)).some(p=>p.id===imageFile.id&&p.status==='pending'),'图片上传进入共用解析队列');
 const ocrProcessor=new DocumentProcessing(db,files,async()=>({parts:[{location:'image:1',text:'扫描验收金额三十',recognition:{method:'ocr',language:'chi_sim+eng',confidence:82,rotation:90}}],coverage:'partial',warnings:['OCR结果需要核对。']}));
 await ocrProcessor.process(actor);
 const ocrRead=await ocrProcessor.read(actor,task.id,imageFile.id,0);
 check(ocrRead.coverage==='partial'&&ocrRead.excerpts[0]?.recognition?.rotation===90&&ocrRead.excerpts[0]?.recognition?.confidence===82,'OCR来源、旋转和置信度持久保存并返回');
 await confirmKnowledgeForTest(db,actor,task.id,imageFile.id);while(await knowledge.indexNext(actor)) { /* 为图片共用结果建立索引。 */ }
 check((await knowledge.search(actor,task.id,'扫描验收金额三十')).matches.some(r=>r.versionId===imageFile.id&&r.coverage==='partial'),'图片OCR内容复用于知识检索且保留警告');
 await assert.rejects(ocrProcessor.read(foreign,task.id,imageFile.id,0));check(true,'图片OCR读取遵守用户隔离');
 await files.remove(actor,task.id,imageFile.documentId,1);
 check(!(await knowledge.search(actor,task.id,'扫描验收金额三十')).matches.some(r=>r.versionId===imageFile.id),'删除图片立即撤销OCR检索');
 await workspace.deleteTask(actor,task.id,(await workspace.listTasks(actor)).find(t=>t.id===task.id)!.revision);
 check((await transaction(db,c=>c.query('SELECT version_id FROM workpivot.document_processing WHERE version_id=ANY($1::uuid[])',[[first.id,second.id,third.id]]),actor)).rowCount===0,'task deletion clears parsed content and jobs');
 }finally{await rm(root,{recursive:true,force:true});}
}
