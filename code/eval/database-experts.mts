import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import type {Pool} from 'pg';
import {Experts} from '../packages/server/src/database/experts.js';
import {ExpertWorker} from '../packages/server/src/database/expert-worker.js';
import {WorkspaceRepository} from '../packages/server/src/database/workspace.js';
import {RunRepository} from '../packages/server/src/database/runs.js';
import {transaction} from '../packages/server/src/database/connection.js';
export async function testExperts(db:Pool,actor:string,foreign:string,check:(v:unknown,n:string)=>void){
 const experts=new Experts(db),workspace=new WorkspaceRepository(db),runs=new RunRepository(db);
 const settings={role:'行业研究员',startup:'先核对口径，再分析。',skills:[]};
 const template=await experts.create(actor,'通用研究员测试',settings,true);await experts.publish(actor,template.id,template.revision);
 const expert=await experts.create(actor,'私人研究员',settings,false,template.id);
 check(expert.settings.startup===settings.startup,'template creates private expert copy');
 const newer={...settings,startup:'先确认来源日期，再检查口径。'};
 await experts.save(actor,template.id,1,{name:template.name,settings:newer,load:true,update:true,disabled:false},true);
 await experts.publish(actor,template.id,2);
 check((await experts.list(actor)).find(e=>e.id===expert.id).settings.startup===settings.startup,'published template upgrade does not overwrite private settings');
 await experts.adopt(actor,expert.id,1,2);
 check((await experts.list(actor)).find(e=>e.id===expert.id).settings.startup===newer.startup,'explicit adoption loads published template revision');
 await assert.rejects(experts.adopt(actor,expert.id,1,2));check(true,'stale template adoption rejected');
 check(!(await experts.list(foreign)).some(e=>e.id===expert.id),'private expert invisible to other user');
 await assert.rejects(experts.experiences(foreign,expert.id));check(true,'foreign experience access rejected');
 const project=await workspace.createProject(actor,'专家验收');await experts.bind(actor,'projects',project.id,expert.id,project.revision);
 const task=await workspace.createTask(actor,'任务恢复',project.id);
 check((await experts.context(actor,task.id))?.id===expert.id,'new task inherits project expert');
 await experts.editExperience(actor,expert.id,{content:'比较数据前检查统计口径',conditions:'跨来源比较',locked:false});
 check((await experts.context(actor,task.id))?.experiences.length===1,'manual experience loads into expert context');
 const run=await runs.start(actor,task.id,randomUUID(),'记住研究方法：比较库存前先核对统计时间与范围。');
 await assert.rejects(experts.bind(actor,'tasks',task.id,null,(await workspace.listTasks(actor)).find(t=>t.id===task.id)!.revision));check(true,'running task cannot switch expert');
 await runs.finish(actor,run,'completed',[{role:'assistant',content:'已理解这个方法。'}]);
 const existing=(await experts.experiences(actor,expert.id))[0];
 const model={providerId:'fixture',model:'fixture',async *streamChat(){yield{type:'delta' as const,text:JSON.stringify([{content:'比较库存前核对统计时间与范围',conditions:'库存比较',evidence:'比较库存前先核对统计时间与范围',targets:[{id:existing.id,revision:existing.revision}]}])};}};
 const worker=new ExpertWorker(db,async()=>model);await worker.recover(actor);await worker.process(actor);
 const suggestion=(await experts.suggestions(actor,task.id))[0];assert(suggestion);
 check(suggestion.originals[0]?.content===existing.content,'confirmation exposes original experience comparison');
 check((await experts.experiences(actor,expert.id))[0].content===existing.content,'unconfirmed experience does not replace active original');
 await Promise.all([experts.decide(actor,suggestion.id,suggestion.revision,true,'用户确认：先统一库存口径'),experts.decide(actor,suggestion.id,suggestion.revision,true,'用户确认：先统一库存口径')]);
 const confirmed=(await experts.experiences(actor,expert.id))[0];check(confirmed.content==='用户确认：先统一库存口径','duplicate expert confirmation saves edited content once');
 const next=await workspace.createTask(actor,'另一项研究',project.id);check((await experts.context(actor,next.id))?.experiences[0]?.content===confirmed.content,'new task uses confirmed expert experience');
 await experts.editExperience(actor,expert.id,{id:confirmed.id,revision:confirmed.revision,content:confirmed.content,conditions:confirmed.conditions,locked:true});
 check((await experts.experiences(actor,expert.id))[0].locked,'expert experience supports locking');
 await workspace.deleteTask(actor,task.id,(await workspace.listTasks(actor)).find(t=>t.id===task.id)!.revision);
 check(!(await experts.experiences(actor,expert.id)).length,'source task deletion erases derived expert experience');
 const current=(await experts.list(actor)).find(e=>e.id===expert.id)!;
 await experts.save(actor,expert.id,current.revision,{name:current.name,settings,load:false,update:false,disabled:false});
 check((await experts.context(actor,next.id))?.experiences.length===0,'experience loading can be disabled');
 await experts.remove(actor,expert.id,current.revision+1);check(await experts.context(actor,next.id)===null,'deleted expert falls back to default assistant');
 await workspace.deleteProject(actor,project.id,(await workspace.listProjects(actor)).find(p=>p.id===project.id)!.revision);
 const retryExpert=await experts.create(actor,'重试测试',settings);
 const retryTask=await workspace.createTask(actor,'经验整理失败恢复');await experts.bind(actor,'tasks',retryTask.id,retryExpert.id,retryTask.revision);
 const retryRun=await runs.start(actor,retryTask.id,randomUUID(),'记住方法：先核对日期。');await runs.finish(actor,retryRun,'completed',[]);
 const broken=new ExpertWorker(db,async()=>{throw Error('fixture unavailable');});await broken.recover(actor);
 for(let i=0;i<3;i++)await broken.process(actor);
 check((await experts.jobs(actor,retryExpert.id))[0]?.status==='failed','failed extraction has a bounded retry limit and visible status');
 await assert.rejects(experts.retry(foreign,retryExpert.id,retryRun.id));check(true,'foreign user cannot retry expert extraction');
 await experts.retry(actor,retryExpert.id,retryRun.id);
 const recovered=new ExpertWorker(db,async()=>({providerId:'fixture',model:'fixture',async *streamChat(){yield{type:'delta' as const,text:JSON.stringify([{content:'先核对日期',conditions:'比较资料',evidence:'先核对日期',targets:[]}])};}}));await recovered.process(actor);
 const proposed=(await experts.suggestions(actor,retryTask.id))[0];assert(proposed);check(true,'manual retry recovers failed durable extraction');
 await experts.decide(actor,proposed.id,proposed.revision,false);
 check((await experts.experiences(actor,retryExpert.id)).length===0,'rejected experience remains inactive');
 const turn=await runs.start(actor,retryTask.id,randomUUID(),'保留普通对话');await runs.finish(actor,turn,'completed',[{role:'assistant',content:'原始回复'}]);
 await experts.bind(actor,'tasks',retryTask.id,null,(await workspace.listTasks(actor)).find(t=>t.id===retryTask.id)!.revision);
 check(await transaction(db,async c=>(await c.query('SELECT context_revoked FROM workpivot.task_runs WHERE id=$1',[turn.id])).rows[0].context_revoked===false,actor),'switching expert preserves original conversation history');
 await workspace.deleteTask(actor,retryTask.id,(await workspace.listTasks(actor)).find(t=>t.id===retryTask.id)!.revision);
 await experts.remove(actor,retryExpert.id,retryExpert.revision);
}
