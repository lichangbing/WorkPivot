import { mkdtempSync, mkdirSync, writeFileSync, readFileSync, rmSync, symlinkSync, unlinkSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
const root = mkdtempSync(join(tmpdir(), 'wp14-'));
const workspace = join(root, 'workspace');
mkdirSync(workspace);
process.env['WORKPIVOT_HOME'] = join(root, 'home');
process.env['WORKPIVOT_WORKSPACE'] = workspace;
process.env['WORKPIVOT_INSECURE_SECRETS'] = '1';
process.env['WORKPIVOT_EXECUTION_MODE'] = 'trusted-local';
process.env['WORKPIVOT_HOST'] = '127.0.0.1';
const { registerFirstAdmin, createUser } = await import('../packages/server/src/auth.js');
const { createProject, ensureDefaultProject, updateProjectAccess } = await import('../packages/server/src/projects.js');
const { createTask } = await import('../packages/server/src/tasks.js');
const { taskFilePolicy } = await import('../packages/server/src/file-policy.js');
const { readTool, writeTool, lsTool, grepTool, findTool } = await import('../packages/core/src/tools.js');
const { parseSSEStream } = await import('../packages/core/src/model/sse.js');
const { buildMemoryTools, resolveMemoryConfirm } = await import('../packages/server/src/memory-tools.js');
const { readHandbook } = await import('../packages/server/src/memory.js');
const { listSkills } = await import('../packages/server/src/skills.js');
const results: boolean[] = [];
function assert(name: string, pass: boolean): void { results.push(pass); console.log(`${pass ? '✅' : '❌'} ${name}`); }
async function rejected(action: () => unknown): Promise<boolean> { try { await action(); return false; } catch { return true; } }
const links: string[] = [];
try {
  const admin = registerFirstAdmin('admin', 'stability-password').user;
  const member = createUser('member', 'stability-password', 'member');
  const other = createUser('other', 'stability-password', 'member');
  const shared = ensureDefaultProject();
  const secret = createProject('private', join(workspace, 'private'), admin.id);
  mkdirSync(secret.directory); writeFileSync(join(secret.directory, 'secret.txt'), 'PRIVATE-CONTENT');
  const task = createTask({ name: 'shared', directory: workspace, projectId: shared.id, ownerUserId: member.id });
  const temp = createTask({ name: 'temp', directory: join(workspace, '_temp', 'another'), temp: true, ownerUserId: other.id });
  writeFileSync(join(temp.directory, 'temp.txt'), 'TEMP-CONTENT');
  writeFileSync(join(workspace, 'normal.txt'), 'NORMAL-CONTENT');
  const policy = taskFilePolicy(task, admin.id);
  const ctx = { taskDir: workspace, filePolicy: policy, extraAllowedDirs: [secret.directory] };
  assert('RL2 默认根任务可读普通文件', (await readTool.run({ path: 'normal.txt' }, ctx)).includes('NORMAL-CONTENT'));
  assert('RL2 管理员代运行仍按任务所有者权限', !policy(join(secret.directory, 'secret.txt'), 'read'));
  assert('RL2 显式路径授权不能越过私有项目', await rejected(() => readTool.run({ path: 'private/secret.txt' }, ctx)));
  assert('RL2 私有项目拒绝写入', await rejected(() => writeTool.run({ path: 'private/new.txt', content: 'bad' }, ctx)));
  assert('RL2 ls 不显示私有项目', !(await lsTool.run({}, ctx)).includes('private'));
  assert('RL2 grep 不遍历私有项目和他人临时目录', !(await grepTool.run({ pattern: 'CONTENT' }, ctx)).match(/PRIVATE|TEMP/));
  assert('RL2 find 不返回私有文件', !(await findTool.run({ pattern: '*.txt' }, ctx)).match(/secret.txt|temp.txt/));
  assert('RL2 拒绝读取应用账户与密钥目录', !policy(join(root, 'home', 'data', 'users.json'), 'read'));
  const memory = join(workspace, '.workpivot', 'memory', 'MEMORY.md');
  mkdirSync(join(workspace, '.workpivot', 'memory'), { recursive: true }); writeFileSync(memory, 'shared-memory');
  assert('E06 项目成员可读记忆', policy(memory, 'read'));
  assert('E06 Agent 文件工具不能修改项目记忆', await rejected(() => writeTool.run({ path: memory, content: 'bad' }, ctx)));
  assert('E06 拒绝操作后记忆保持原内容', readFileSync(memory, 'utf8') === 'shared-memory');
  updateProjectAccess(shared.id, member.id, []);
  assert('E06 负责人交接后同一策略立即允许编辑', policy(memory, 'write'));
  updateProjectAccess(shared.id, admin.id, []);
  assert('E06 成员移出后同一策略立即拒绝所有文件', !policy(join(workspace, 'normal.txt'), 'read'));
  updateProjectAccess(shared.id, admin.id, [member.id]);
  const link = join(workspace, '.workpivot', 'skills');
  symlinkSync(secret.directory, link, process.platform === 'win32' ? 'junction' : 'dir'); links.push(link);
  mkdirSync(join(secret.directory, 'hidden')); writeFileSync(join(secret.directory, 'hidden', 'SKILL.md'), '---\nname: hidden\ndescription: PRIVATE-CONTENT\n---\nsecret');
  assert('RL2 项目技能链接不能注入私有项目内容', !listSkills(workspace, { projectFileAllowed: (path) => policy(path, 'read') }).some((s) => s.name === 'hidden'));
  const consume = async (body: ReadableStream<Uint8Array>, signal?: AbortSignal, timeout = 50): Promise<string[]> => {
    const lines: string[] = []; for await (const line of parseSSEStream(body, signal, timeout)) lines.push(line); return lines;
  };
  let cancelled = false;
  assert('RL4 模型停滞触发空闲超时', await rejected(() => consume(new ReadableStream({ cancel() { cancelled = true; } }))));
  assert('RL4 超时释放底层模型连接', cancelled);
  const controller = new AbortController(); cancelled = false;
  const stopped = consume(new ReadableStream({ cancel() { cancelled = true; } }), controller.signal, 10000);
  controller.abort();
  assert('RL4 停止可打断正在等待的模型流', await rejected(() => stopped));
  assert('RL4 停止释放底层连接', cancelled);
  const huge = new ReadableStream<Uint8Array>({ start(c) { c.enqueue(new Uint8Array(1024 * 1024 + 1)); } });
  assert('RL4 无换行超大模型响应被中止', await rejected(() => consume(huge)));
  const encoded = new TextEncoder().encode('data: 正常\n\ndata: [DONE]\n');
  const split = new ReadableStream<Uint8Array>({ start(c) { for (const byte of encoded) c.enqueue(Uint8Array.of(byte)); c.close(); } });
  assert('RL4 UTF8 分片解析完整', JSON.stringify(await consume(split)) === JSON.stringify(['正常', '[DONE]']));
  const events: Array<{ type: string; id: string }> = [];
  const promote = buildMemoryTools(member.id, task.id, (event) => events.push(event as { type: string; id: string })).find((t) => t.name === 'promote_memory')!;
  const stop = new AbortController();
  const pending = promote.run({ content: 'must-not-write' }, { taskDir: workspace, signal: stop.signal });
  const id = events.find((event) => event.type === 'memory_confirm')!.id;
  assert('RL4 记忆确认拒绝其他任务', !resolveMemoryConfirm(id, true, { taskId: temp.id, userId: member.id, role: 'member' }));
  assert('RL4 记忆确认拒绝其他用户', !resolveMemoryConfirm(id, true, { taskId: task.id, userId: other.id, role: 'member' }));
  stop.abort(); await pending;
  assert('RL4 停止后清理记忆确认卡', events.some((event) => event.type === 'memory_resolved' && event.id === id));
  assert('RL4 停止后旧确认不能写入', !resolveMemoryConfirm(id, true, { taskId: task.id, userId: member.id, role: 'member' }) && !readHandbook(member.id).includes('must-not-write'));
  const approved = promote.run({ content: 'approved-memory' }, { taskDir: workspace });
  const id2 = events.filter((event) => event.type === 'memory_confirm').at(-1)!.id;
  assert('RL4 本人确认正常通过', resolveMemoryConfirm(id2, true, { taskId: task.id, userId: member.id, role: 'member' }));
  await approved;
  assert('RL4 确认后只写入本人长期记忆', readHandbook(member.id).includes('approved-memory') && !readHandbook(other.id).includes('approved-memory'));
  const { checkService } = await import('./W14-service.mjs');
  await checkService(assert);
} catch (err) { console.error(err); assert('执行无未捕获异常', false); }
finally { for (const link of links) unlinkSync(link); rmSync(root, { recursive: true, force: true }); }
console.log(`\n===== W14 冒烟：${results.filter(Boolean).length}/${results.length} 通过 =====`);
process.exit(results.every(Boolean) ? 0 : 1);
