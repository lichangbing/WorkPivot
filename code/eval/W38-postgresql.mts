import assert from 'node:assert/strict';
import { randomBytes, randomUUID } from 'node:crypto';
import { pool, transaction, installSchema, assertRestrictedRole, RepositoryError } from '../packages/server/src/database/connection.js';
import { AccountRepository } from '../packages/server/src/database/accounts.js';
import { WorkspaceRepository } from '../packages/server/src/database/workspace.js';
import { createDatabaseApp } from '../packages/server/src/database/app.js';

const url = process.env['WORKPIVOT_TEST_PG_URL'];
if (!url || process.env['WORKPIVOT_TEST_PG_DISPOSABLE'] !== '1') throw Error('Requires an explicitly disposable PostgreSQL instance');
const admin = pool(url);
const appPassword = randomBytes(24).toString('hex'), authPassword = randomBytes(24).toString('hex');
// Dedicated instance owned by this fixture; never point this test at business databases.
await admin.query(`CREATE ROLE wp_test_app LOGIN PASSWORD '${appPassword}' NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS;
 CREATE ROLE wp_test_auth LOGIN PASSWORD '${authPassword}' NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS`);
const appUrl = new URL(url); appUrl.username = 'wp_test_app'; appUrl.password = appPassword;
const authUrl = new URL(url); authUrl.username = 'wp_test_auth'; authUrl.password = authPassword;
const business = pool(appUrl.toString(), { max: 2 }), identity = pool(authUrl.toString(), { max: 2 });
let checks = 0;
const check = (condition: unknown, name: string): void => { assert.ok(condition, name); checks++; console.log('✅ ' + name); };
async function rejects(action: () => Promise<unknown>, name: string, status?: number): Promise<void> {
  await assert.rejects(action, status === undefined ? undefined : e => e instanceof RepositoryError && e.status === status); checks++; console.log('✅ ' + name);
}
let server: ReturnType<Awaited<ReturnType<typeof createDatabaseApp>>['listen']> | undefined;
try {
  await installSchema(admin, 'wp_test_app', 'wp_test_auth');
  await installSchema(admin, 'wp_test_app', 'wp_test_auth');
  check((await admin.query('SELECT count(*)::int AS n FROM workpivot_meta.schema_versions')).rows[0].n === 1, 'schema installation idempotent');
  await assertRestrictedRole(business, 'workpivot'); await assertRestrictedRole(identity, 'identity');
  await rejects(() => assertRestrictedRole(admin, 'workpivot'), 'superuser runtime rejected');
  await rejects(() => business.query('SELECT * FROM identity.credentials'), 'business pool cannot read password hashes');
  await rejects(() => identity.query('SELECT * FROM workpivot.projects'), 'identity pool cannot read private projects');
  const accounts = new AccountRepository(identity), workspace = new WorkspaceRepository(business), init = randomBytes(24).toString('hex');
  check(await accounts.needsSetup(), 'fresh database requires setup');
  await rejects(() => accounts.registerFirst('admin', 'admin-password', 'bad', init), 'invalid initialization rejected', 403);
  const registered = await Promise.allSettled([accounts.registerFirst('admin', 'admin-password', init, init), accounts.registerFirst('admin-other', 'admin-password', init, init)]);
  check(registered.filter(r => r.status === 'fulfilled').length === 1, 'concurrent initialization creates exactly one administrator');
  const first = registered.find(r => r.status === 'fulfilled'); if (!first || first.status !== 'fulfilled') throw Error('Initialization failed');
  const owner = first.value;
  check(!await accounts.needsSetup(), 'registration closes after initialization');
  const member = await accounts.createUser(owner.token, 'member', 'temporary-password', 'member');
  const other = await accounts.createUser(owner.token, 'other', 'temporary-password', 'member');
  const secondary = await accounts.createUser(owner.token, 'second-admin', 'temporary-password', 'admin');
  await rejects(() => accounts.createUser(owner.token, 'MEMBER', 'password-new', 'member'), 'case-normalized duplicate rejected', 409);
  const temporary = await accounts.login('member', 'temporary-password');
  check(temporary.user.mustChangePassword, 'new member must change temporary password');
  await accounts.changePassword(temporary.token, 'temporary-password', 'personal-password');
  check(await accounts.resolve(temporary.token) === null, 'password change revokes old token');
  const login = await accounts.login('member', 'personal-password');
  check(!login.user.mustChangePassword, 'new password clears required change');
  await rejects(() => accounts.listUsers(login.token), 'member cannot list accounts', 403);
  const raw = await admin.query('SELECT token_digest FROM identity.sessions');
  check(raw.rows.every(r => /^[a-f0-9]{64}$/.test(r.token_digest) && r.token_digest !== login.token), 'only token digests persisted');
  const privateProject = await workspace.createProject(member.id, 'Private project');
  const adminProject = await workspace.createProject(owner.user.id, 'Admin project');
  check((await workspace.listProjects(owner.user.id)).every(p => p.id !== privateProject.id), 'application administrator cannot read another user project');
  check((await workspace.listProjects(member.id)).length === 1, 'owner sees own project');
  check((await transaction(business, c => c.query('SELECT id FROM workpivot.projects'))).rowCount === 0, 'missing actor context returns no private rows');
  await rejects(() => transaction(business, c => c.query('INSERT INTO workpivot.projects(id,owner_user_id,name,workspace_key) VALUES($1,$2,$3,$4)', [randomUUID(), member.id, 'forged', randomUUID()]), owner.user.id), 'RLS rejects forged owner');
  await rejects(() => workspace.createTask(owner.user.id, 'forged task', privateProject.id), 'cross-user project association rejected', 404);
  check((await admin.query('SELECT count(*)::int AS n FROM workpivot.project_members')).rows[0].n === 2, 'project creation includes owner membership transactionally');
  const rename = await Promise.allSettled([workspace.renameProject(member.id, privateProject.id, 'One', 1), workspace.renameProject(member.id, privateProject.id, 'Two', 1)]);
  check(rename.filter(r => r.status === 'fulfilled').length === 1 && rename.some(r => r.status === 'rejected' && r.reason.status === 409), 'concurrent project edits produce one conflict');
  await rejects(() => workspace.renameProject(owner.user.id, privateProject.id, 'leak', 2), 'foreign update indistinguishable from missing', 404);
  const task = await workspace.createTask(member.id, 'Research', privateProject.id);
  const before = (await workspace.listTasks(member.id)).length;
  await rejects(() => transaction(business, async c => { await c.query("INSERT INTO workpivot.tasks(id,owner_user_id,name) VALUES($1,$2,'rollback')", [randomUUID(), member.id]); throw Error('simulate'); }, member.id), 'failed transaction propagates');
  check((await workspace.listTasks(member.id)).length === before, 'failed transaction rolls back writes');
  check((await transaction(business, c => c.query('SELECT id FROM workpivot.tasks'))).rowCount === 0, 'connection reuse clears identity after rollback');
  const requestId = randomUUID();
  const duplicate = await Promise.all([workspace.appendMessage(member.id, task.id, 'user', 'hello', requestId), workspace.appendMessage(member.id, task.id, 'user', 'hello', requestId)]);
  check(duplicate[0].id === duplicate[1].id, 'duplicate concurrent message appended once');
  await rejects(() => workspace.appendMessage(member.id, task.id, 'user', 'changed', requestId), 'same request with changed payload rejected', 409);
  await Promise.all(Array.from({ length: 8 }, (_, i) => workspace.appendMessage(member.id, task.id, 'user', 'message-' + i, randomUUID())));
  const messages = await workspace.messages(member.id, task.id);
  check(messages.length === 9 && messages.every((m, i) => m.sequence === String(i + 1)), 'concurrent messages have stable gap-free sequence');
  check((await workspace.messages(member.id, task.id, '4', 2)).map(m => m.sequence).join(',') === '5,6', 'message cursor pagination');
  await rejects(() => workspace.messages(owner.user.id, task.id), 'administrator cannot read member messages', 404);
  await workspace.saveSetting(member.id, 'memory.auto', { task: true }, 0);
  check(await workspace.setting(owner.user.id, 'memory.auto') === null, 'settings isolated');
  await rejects(() => workspace.saveSetting(member.id, 'memory.auto', {}, 0), 'settings revision conflict', 409);
  for (const [scope, scopeId] of [['user', undefined], ['project', privateProject.id], ['task', task.id]] as const) {
    const m = await workspace.createMemory(member.id, scope + ' memory', scope, scopeId);
    check((await workspace.readMemory(member.id, m.id))?.content === scope + ' memory', scope + ' memory persists');
  }
  await rejects(() => workspace.createMemory(owner.user.id, 'forged', 'project', privateProject.id), 'cross-user project memory rejected', 404);
  const memory = await workspace.createMemory(member.id, 'version one', 'project', privateProject.id);
  await workspace.editMemory(member.id, memory.id, 'version two', 1);
  await rejects(() => workspace.editMemory(member.id, memory.id, 'stale', 1), 'stale memory write conflicts', 409);
  check(await workspace.readMemory(owner.user.id, memory.id) === null, 'administrator cannot read member memory');
  const racing = await Promise.allSettled([workspace.deleteMemory(member.id, memory.id, 2), workspace.editMemory(member.id, memory.id, 'racing', 2)]);
  check(racing.filter(r => r.status === 'fulfilled').length === 1, 'delete and edit cannot both publish');
  const still = await workspace.readMemory(member.id, memory.id); if (still) await workspace.deleteMemory(member.id, memory.id, still.revision);
  check(await workspace.readMemory(member.id, memory.id) === null, 'deleted memory unavailable');
  check((await admin.query('SELECT count(*)::int AS n FROM workpivot.memory_revisions WHERE memory_id=$1', [memory.id])).rows[0].n === 0, 'deleted online history removed');
  check((await admin.query('SELECT count(*)::int AS n FROM workpivot.forget_rules WHERE memory_id=$1', [memory.id])).rows[0].n === 1, 'deletion tombstone retained without plaintext');
  await rejects(() => workspace.editMemory(member.id, memory.id, 'resurrection', 3), 'deleted memory cannot be resurrected', 404);
  check((await admin.query("SELECT count(*)::int AS n FROM workpivot.outbox_events WHERE entity_id=$1 AND kind='memory_deleted'", [memory.id])).rows[0].n === 1, 'deletion cleanup event committed');
  const reset = await accounts.resetPassword(owner.token, member.id);
  check(await accounts.resolve(login.token) === null, 'reset revokes existing sessions');
  await rejects(() => accounts.login('member', 'personal-password'), 'reset invalidates old password', 401);
  const resetSession = await accounts.login('member', reset.temporaryPassword);
  check(resetSession.user.mustChangePassword, 'reset requires password change');
  const isolated = await accounts.login('other', 'temporary-password');
  check(!!await accounts.resolve(isolated.token), 'other account unaffected');
  const web = await createDatabaseApp(identity, business, init);
  server = web.listen(0, '127.0.0.1'); await new Promise<void>(r => server!.once('listening', r));
  const addr = server.address(); if (!addr || typeof addr === 'string') throw Error('No port');
  const base = `http://127.0.0.1:${addr.port}/api`;
  const http = (path: string, token?: string, body?: unknown, method = body === undefined ? 'GET' : 'POST') => fetch(base + path, { method, headers: { ...(token ? { Authorization: 'Bearer ' + token } : {}), 'Content-Type': 'application/json' }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
  check((await http('/projects')).status === 401, 'HTTP rejects guest');
  check((await http('/projects', resetSession.token)).status === 403, 'HTTP blocks temporary member business access');
  const secondarySession = await accounts.login('second-admin', 'temporary-password');
  check((await http('/users', secondarySession.token)).status === 403, 'HTTP blocks temporary administrator management access');
  check((await http('/auth/password', resetSession.token, { currentPassword: reset.temporaryPassword, newPassword: 'final-password' })).ok, 'HTTP password update uses database');
  const finalSession = await accounts.login('member', 'final-password');
  const listed = await (await http('/projects', owner.token)).json() as { projects: { id: string }[] };
  check(listed.projects.length === 1 && listed.projects[0]!.id === adminProject.id, 'HTTP admin cannot enumerate private projects');
  check((await http('/tasks', owner.token, { name: 'forged', projectId: privateProject.id, ownerUserId: member.id })).status === 404, 'HTTP ignores client-supplied owner');
  check((await http('/tasks/' + task.id + '/messages', finalSession.token, { content: 'run' })).status === 503, 'unported agent route fails explicitly, no legacy fallback');
  await accounts.logout(finalSession.token);
  check((await http('/projects', finalSession.token)).status === 401, 'HTTP logout invalidates session');
  const reopened = pool(appUrl.toString());
  try { check((await new WorkspaceRepository(reopened).listProjects(member.id)).length === 1, 'new connection reads committed data'); } finally { await reopened.end(); }
  await admin.query("UPDATE workpivot_meta.schema_versions SET checksum='tampered'");
  await rejects(() => installSchema(admin, 'wp_test_app', 'wp_test_auth'), 'schema checksum drift refused');
  console.log(`W38 PostgreSQL: ${checks}/${checks} passed`);
  void other; void secondary;
} finally {
  if (server) { server.closeAllConnections(); await new Promise<void>(r => server!.close(() => r())); }
  await Promise.all([business.end(), identity.end(), admin.end()]);
}
