import assert from 'node:assert/strict';
import {randomUUID} from 'node:crypto';
import {createServer} from 'node:http';
import {mkdtemp,rm} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import type {Pool} from 'pg';
import {SkillBuilds} from '../packages/server/src/database/skill-builds.js';
import {DatabaseSkills} from '../packages/server/src/database/skills.js';
import {WorkspaceRepository} from '../packages/server/src/database/workspace.js';
import {FileRepository} from '../packages/server/src/database/files.js';
import {transaction} from '../packages/server/src/database/connection.js';
import {RunRepository} from '../packages/server/src/database/runs.js';

export async function testSkillBuilds(db:Pool,actor:string,other:string,check:(v:unknown,n:string)=>void){
 const w=new WorkspaceRepository(db),skills=new DatabaseSkills(db),runs=new RunRepository(db);
 const root=await mkdtemp(join(tmpdir(),'wp-build-')),files=new FileRepository(db,root);
 let requests=0,mode='pass',release:()=>void=()=>undefined;
 const fixture=createServer(async(req,res)=>{
  let raw='';for await(const part of req)raw+=part;
  requests++;const body=JSON.parse(raw);
  if(mode==='wait')await new Promise<void>(r=>{release=r;});
  if(mode==='fail'){res.writeHead(400,{'content-type':'application/json'});res.end(JSON.stringify({error:'合成断言失败'}));return;}
  res.setHeader('content-type','application/json');res.end(JSON.stringify({output:'合成测试输出',files:[['result.json',Buffer.from('{"total":30}').toString('base64')]]}));
  assert.ok(Array.isArray(body.skills)&&Array.isArray(body.files));
 });
 fixture.listen(0,'127.0.0.1');await new Promise<void>(r=>fixture.once('listening',r));
 const addr=fixture.address();if(!addr||typeof addr==='string')throw Error('测试执行器启动失败');
 const builds=new SkillBuilds(db,files,{url:`http://127.0.0.1:${addr.port}`,token:'fixture'}),offline=new SkillBuilds(db,files);
 const task=await w.createTask(actor,'技能构建隔离验收'),foreignTask=await w.createTask(other,'另一个用户技能');
 const baseFiles=[{path:'SKILL.md',content:'---\nname: sample\ndescription: 计算合成样本并检查结果\n---\n\n# 用途\n处理指定样本。\n# 输入输出\n输入数据，输出结果。\n# 步骤\n按规则处理并验证。'}];
 const args=()=>({requestId:randomUUID(),displayName:'日报技能',purpose:'合成测试方法',files:baseFiles});
 try{
  let draft=await builds.propose(actor,task.id,args());
  check(draft.status==='draft'&&!draft.published&&draft.name.startsWith('p-'),'私人技能持久草稿及服务器分配内部身份');
  check(draft.files[0]?.content?.includes('name: '+draft.name),'服务器规范化技能内部名称');
  await assert.rejects(()=>builds.propose(actor,task.id,{...args(),files:[...baseFiles,{path:'references/key.txt',content:'sk-'+ 'a'.repeat(32)}]}));check(true,'疑似密钥不能保存进技能资源');
  const sameName=await builds.propose(other,foreignTask.id,args());check(sameName.name!==draft.name&&sameName.displayName===draft.displayName,'跨用户同显示名互不覆盖');
  await assert.rejects(()=>builds.detail(other,draft.id));check(true,'其他用户包括应用管理员不能读取私人草稿');
  const count=await transaction(db,async c=>(await c.query('SELECT id FROM workpivot.skill_builds WHERE id=$1',[draft.id])).rowCount,other);check(count===0&&!(await builds.list(other)).some(b=>b.name===draft.name),'构建行级权限及模型目录摘要阻止跨用户读取');
  check(!(await skills.market(actor)).some(v=>v.name===draft.name),'未确认草稿不出现在可用目录');
  await assert.rejects(()=>builds.decide(actor,draft.id,draft.revision,'activate',draft.hash));check(true,'未校验草稿不能启用');
  draft=await builds.validate(actor,draft.id,draft.revision);check(draft.status==='ready'&&draft.validation?.valid,'正文型技能可完成结构验证待确认');
  await builds.decide(actor,draft.id,draft.revision,'dismiss');check((await builds.detail(actor,draft.id)).dismissed,'关闭窗口持久保存稍后处理状态');
  check(!(await skills.market(actor)).some(v=>v.name===draft.name),'关闭窗口不会加载技能');
  await assert.rejects(()=>builds.decide(actor,draft.id,draft.revision,'activate','oldhash'));check(true,'确认绑定内容哈希');
  const confirmed=await Promise.all([builds.decide(actor,draft.id,draft.revision,'activate',draft.hash),builds.decide(actor,draft.id,draft.revision,'activate',draft.hash)]);
  check(confirmed[0].releaseId===confirmed[1].releaseId,'并发确认只生成一个发布版本');
  check((await skills.market(actor)).find(v=>v.name===draft.name)?.loaded,'确认原子发布并加载私人技能');
  check((await builds.export(actor,draft.id)).length>0,'所有者可导出标准ZIP技能包');await assert.rejects(()=>builds.export(other,draft.id));check(true,'技能ZIP导出不能越权');
  check(!(await skills.market(other)).some(v=>v.name===draft.name),'私人发布版本不进入其他用户市场');
  check((await transaction(db,c=>c.query('SELECT id FROM workpivot.skill_releases WHERE name=$1',[draft.name]),other)).rowCount===0,'私人发布正文直接SQL不可越权');
  await assert.rejects(()=>skills.publish(actor,draft.name,draft.revision));await assert.rejects(()=>skills.rollback(actor,draft.name,confirmed[0].releaseId!,draft.revision));await assert.rejects(()=>skills.toggle(actor,draft.name,false));check(true,'旧管理接口不能绕过私人确认');
  const loadedTool=skills.tools(actor,new Map([[draft.name,confirmed[0].releaseId!]]))[0]!;
  check(JSON.parse(await loadedTool.run({name:draft.name},{taskDir:'.'})).content.includes('处理指定样本'),'确认后通过受控工具按需读取');
  const request=args(),first=await builds.propose(actor,task.id,request),duplicate=await builds.propose(actor,task.id,request);check(first.id===duplicate.id,'草稿生成请求重试幂等');
  await assert.rejects(()=>builds.propose(actor,task.id,{...request,purpose:'不同内容'}));check(true,'同请求标识的不同内容拒绝覆盖');
  await assert.rejects(()=>builds.propose(actor,task.id,{...args(),files:[...baseFiles,{path:'../bad',content:'bad'}]}));check(true,'生成文件树阻止路径穿越');
  await assert.rejects(()=>builds.propose(actor,foreignTask.id,args()));check(true,'不能在其他用户任务生成技能');
  const scripted=[...baseFiles,{path:'scripts/calc.cjs',content:'module.exports = values => values.reduce((n,v)=>n+v,0);'},{path:'tests/run.cjs',content:"const assert=require('node:assert/strict');const calc=require('../scripts/calc.cjs');assert.equal(calc([10,20]),30);require('node:fs').writeFileSync('/workspace/result.json',JSON.stringify({total:30}));"}];
  let code=await builds.propose(actor,task.id,{...args(),files:scripted});code=await builds.validate(actor,code.id,code.revision);
  check(code.requiresTrial&&code.status==='draft','脚本和测试文件必须经独立试运行');
  await assert.rejects(()=>offline.trial(actor,code.id,code.revision,{command:'true'}));check(true,'无执行器明确失败且不伪造通过');
  const command=`node /skills/${code.name}/tests/run.cjs`;
  await assert.rejects(()=>builds.trial(actor,code.id,code.revision,{command:'true'}));
  mode='fail';code=await builds.trial(actor,code.id,code.revision,{command});check(!code.trial?.passed&&code.status==='draft'&&code.trial?.error?.includes('断言失败'),'失败测试保留真实报告并阻止启用');
  await assert.rejects(()=>builds.decide(actor,code.id,code.revision,'activate',code.hash));check(true,'测试失败不能确认启用');
  mode='pass';code=await builds.trial(actor,code.id,code.revision,{command,outputs:['result.json']});check(code.trial?.passed&&code.trial.previews[0]?.content==='{"total":30}'&&code.status==='ready','草稿快照试运行报告及指定输出预览');
  check(!(await skills.market(actor)).some(v=>v.name===code.name),'试运行不偷偷发布或加载');
  const oldRevision=code.revision,oldHash=code.hash;
  code=await builds.revise(actor,code.id,code.revision,{files:scripted.map(f=>({...f,content:f.content+'\n'}))});check(code.revision!==oldRevision&&!code.validation&&!code.trial,'草稿修改撤销旧测试报告');
  await assert.rejects(()=>builds.decide(actor,code.id,oldRevision,'activate',oldHash));check(true,'旧窗口不能确认修改后草稿');
  code=await builds.validate(actor,code.id,code.revision);
  mode='wait';const pending=builds.trial(actor,code.id,code.revision,{command});
  while(requests<3)await new Promise(r=>setTimeout(r,5));await new Promise(r=>setTimeout(r,30));
  const revised=await builds.revise(actor,code.id,code.revision,{files:scripted});release();await assert.rejects(pending);mode='pass';check(!(await builds.detail(actor,code.id)).trial,'测试过程中修改草稿拒绝迟到报告');code=revised;
  await transaction(db,c=>c.query("UPDATE workpivot.skill_trials SET status='interrupted' WHERE build_id=$1 AND status='running'",[code.id]),actor);
  code=await builds.validate(actor,code.id,code.revision);
  const input=await files.upload(actor,task.id,'sample.txt',Buffer.from('合成输入'),randomUUID());
  code=await builds.trial(actor,code.id,code.revision,{command,inputs:[input.id]});await files.remove(actor,task.id,input.documentId,input.revision);
  await assert.rejects(()=>builds.decide(actor,code.id,code.revision,'activate',code.hash));check(true,'试运行输入删除后确认失效');
  const rebound=await builds.fromRelease(actor,draft.id,draft.draftRevision,confirmed[0].releaseId);
  let newer=await builds.revise(actor,rebound.id,rebound.revision,{files:baseFiles.map(f=>({...f,content:f.content+'\n新增已确认的方法。'}))});newer=await builds.validate(actor,newer.id,newer.revision);
  await builds.decide(actor,newer.id,newer.revision,'activate',newer.hash);
  const before=JSON.parse(await loadedTool.run({name:draft.name},{taskDir:'.'}));check(!before.content.includes('新增已确认'),'在途已加载版本不被新版替换');
  check((await builds.detail(actor,newer.id)).versions.length===2,'修订保留不可变历史版本');
  await builds.lifecycle(actor,newer.id,newer.draftRevision,'delete');
  check(!(await skills.market(actor)).some(v=>v.name===draft.name),'删除阻止目录发现及新执行');await assert.rejects(()=>loadedTool.run({name:draft.name},{taskDir:'.'}));check(true,'删除后已有运行不能继续读取技能');
  const deleted=await builds.detail(actor,newer.id);check(deleted.deleted&&deleted.versions.length===2,'软删除保留可恢复版本');await builds.lifecycle(actor,newer.id,deleted.draftRevision,'restore');const restored=await builds.detail(actor,newer.id);check(!restored.deleted&&restored.disabled&&restored.status==='stale','恢复保持停用且旧确认失效');
  const listingRun=await runs.start(actor,task.id,randomUUID(),'查看自己的技能摘要');const tools=builds.tools(actor,task.id,()=>listingRun);const listed=JSON.parse(await tools.find(t=>t.name==='list_my_skill_builds')!.run({},{taskDir:'.'}));await runs.finish(actor,listingRun,'completed',[]);check(!tools.some(t=>/activate|publish/.test(t.name))&&tools.some(t=>t.name==='trial_skill_draft')&&listed.skills.every((b:{name:string;files?:unknown})=>b.name!==sameName.name&&!b.files),'模型目录只返回本人摘要，构建和测试工具无发布启用能力');
  const replyFailureTask=await w.createTask(actor,'模型回复失败但草稿已验证'),replyRun=await runs.start(actor,replyFailureTask.id,randomUUID(),'创建说明型技能');
  let replyDraft=await builds.propose(actor,replyFailureTask.id,args(),replyRun);replyDraft=await builds.validate(actor,replyDraft.id,replyDraft.revision);await runs.finish(actor,replyRun,'error',[]);await builds.decide(actor,replyDraft.id,replyDraft.revision,'activate',replyDraft.hash);check(true,'模型后续回复失败不丢失已验证且用户确认的草稿');
  const stoppedTask=await w.createTask(actor,'停止后不允许启用'),stoppedRun=await runs.start(actor,stoppedTask.id,randomUUID(),'创建技能');let stoppedDraft=await builds.propose(actor,stoppedTask.id,args());stoppedDraft=await builds.revise(actor,stoppedDraft.id,stoppedDraft.revision,{files:baseFiles},stoppedTask.id,stoppedRun);stoppedDraft=await builds.validate(actor,stoppedDraft.id,stoppedDraft.revision);await runs.stop(actor,stoppedTask.id);await runs.finish(actor,stoppedRun,'aborted',[]);await assert.rejects(()=>builds.decide(actor,stoppedDraft.id,stoppedDraft.revision,'activate',stoppedDraft.hash));check(true,'用户停止的来源运行不能启用草稿');
  const sourceTask=await w.createTask(actor,'来源撤回验收'),run=await runs.start(actor,sourceTask.id,randomUUID(),'将此任务方法保存为技能');
  const sourced=await builds.propose(actor,sourceTask.id,args(),run);await runs.finish(actor,run,'completed',[]);await w.deleteTask(actor,sourceTask.id,(await w.listTasks(actor)).find(t=>t.id===sourceTask.id)!.revision);
  const stale=await builds.detail(actor,sourced.id);check(stale.status==='stale','来源对话删除后草稿失效且构建记录保留');
  await assert.rejects(()=>builds.validate(actor,sourced.id,sourced.revision));check(true,'删除来源不能重新校验启用');
 }finally{fixture.closeAllConnections();await new Promise<void>(r=>fixture.close(()=>r()));await rm(root,{recursive:true,force:true});}
}
