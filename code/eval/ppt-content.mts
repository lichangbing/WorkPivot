import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {mkdtemp,writeFile,readFile,rm} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import {execFileSync} from 'node:child_process';
import {parserProgram,validateParsedDocument} from '../packages/server/src/database/document-parser.js';
import {readStructurePage} from '../packages/server/src/database/document-structure.js';
import {splitKnowledge} from '../packages/server/src/database/knowledge.js';
const require=createRequire(new URL('../packages/server/package.json',import.meta.url));
const Zip=require('adm-zip'),Pptx=require('pptxgenjs');
const root=await mkdtemp(join(tmpdir(),'wp-ppt-content-'));let count=0;
const check=(ok:unknown,label:string)=>{assert.ok(ok,label);count++;console.log('通过：'+label);};
try {
 await writeFile(join(root,'parse.py'),parserProgram.replaceAll('/workspace',root));
 const ppt=new Pptx();const slide=ppt.addSlide();slide.addText('正文',{x:1,y:1,w:3,h:1});
 slide.addChart(ppt.ChartType.bar,[{name:'销售额',labels:['华东','华北'],values:[120,80]}],{x:1,y:2,w:5,h:3});slide.addNotes('只在备注出现的决策');
 const source=Buffer.from(await ppt.write({outputType:'nodebuffer'}));
 const parse=async(data:Buffer)=>{await writeFile(join(root,'source.pptx'),data);execFileSync('python3',[join(root,'parse.py'),'.pptx'],{timeout:10000,stdio:'pipe'});return validateParsedDocument(JSON.parse(await readFile(join(root,'parsed.json'),'utf8')));};
 const parsed=await parse(source),point=parsed.parts.find(p=>p.object?.kind==='chart-point')!;
 check(point.text.includes('华东')&&point.text.includes('120')&&point.text.includes('销售额'),'图表点同时保留系列分类数值');
 check(parsed.parts.filter(p=>p.object?.kind==='notes').some(p=>p.text.includes('只在备注出现')),'备注按幻灯片读取');
 check(parsed.warnings.some(w=>w.includes('缓存'))&&parsed.coverage==='partial','缓存边界显式提示');
 check(readStructurePage(parsed.parts,{parent:point.object!.parent}).items.length===2,'图表结构可按父对象分页读取');
 check(splitKnowledge(parsed.parts).some(p=>p.content.includes('华东')&&p.content.includes('120')),'图表知识片段保留行语义');
 const modify=(name:string,fn:(s:string)=>string)=>{const zip=new Zip(source);zip.updateFile(name,Buffer.from(fn(zip.readAsText(name))));return zip.toBuffer();};
 const rel='ppt/slides/_rels/slide1.xml.rels',chart='ppt/charts/chart1.xml';
 const sparse=await parse(modify(chart,s=>s.replace(/<c:pt idx="0"><c:v>120<\/c:v><\/c:pt>/,'')));
 check(sparse.parts.some(p=>p.object?.kind==='chart-point'&&p.text.includes('华东')&&p.text.includes('数值：缺失')),'稀疏缓存不将下一行数值错误前移');
 const external=await parse(modify(rel,s=>s.replace(/Target="\/ppt\/charts\/chart1.xml"/,'Target="https://example.invalid/chart.xml" TargetMode="External"')));
 check(!external.parts.some(p=>p.object?.kind==='chart')&&external.warnings.some(w=>w.includes('外部')),'外部图表只警告不访问');
 const missing=await parse(modify(chart,s=>s.replace(/<c:numCache>[\s\S]*?<\/c:numCache>/g,'')));
 check(missing.parts.filter(p=>p.object?.kind==='chart-point').every(p=>p.text.includes('数值：缺失')),'无数值缓存不使用公式或工作簿猜值');
 await assert.rejects(parse(modify(rel,s=>s.replace('/ppt/charts/chart1.xml','../../../escape.xml'))));count++;
 const orphan=new Zip(source);orphan.addFile('ppt/notesSlides/orphan.xml',Buffer.from('<notes><p><t>孤立机密标识</t></p></notes>'));
 check(!(await parse(orphan.toBuffer())).parts.some(p=>p.text.includes('孤立机密标识')),'未引用备注不进入正文或知识索引');
 const many=await parse(modify('ppt/slides/slide1.xml',s=>s.replace(/<c:chart\b[^>]*\/>/,m=>m.repeat(60))));
 check(many.warnings.length===100&&many.warnings.at(-1)?.includes('另有'),'多图表警告有界且明确未展示数量');
 console.log(`PPT图表备注：${count}/${count}通过`);
} finally {await rm(root,{recursive:true,force:true});}
