{
  "name": "workpivot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p packages/shared && tsc -p packages/core && tsc -p packages/server && tsc -p apps/web && tsc -p apps/desktop",
    "lint": "eslint .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "dev:web": "pnpm --filter @workpivot/web dev",
    "eval:w1": "tsx eval/W1-smoke.mts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
