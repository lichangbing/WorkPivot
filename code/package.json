{
  "name": "workpivot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p packages/shared && tsc -p packages/core && tsc -p packages/server && tsc -p apps/web && tsc -p apps/desktop && tsc -p apps/mobile",
    "lint": "eslint .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:licenses:strict": "node scripts/check-licenses.mjs --strict",
    "check:docs": "node ../scripts/check-docs.mjs",
    "test:licenses": "node eval/license-check.mjs",
    "eval:chat-state": "tsx eval/W39-database-chat-state.mts",
    "dev:web": "pnpm --filter @workpivot/web dev",
    "dev:mobile": "pnpm --filter @workpivot/mobile dev",
    "build:mobile": "pnpm --filter @workpivot/mobile build",
    "eval:mobile": "tsx eval/mobile-foundation.mts",
    "eval:mobile-artifacts": "tsx eval/mobile-artifacts.mts",
    "eval:automatic-memory": "tsx eval/automatic-memory.mts",
    "eval:automatic-memory-db": "tsx eval/automatic-memory-db.mts",
    "eval:workspace-sync": "tsx eval/workspace-sync.mts",
    "eval:business-facts-db": "node scripts/test-business-facts.mjs",
    "eval:w1": "tsx eval/W1-smoke.mts",
    "eval:w2": "tsx eval/W2-smoke.mts",
    "eval:w3": "tsx eval/W3-smoke.mts",
    "check:deps": "depcruise apps/web --config .dependency-cruiser.cjs",
    "eval": "tsx eval/run-all.mts",
    "eval:w4": "tsx eval/W4-smoke.mts",
    "eval:w5": "tsx eval/W5-memory.mts",
    "eval:w6": "tsx eval/W6-structure.mts",
    "eval:w7": "tsx eval/W7-file.mts",
    "eval:w8": "tsx eval/W8-anthropic.mts",
    "eval:w9": "tsx eval/W9-office.mts",
    "eval:w10": "tsx eval/W10-schedule.mts",
    "eval:w11": "tsx eval/W11-authz.mts",
    "eval:w12": "tsx eval/W12-boundary.mts",
    "eval:w13": "tsx eval/W13-session.mts",
    "eval:w14": "tsx eval/W14-stability.mts",
    "eval:sandbox": "tsx eval/W15-sandbox.mts",
    "eval:client": "tsx eval/W16-client.mts",
    "eval:connection": "tsx eval/W17-connection.mts",
    "eval:capabilities": "tsx eval/W18-capabilities.mts",
    "eval:skills": "tsx eval/W20-skills.mts",
    "eval:worker": "node eval/W21-worker.mjs",
    "eval:run-code-local": "node --import tsx eval/run-code-local.mts",
    "eval:run-code-execution": "node --import tsx eval/run-code-execution.mts",
    "eval:worker-recovery": "node eval/worker-recovery.mjs",
    "eval:worker-client": "tsx eval/W22-worker-client.mts",
    "eval:skill-build": "node scripts/test-skill-build.mjs",
    "eval:database": "node scripts/test-postgres.mjs",
    "eval:service-recovery": "node scripts/test-service-recovery.mjs",
    "eval:browser-workflow": "node scripts/test-rc-browser.mjs --workflow",
    "backup:create": "tsx scripts/workpivot-backup.mts create",
    "backup:verify": "tsx scripts/workpivot-backup.mts verify",
    "backup:restore": "tsx scripts/workpivot-backup.mts restore",
    "eval:backup": "tsx eval/backup-package.mts",
    "eval:backup-database": "node scripts/test-backup-database.mjs",
    "db:install": "tsx scripts/postgres-schema.mts",
    "chat:install": "tsx scripts/chat-schema.mts",
    "dev:database": "tsx scripts/postgres-preview.mts",
    "eval:automations": "node scripts/test-automations.mjs",
    "eval:model-usage": "node --import tsx eval/model-usage.mts",
    "eval:controller": "node eval/container-controller.mjs",
    "eval:admin-monitor-ui": "node eval/admin-monitor-ui.mjs",
    "eval:ppt-content": "node --import tsx eval/ppt-content.mts",
    "eval:office-container": "node --import tsx eval/office-container.mts",
    "eval:office-editing": "node --import tsx eval/office-editing.mts",
    "eval:office-generation": "node --import tsx eval/office-generation.mts",
    "eval:office-resources": "node --import tsx eval/office-skill-resources.mts",
    "eval:office-reliability": "node --import tsx eval/office-reliability.mts",
    "eval:parser-metadata": "node --import tsx eval/parser-metadata.mts",
    "eval:parsed-content": "node --import tsx eval/parsed-content.mts",
    "eval:office-probe": "node --import tsx eval/office-capability-probe.mts",
    "eval:hybrid": "node scripts/test-hybrid.mjs",
    "eval:embeddings": "node scripts/test-embeddings.mjs",
    "eval:trash": "node scripts/test-trash.mjs",
    "eval:web": "node --import tsx eval/web-tools.mts",
    "eval:web-browser": "node --import tsx eval/web-tools.mts --browser",
    "eval:web-database": "node scripts/test-automations.mjs --web",
    "eval:web-quota": "node --import tsx eval/web-quota.mts",
    "eval:ask-user-dock": "node eval/ask-user-dock-ui.mjs",
    "eval:limits": "node scripts/test-limits.mjs",
    "eval:limits-ui": "node eval/limits-panel-ui.mjs",
    "eval:users-ui": "node eval/users-panel-ui.mjs",
    "eval:automation-capacity": "node scripts/test-automations.mjs --capacity",
    "eval:automation-capacity-ui": "node eval/automation-capacity-ui.mjs",
    "iam:lab": "node scripts/iam-lab.mjs",
    "eval:iam-lab": "node eval/iam-oidc-lab.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.35.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
