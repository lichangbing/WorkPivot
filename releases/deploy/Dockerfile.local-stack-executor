# 本地一体化栈的隔离执行器镜像：服务端镜像 + 文档解析/OCR（可选 Office 转 PDF）
# BASE_IMAGE 指向本地构建的服务端镜像，保证 Node 办公库（docx/exceljs/pptxgenjs）一致。
#
# WITH_OFFICE_CONVERT=1 时才安装 LibreOffice（约数百 MB，低带宽环境可能很慢），
# 用于 docx/xlsx/pptx → PDF 转换；默认不装，生成类能力不受影响。
ARG BASE_IMAGE=workpivot-server:local-stack
FROM ${BASE_IMAGE}

ARG WITH_OFFICE_CONVERT=0
# 国内访问 dl-cdn.alpinelinux.org 很慢时，可传 --build-arg APK_MIRROR=https://mirrors.aliyun.com/alpine
ARG APK_MIRROR=

USER root
RUN if [ -n "$APK_MIRROR" ]; then \
      sed -i "s#https://dl-cdn.alpinelinux.org/alpine#${APK_MIRROR}#g" /etc/apk/repositories; \
    fi \
    && apk add --no-cache \
        python3 py3-pillow poppler-utils \
        tesseract-ocr tesseract-ocr-data-eng tesseract-ocr-data-chi_sim \
    && if [ "$WITH_OFFICE_CONVERT" = "1" ]; then \
         apk add --no-cache libreoffice font-noto-cjk; \
       fi

ENV PYTHONDONTWRITEBYTECODE=1 OMP_THREAD_LIMIT=1
USER node
