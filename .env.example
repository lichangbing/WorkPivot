# Generate independent random values (e.g. openssl rand -hex 32). Never commit the real .env.
WORKPIVOT_SECRET_KEY=
WORKPIVOT_ADMIN_INIT_TOKEN=
# stat -c %g /var/run/docker.sock
WORKPIVOT_DOCKER_GID=
WORKPIVOT_IMAGE=workpivot-server:0.3.0-dev
# 可选：独立浏览器服务。地址和至少32位独立令牌须同时配置。
# WORKPIVOT_BROWSER_URL=http://127.0.0.1:39991
WORKPIVOT_BROWSER_TOKEN=

# 可选：管理员指定网页DNS-over-HTTPS端点，用于Fake-IP网络；不改变公网地址校验。
# WORKPIVOT_WEB_DOH_URL=https://cloudflare-dns.com/dns-query

# 可选：手机内置页面访问 API 的来源白名单；未配置时保持同源访问。
# 本机网页开发可另外加入 http://127.0.0.1:39990，禁止通配符。
# WORKPIVOT_MOBILE_ORIGINS=https://localhost,capacitor://localhost

# 可选：通用代码执行（run_code）的授权方式。默认 auto：不弹授权卡，只记录执行日志与对话事件；
# 设为 confirm 时每次调用都弹卡确认。
# WORKPIVOT_CODE_APPROVAL=auto


# 可选：执行器所在主机上的工作区 Docker 卷名。配置后 run_code/bash 把任务目录直接挂载进容器
# （不复制、不回写），容器只能看到该任务目录；未配置则退回“复制快照 + 回写”模式。
# 服务端与 worker 都要配置同一个值；卷名以 docker volume ls 为准（compose 项目会加项目名前缀）。
# WORKPIVOT_WORKSPACE_VOLUME=workpivot-workspace

# 可选：agent 循环的消息字符预算，超过后压缩较早的工具结果。默认 120000，设为 0 关闭。
# WORKPIVOT_CONTEXT_CHARS=120000

# 可选：需要用户确认的工具调用等待时间，单位为分钟，范围1—60。默认10分钟。
# WORKPIVOT_PERMISSION_TTL_MINUTES=10

# 可选：长任务运行预算。默认最多200步、30分钟和120000字符上下文。
# WORKPIVOT_AGENT_MAX_STEPS=200
# WORKPIVOT_AGENT_MAX_DURATION_MINUTES=30

# 可选：联网搜索（web_search）。配置后模型可以先搜索再读取；未配置时工具不出现。
# provider 取 brave 或 searxng；brave 需要 WORKPIVOT_SEARCH_KEY。
# WORKPIVOT_SEARCH_PROVIDER=searxng
# WORKPIVOT_SEARCH_URL=http://searxng:8080
# WORKPIVOT_SEARCH_KEY=

# 可选：对话记录入库（R007）。配置后任务元数据与消息写 PostgreSQL 的 chat schema；
# 未配置保持 JSONL。配置了但连不上会拒绝启动（不双写、不回落）。
# 建表：pnpm chat:install
# WORKPIVOT_CHAT_DATABASE_URL=postgresql://workpivot_chat:***@127.0.0.1:5432/workpivot
